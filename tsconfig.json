{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "prototype", "video", "scripts"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@data/*": ["./data/*"],
      "@design/*": ["./design/*"]
    }
  }
}
