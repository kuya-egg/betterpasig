---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import EmergencyStrip from "../components/EmergencyStrip.astro";
import SiteHead from "../components/SiteHead.astro";
import Toast from "../components/Toast.astro";
import { langFromUrl, ui } from "../i18n";
import { pagefindSection } from "../lib/pagefind";

interface Props {
  title?: string;
  description?: string;
}

const t = ui[langFromUrl(Astro.url)];
const { title, description } = Astro.props;
const { indexed, section } = pagefindSection(Astro.url);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <SiteHead title={title} description={description} />
  </head>
  <body class="min-h-dvh antialiased">
    <Loader />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:bg-bg focus:p-2">
      {t.skip}
    </a>
    <Header />
    <EmergencyStrip />
    <main id="main" data-pagefind-body={indexed || undefined} data-pagefind-meta={indexed ? `kind:${section}` : undefined}>
      {indexed && title && <span hidden data-pagefind-meta="title[data-title]" data-title={title} />}
      <slot />
    </main>
    <Footer />
    <Toast />
    <script>import "../lib/client-freshness";</script>
  </body>
</html>
