---
// The redesigned layout: the design-taste kit (public/kit, plain files) plus the site's own tokens.
// Every page moves onto this layout from Base.astro; the home page and /buhay/ pages go first.
import "../styles/kit-site.css";
import SiteHead from "../components/SiteHead.astro";
import KitHeader from "../components/kit/KitHeader.astro";
import KitFooter from "../components/kit/KitFooter.astro";
import Toast from "../components/Toast.astro";
import { href, langFromUrl, ui } from "../i18n";
import { emergencyHotlines, telHref } from "../lib/data";
import { pagefindSection } from "../lib/pagefind";

interface Props {
  title?: string;
  description?: string;
  /** Scroll moments this page mounts (ids in public/kit/moments). */
  moments?: string[];
  /** Photographs (data/photos.json ids) shown on this page, credited in the footer. */
  photos?: string[];
  /** UI fragments (public/kit/ui/<name>) pasted into this page; their CSS is linked so they render without script. */
  fragments?: string[];
}

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const { title, description, moments = [], photos = [], fragments = [] } = Astro.props;
const { indexed, section } = pagefindSection(Astro.url);
const emergency = emergencyHotlines[0];
---

<!doctype html>
<html lang={t.htmlLang} data-type="service" data-radius="soft" data-buttons="tonal" data-motion>
  <head>
    <SiteHead title={title} description={description} themeColor="#FFFFFF" />
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />
    <link rel="stylesheet" href="/kit/system.css" />
    <link rel="stylesheet" href="/kit/ui/cards.css" />
    <link rel="stylesheet" href="/kit/motion/motion.css" />
    <link rel="stylesheet" href="/kit/layout/layout.css" />
    {fragments.length > 0 && <link rel="stylesheet" href="/kit/ui/base.css" />}
    {fragments.map((name) => <link rel="stylesheet" href={`/kit/ui/${name}/fragment.css`} />)}
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    {
      moments.length > 0 && (
        <>
          <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
          <link rel="modulepreload" href="/kit/moments/moments.js" />
          <link rel="modulepreload" href="/kit/moments/lib.js" />
          {moments.map((id) => <link rel="modulepreload" href={`/kit/moments/${id}/moment.js`} />)}
        </>
      )
    }
  </head>
  <body>
    <KitHeader />
    <main id="top" data-pagefind-body={indexed || undefined} data-pagefind-meta={indexed ? `kind:${section}` : undefined}>
      {indexed && title && <span hidden data-pagefind-meta="title[data-title]" data-title={title} />}
      <slot />
    </main>
    <KitFooter photoIds={photos} />
    <nav class="actionbar" aria-label={t.navLabel}>
      {emergency && <a class="btn btn--secondary bp-call" href={telHref(emergency.numbers[0])}>{t.emergency}</a>}
      <a class="btn btn--primary" href={href(lang, "/serbisyo/")}>{t.mainAction}</a>
    </nav>
    <Toast />
    <script type="module" src="/kit/system.js"></script>
    <script type="module" src="/kit/motion/motion.js"></script>
    <script type="module" src="/kit/layout/layout.js"></script>
    <script>import "../lib/client-freshness";</script>
  </body>
</html>
