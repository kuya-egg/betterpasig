---
// One 404 for both languages: Cloudflare Pages serves it for any missing path.
import Kit from "../layouts/Kit.astro";
import { ui } from "../i18n";

const { fil, en } = ui;
---

<Kit title={`${fil.notFoundTitle} / ${en.notFoundTitle}`} description={`${fil.notFound} ${en.notFound}`}>
  <section class="section section--flow" aria-labelledby="nf-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="nf-h">{fil.notFound}</h1>
        <p lang="en">{en.notFound}</p>
      </div>
      <div class="nf-actions">
        <a class="btn btn--primary" href="/">Bumalik sa home page</a>
        <a class="btn btn--secondary" href="/serbisyo/">Tingnan ang mga serbisyo</a>
        <a class="btn btn--secondary" href="/en/" lang="en">Go to the English home page</a>
        <a class="btn btn--secondary" href="/en/serbisyo/" lang="en">Browse services</a>
      </div>
    </div>
  </section>
</Kit>

<style>
  .nf-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>
