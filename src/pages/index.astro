---
// Placeholder until the full homepage ships.
import Base from "../layouts/Base.astro";
import PasigMap from "../components/PasigMap.astro";
import { emergencyHotlines, services, site } from "../lib/data";

const telHref = (n: string) => `tel:${n.replace(/[^\d+]/g, "")}`;
---

<Base description="Ginagawa pa ang BetterPasig: bawat serbisyo, benepisyo at opisyal ng Lungsod ng Pasig, malinaw at nasa isang lugar.">
  <section class="wrap grid items-center gap-8 pt-16 pb-12 md:grid-cols-[1fr_auto] md:pt-24">
    <div>
      <p class="text-[14px] font-medium text-blue">Ginagawa pa</p>
      <h1 class="mt-3 max-w-[18ch] text-[34px] font-bold leading-[1.1] tracking-[-0.04em] md:text-[52px]">
        Bawat serbisyo ng Pasig, malinaw at nasa isang lugar.
      </h1>
      <p class="mt-5 max-w-[60ch]">
        Inaayos namin ang {services.length} serbisyo, mga benepisyo at ang direktoryo ng mga opisyal ng Lungsod ng Pasig
        para mahanap mo ang kailangan mo sa loob ng isang minuto.
      </p>
      <p class="mt-2 max-w-[60ch] text-[15px] text-muted">
        We're building a clear, volunteer-run guide to every Pasig City service, benefit and official.
      </p>
      <p class="mt-6 max-w-[60ch] text-[15px]">
        Habang hinihintay: <a href="https://pasigcity.gov.ph">pasigcity.gov.ph</a> para sa opisyal na transaksyon.
      </p>
    </div>
    <PasigMap class="mx-auto w-[240px] md:w-[340px]" />
  </section>

  <section class="wrap" aria-labelledby="hotline-h">
    <h2 id="hotline-h" class="text-[19px] font-semibold tracking-[-0.01em] text-red">Emergency hotlines</h2>
    <ul class="mt-3 border-t-2 border-ink">
      {
        emergencyHotlines.map((h) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line py-3">
            <span class="text-muted">{h.name.split(" (")[0]}</span>
            <span class="flex flex-wrap gap-x-4">
              {h.numbers.map((n) => (
                <a class="num text-[19px] font-semibold text-ink" href={telHref(n)}>
                  {n}
                </a>
              ))}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-[14px] text-muted">
      Na-update: <span class="num">{site.updated}</span>.
    </p>
  </section>
</Base>
