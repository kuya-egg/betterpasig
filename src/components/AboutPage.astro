---
import Base from "../layouts/Base.astro";
import Verify from "./Verify.astro";
import { city, site, sourceLabel } from "../lib/data";
import { formatDate, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const repo = "https://github.com/kuya-egg/betterpasig";
const h2 = "text-[30px] font-bold tracking-[-0.03em]";
// Textual as_of values are split into as_of_fil/as_of_en; plain years and dates stay in as_of.
const asOf = (fact: (typeof city.facts)[number]) =>
  (lang === "en" ? ("as_of_en" in fact ? fact.as_of_en : null) : ("as_of_fil" in fact ? fact.as_of_fil : null)) ?? fact.as_of ?? null;
---

<Base title={t.aboutTitle}>
  <div class="wrap max-w-[820px] py-12">
    <h1 class="text-[34px] font-bold leading-[1.05] tracking-[-0.04em] md:text-[52px]">{t.aboutTitle}</h1>

    <section class="mt-12" aria-labelledby="misyon">
      <h2 id="misyon" class={h2}>{t.aboutMissionTitle}</h2>
      <p class="mt-3 max-w-[60ch]">{t.aboutMission}</p>
      <p class="mt-3 max-w-[60ch]">{t.aboutStance}</p>
    </section>

    <section class="mt-12" aria-labelledby="prinsipyo">
      <h2 id="prinsipyo" class={h2}>{t.aboutPrinciplesTitle}</h2>
      <ol class="mt-4 divide-y divide-line border-y border-line">
        {
          t.aboutPrinciples.map(([title, body], i) => (
            <li class="flex gap-4 py-4">
              <span class="num w-6 shrink-0 text-muted">{i + 1}</span>
              <div>
                <h3 class="text-[19px] font-semibold tracking-[-0.01em]">{title}</h3>
                <p class="mt-1 max-w-[60ch] text-[15px] text-muted">{body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-12" aria-labelledby="non-partisan">
      <h2 id="non-partisan" class={h2}>{t.aboutPledgeTitle}</h2>
      <p class="mt-3 max-w-[60ch]">{t.aboutPledge}</p>
    </section>

    <section class="mt-12" aria-labelledby="datos">
      <h2 id="datos" class={h2}>{t.aboutDataTitle}</h2>
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {
          t.aboutDataSources.map(([name, url, use]) => (
            <li class="py-3">
              {url ? <a href={url}>{name}</a> : <span>{name}</span>}
              <span class="text-muted"> — {use}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 max-w-[60ch] text-[15px] text-muted">{t.aboutDataNote}</p>
    </section>

    <section class="mt-12" aria-labelledby="paunawa">
      <h2 id="paunawa" class={h2}>{t.aboutDisclaimerTitle}</h2>
      <p class="mt-3 max-w-[60ch]">{lang === "en" ? site.notice_en : site.notice_fil}</p>
    </section>

    <section class="mt-12" aria-labelledby="pasig">
      <h2 id="pasig" class={h2}>{t.aboutGlanceTitle}</h2>
      <p class="mt-2 text-[15px] text-muted">{t.aboutGlanceNote}</p>
      <table class="mt-4 w-full border-collapse text-left">
        <thead class="border-t-2 border-ink">
          <tr class="border-b border-line">
            <th scope="col" class="py-2 pr-4 text-[14px] font-medium text-muted">{t.aboutFactHead}</th>
            <th scope="col" class="py-2 text-[14px] font-medium text-muted">{t.aboutValueHead}</th>
          </tr>
        </thead>
        <tbody>
          {
            city.facts.map((fact) => (
              <tr class="border-b border-line align-top">
                <th scope="row" class="w-[34%] py-3 pr-4 text-[15px] font-semibold">
                  {lang === "en" ? fact.label_en : fact.label_fil}
                </th>
                <td class="py-3">
                  <span class="num">{lang === "en" ? fact.value_en : fact.value_fil}</span>
                  {fact.verify && <Verify />}
                  {asOf(fact) && (
                    <p class="text-[14px] text-muted">
                      {t.aboutAsOf}: <span class="num">{asOf(fact)}</span>
                    </p>
                  )}
                  {(lang === "en" ? fact.note_en : fact.note_fil) && (fact.verify || fact.id === "land-area") && (
                    <p class="mt-1 text-[14px] text-muted">{lang === "en" ? fact.note_en : fact.note_fil}</p>
                  )}
                  <p class="mt-1 text-[14px] text-muted">
                    {t.sources}:{" "}
                    {fact.sources.map((url, i) => (
                      <>
                        {i > 0 && ", "}
                        <a href={url}>{sourceLabel(url)}</a>
                      </>
                    ))}
                  </p>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-[14px] text-muted">{t.checked}: {formatDate(lang, city.retrieved)}</p>
    </section>

    <section class="mt-12" aria-labelledby="ambag">
      <h2 id="ambag" class={h2}>{t.aboutContribTitle}</h2>
      <p class="mt-3 max-w-[60ch]">{t.aboutContribText}</p>
      <ul class="mt-3">
        <li><a href={repo}>{t.aboutGithub}</a></li>
        <li><a href={`${repo}/issues/new`}>{t.aboutReport}</a></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  a { display: inline-flex; min-height: 48px; align-items: center; }
  td p a { min-height: 0; display: inline; }
</style>
