---
// The source lines under a recent notice: who published it, when, when it was checked, and a stale warning
// past 30 days (client-freshness adds the same warning when the page outlives its build).
import { pasigSources } from "../lib/data";
import { formatDate, langFromUrl, ui, type Lang } from "../i18n";
import { isSourceFresh } from "../lib/freshness";
interface Props { refs: string[]; lang?: Lang }
const lang = Astro.props.lang ?? langFromUrl(Astro.url);
const t = ui[lang];
const { refs } = Astro.props;
const rows = [...new Set(refs.map((ref) => ref.split(":")[0]))]
  .map((id) => pasigSources.find((source) => source.id === id))
  .filter((source) => source !== undefined);
---
<div class="bp-source t-small">
  <p>{t.checkedAgainst}</p>
  {rows.map((source) => (
    <p data-source-date={source.published_date}>
      {source.publisher}, {formatDate(lang, source.published_date)}. {t.checked} {formatDate(lang, source.checked_at.slice(0, 10))}.{" "}
      <a href={source.url}>{t.openSource}</a>
      {!isSourceFresh(source.published_date, new Date()) && <span data-stale>{t.staleSource}</span>}
    </p>
  ))}
</div>

<style>
  .bp-source {
    margin-top: var(--s-3);
    color: var(--muted);
    display: grid;
    gap: var(--s-1);
  }
  .bp-source p {
    margin: 0;
  }
  .bp-source a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-source :global([data-stale]) {
    display: block;
    color: var(--ink);
  }
</style>
