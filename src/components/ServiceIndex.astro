---
import Site from "../layouts/Site.astro";
import Search from "./Search.astro";
import Verify from "./Verify.astro";
import { categories, officeName, offices, services } from "../lib/data";
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<Site title={t.allServices} description={t.pageDescription}>
  <section class="section section--flow bp-service-index" aria-labelledby="services-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="services-h">{t.allServices}</h1>
        <p>{t.serviceCount(services.length, categories.length, offices.length)}</p>
      </div>
      <Search />
      <nav class="bp-cat__jump" id="service-categories" aria-label={lang === "en" ? "Service categories" : "Mga kategorya ng serbisyo"}>
        <ul>
          {categories.map((category) => (
            <li><a href={`#${category.id}`}>{lang === "en" ? category.name_en : category.name_fil}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
  {
    categories.map((category, index) => {
      const items = services.filter((service) => service.category === category.id);
      const name = lang === "en" ? category.name_en : category.name_fil;
      return (
        <section class={`section section--flow${index % 2 === 0 ? " ground-surface" : ""}`} aria-labelledby={category.id}>
          <div class="wrap">
            <div class="bp-cat__head">
              <h2 id={category.id}>{name}</h2>
              <span class="num muted">{items.length}</span>
            </div>
            {category.description_fil && (
              <p class="muted bp-cat__lead" lang={lang === "en" ? "fil" : undefined}>
                {category.description_fil}
              </p>
            )}
            {items.length === 0 ? (
              <p class="muted">{t.emptyCategory}</p>
            ) : (
              <ul class="rows bp-cat__rows">
                {items.map((service) => (
                  <li>
                    <span class="rows__name">
                      <a class="bp-cat__link" href={href(lang, `/serbisyo/${service.id}`)}>
                        {lang === "en" ? service.title_en : service.title_fil}
                      </a>
                      {service.verify && <Verify />}
                      <small>{officeName(service.office)}</small>
                    </span>
                    {service.processing_time && <span class="rows__value bp-cat__time">{service.processing_time}</span>}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      );
    })
  }
</Site>

<style>
  .bp-service-index .section-head h1 {
    font: 800 clamp(2rem, 1.45rem + 2.6vw, 4.25rem)/1.08 var(--font-text);
    letter-spacing: -.035em;
    text-wrap: wrap;
  }
  .bp-cat__jump {
    margin-block-start: var(--s-6);
    border-block-start: 1px solid var(--line);
  }
  .bp-cat__jump ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 0 var(--s-5);
  }
  .bp-cat__jump a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    width: 100%;
    border-block-end: 1px solid var(--line);
    color: var(--blue);
    padding-block: var(--s-2);
    font-size: .9375rem;
    font-weight: 650;
  }
  @media (hover: hover) { .bp-cat__jump a:hover { background: var(--pale); text-decoration: underline; } }
  .bp-cat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: 760px;
  }
  .bp-cat__head h2 {
    font-size: var(--t-h3);
    font-weight: 600;
  }
  .bp-cat__lead {
    max-width: 60ch;
    margin-top: var(--s-2);
  }
  .bp-cat__rows {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    max-width: 760px;
  }
  .bp-cat__rows > li {
    grid-template-columns: minmax(0, 1fr) minmax(0, 12rem);
  }
  .bp-cat__rows .rows__name {
    display: grid;
    gap: var(--s-1);
    justify-items: start;
  }
  .bp-cat__rows small {
    color: var(--muted);
    font-size: var(--t-small);
    font-weight: 400;
  }
  .bp-cat__link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    font-size: var(--t-body);
    font-weight: 500;
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: text-underline-offset 150ms var(--ease);
  }
  .bp-cat__link:hover {
    text-underline-offset: .34em;
  }
  .bp-cat__time {
    color: var(--muted);
    font-size: var(--t-small);
  }
  @media (max-width: 1023px) {
    .bp-cat__rows > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .bp-cat__time {
      grid-column: 1;
      grid-row: auto;
      text-align: left;
    }
  }
</style>
