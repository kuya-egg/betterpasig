---
import Site from "../layouts/Site.astro";
import Verify from "./Verify.astro";
import { sourceLabel, transparencyFigures, transparencyLinks, transparencyRetrieved } from "../lib/data";
import { formatDate, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const checked = formatDate(lang, transparencyRetrieved);
---

<Site title={t.fundsTitle} description={t.fundsPageIntro}>
  <section class="section section--flow bp-funds" aria-labelledby="funds-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="funds-h">{t.fundsTitle}</h1>
        <p>{t.fundsPageIntro}</p>
      </div>
    </div>
  </section>

  <section id="mga-numero" class="section section--flow ground-surface bp-funds" aria-labelledby="mga-numero-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="mga-numero-h">{t.figuresTitle}</h2>
      </div>
      <ul class="bp-funds__list bp-funds__list--figures">
        {
          transparencyFigures.map((figure) => {
            const note = (lang === "en" ? figure.note_en : figure.note_fil) ?? "";
            const label = lang === "en" ? figure.label_en : figure.label_fil;
            const value = lang === "en" ? figure.value_en : figure.value_fil;
            return (
              <li id={figure.id} data-pagefind-title={label} class="bp-funds__fig">
                <h3 class="bp-funds__label">{label}</h3>
                <p class="bp-funds__value">
                  {value}
                  {figure.verify && <Verify />}
                </p>
                {figure.as_of && <p class="t-small muted">{figure.as_of}</p>}
                {note && <p class="t-small muted">{note}</p>}
                <p class="t-small muted">
                  {t.sources}:{" "}
                  {figure.sources.map((url, index) => (
                    <>
                      {index > 0 && ", "}
                      <a class="bp-funds__src" href={url}>{sourceLabel(url)}</a>
                    </>
                  ))}
                </p>
              </li>
            );
          })
        }
      </ul>
      <p class="t-small muted bp-funds__checked">{t.checked}: {checked}</p>
    </div>
  </section>

  <section id="mga-link" class="section section--flow bp-funds" aria-labelledby="mga-link-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="mga-link-h">{t.linksTitle}</h2>
      </div>
      <ul class="bp-funds__list">
        {
          transparencyLinks.map((link) => {
            const title = lang === "en" && link.title_en ? link.title_en : link.title_fil;
            const desc = lang === "en" && "description_en" in link && link.description_en ? link.description_en : "description_fil" in link ? link.description_fil : "";
            return (
              <li id={link.id} data-pagefind-title={title} class="bp-funds__fig">
                <a class="bp-funds__link" href={link.url}>{title}</a>
                {desc && <p>{desc}</p>}
                <p class="t-small muted">
                  {t.sources}:{" "}
                  {link.sources.map((url, index) => (
                    <>
                      {index > 0 && ", "}
                      <a class="bp-funds__src" href={url}>{sourceLabel(url)}</a>
                    </>
                  ))}
                </p>
              </li>
            );
          })
        }
      </ul>
      <p class="t-small muted bp-funds__checked">{t.checked}: {checked}</p>
    </div>
  </section>
</Site>

<style>
  section.bp-funds,
  .bp-funds__fig {
    scroll-margin-top: var(--s-8);
  }
  .bp-funds__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-inline-size: 75ch;
  }
  .bp-funds__list--figures {
    max-inline-size: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 5vw, 4rem);
  }
  .bp-funds__fig {
    display: grid;
    align-content: start;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-funds__fig p {
    margin: 0;
  }
  .bp-funds__label {
    font: 750 1rem/1.45 var(--font-text);
    letter-spacing: 0;
  }
  .bp-funds__value {
    font: 800 clamp(1.25rem, 1.05rem + .9vw, 2rem)/1.28 var(--font-text);
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .bp-funds__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    justify-self: start;
    font-size: var(--t-card);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .bp-funds__src {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-funds__checked {
    margin-top: var(--s-5);
  }
  @media (max-width: 43.9375rem) {
    .bp-funds__list--figures { grid-template-columns: minmax(0, 1fr); }
  }
</style>
