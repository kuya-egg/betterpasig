---
import Base from "../layouts/Base.astro";
import Verify from "./Verify.astro";
import { sourceLabel, transparencyFigures, transparencyLinks, transparencyRetrieved } from "../lib/data";
import { formatDate, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const checked = formatDate(lang, transparencyRetrieved);
---

<Base title={t.fundsTitle} description={t.fundsPageIntro}>
  <div class="wrap py-12">
    <h1 class="text-[34px] font-bold leading-[1.05] tracking-[-0.04em] md:text-[52px]">{t.fundsTitle}</h1>
    <p class="mt-4 max-w-[62ch] text-muted">{t.fundsPageIntro}</p>

    <section id="mga-numero" aria-labelledby="mga-numero-h" class="mt-12">
      <h2 id="mga-numero-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.figuresTitle}</h2>
      <div class="mt-4">
        <table class="w-full border-collapse text-left max-sm:block">
          <thead class="max-sm:sr-only">
            <tr class="border-t-2 border-ink border-b border-line text-[14px] font-medium text-muted">
              <th scope="col" class="py-3 pr-4 font-medium">{t.figureLabel}</th>
              <th scope="col" class="py-3 pr-4 font-medium">{t.figureValue}</th>
              <th scope="col" class="py-3 pr-4 font-medium">{t.figureAsOf}</th>
            </tr>
          </thead>
          <tbody class="max-sm:block max-sm:border-t-2 max-sm:border-ink">
            {
              transparencyFigures.map((figure) => {
                const note = "note" in figure && typeof figure.note === "string" ? figure.note : "";
                const label = lang === "en" && "label_en" in figure && typeof figure.label_en === "string" && figure.label_en ? figure.label_en : figure.label_fil;
                return (
                  <tr id={figure.id} class="scroll-mt-24 border-b border-line align-top max-sm:block max-sm:py-3.5">
                    <th scope="row" class="py-3.5 pr-4 font-normal max-sm:block max-sm:py-0 sm:min-w-[14rem]">
                      {label}
                    </th>
                    <td class="py-3.5 pr-4 max-sm:block max-sm:py-0 max-sm:mt-1 sm:min-w-[12rem]">
                      <span class="num font-semibold">{figure.value}</span>
                      {figure.verify && <Verify />}
                      {figure.as_of && <span class="num mt-1 block text-[14px] text-muted sm:hidden">{figure.as_of}</span>}
                      {note && <span class="mt-1 block text-[14px] text-muted">{note}</span>}
                      <span class="mt-1 block text-[14px] text-muted">
                        {t.sources}:{" "}
                        {figure.sources.map((url, index) => (
                          <>
                            {index > 0 && ", "}
                            <a href={url}>{sourceLabel(url)}</a>
                          </>
                        ))}
                      </span>
                    </td>
                    <td class="num py-3.5 pr-4 text-muted max-sm:hidden">{figure.as_of}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-[14px] text-muted">{t.checked}: <span class="num">{checked}</span></p>
    </section>

    <section id="mga-link" aria-labelledby="mga-link-h" class="mt-12 scroll-mt-24">
      <h2 id="mga-link-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.linksTitle}</h2>
      <ul class="mt-4 border-t-2 border-ink">
        {
          transparencyLinks.map((link) => {
            const title = lang === "en" && link.title_en ? link.title_en : link.title_fil;
            const desc = lang === "en" && "description_en" in link && link.description_en ? link.description_en : "description_fil" in link ? link.description_fil : "";
            return (
              <li id={link.id} class="scroll-mt-24 border-b border-line py-3.5">
                <a class="font-medium" href={link.url}>{title}</a>
                {desc && <p class="mt-1">{desc}</p>}
                <p class="mt-1 text-[14px] text-muted">
                  {t.sources}:{" "}
                  {link.sources.map((url, index) => (
                    <>
                      {index > 0 && ", "}
                      <a href={url}>{sourceLabel(url)}</a>
                    </>
                  ))}
                </p>
              </li>
            );
          })
        }
      </ul>
      <p class="mt-2 text-[14px] text-muted">{t.checked}: <span class="num">{checked}</span></p>
    </section>
  </div>
</Base>

<style>
  a { display: inline-flex; min-height: 48px; align-items: center; }
</style>
