---
import Site from "../layouts/Site.astro";
import PageHead from "./site/PageHead.astro";
import IbaPaTabs from "./IbaPaTabs.astro";
import { sourceLabel, transparencyFigures, transparencyLinks, transparencyRetrieved } from "../lib/data";
import { formatDate, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const en = lang === "en";
const t = ui[lang];
const checked = formatDate(lang, transparencyRetrieved);
---

<Site title={t.fundsTitle} description={t.fundsPageIntro}>
  <section class="section ground-white bp-funds-top" aria-labelledby="funds-h">
    <div class="wrap">
      <PageHead id="funds-h" crumbs={[[t.fundsTitle]]} kicker={en ? "Public funds" : "Pondo ng bayan"} lead={t.fundsPageIntro}>
        {en ? <>Where the city's <em>money</em> goes</> : <>Saan napupunta ang <em>pondo</em> ng lungsod</>}
      </PageHead>
      <IbaPaTabs current="funds" />
    </div>
  </section>

  <section id="mga-numero" class="section bp-funds" aria-labelledby="mga-numero-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="mga-numero-h">{t.figuresTitle}</h2>
      </div>
      <ul class="bp-funds__grid">
        {
          transparencyFigures.map((figure) => {
            const label = en ? figure.label_en : figure.label_fil;
            const value = en ? figure.value_en : figure.value_fil;
            return (
              <li id={figure.id} data-pagefind-title={label} class="bp-funds__fig">
                <h3 class="bp-funds__label">{label}</h3>
                <p class="bp-funds__value">{value}</p>
                {figure.as_of && <p class="t-small muted">{t.aboutAsOf}: {figure.as_of}</p>}
                <p class="t-small muted">
                  {t.sources}:{" "}
                  {figure.sources.map((url, index) => (
                    <>
                      {index > 0 && ", "}
                      <a class="bp-funds__src" href={url}>{sourceLabel(url)}</a>
                    </>
                  ))}
                </p>
              </li>
            );
          })
        }
      </ul>
      <p class="t-small muted bp-funds__checked">{t.checked}: {checked}</p>
    </div>
  </section>

  <section id="mga-link" class="section ground-surface bp-funds" aria-labelledby="mga-link-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="mga-link-h">{t.linksTitle}</h2>
      </div>
      <ul class="bp-funds__grid">
        {
          transparencyLinks.map((link) => {
            const title = en && link.title_en ? link.title_en : link.title_fil;
            const desc = en && "description_en" in link && link.description_en ? link.description_en : "description_fil" in link ? link.description_fil : "";
            return (
              <li id={link.id} data-pagefind-title={title} class="bp-funds__fig">
                <a class="bp-funds__link" href={link.url}>{title}</a>
                {desc && <p>{desc}</p>}
                <p class="t-small muted">
                  {t.sources}:{" "}
                  {link.sources.map((url, index) => (
                    <>
                      {index > 0 && ", "}
                      <a class="bp-funds__src" href={url}>{sourceLabel(url)}</a>
                    </>
                  ))}
                </p>
              </li>
            );
          })
        }
      </ul>
      <p class="t-small muted bp-funds__checked">{t.checked}: {checked}</p>
    </div>
  </section>
</Site>

<style>
  .bp-funds-top { padding-block-end: var(--s-6); }
  .bp-funds-top :global(.bp-tabs) { margin-block-start: var(--s-6); }
  section.bp-funds,
  .bp-funds__fig { scroll-margin-top: var(--sticky-offset); }
  .bp-funds__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr));
    gap: var(--s-4);
  }
  .bp-funds__fig {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
    padding: var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .bp-funds__fig > p { margin: 0; }
  .bp-funds__label { font: 600 var(--t-meta)/1.4 var(--font-text); letter-spacing: 0; color: var(--muted); }
  .bp-funds__value {
    font: 500 var(--t-h3)/1.15 var(--font-display);
    letter-spacing: -.01em;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .bp-funds__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 500 var(--t-card)/1.3 var(--font-text);
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .bp-funds__src {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-funds__checked { margin-top: var(--s-5); }
</style>
