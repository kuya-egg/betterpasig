---
import { categories, offices, services } from "../lib/data";
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<section id="serbisyo" class="scroll-mt-28 border-t border-line py-14">
  <div class="wrap">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <div>
        <h2 class="text-[30px] font-bold tracking-[-0.03em]">{t.allServices}</h2>
        <p class="mt-1.5 text-muted">{t.serviceCount(services.length, categories.length, offices.length)}</p>
      </div>
      <a class="link-draw font-medium" href={href(lang, "/serbisyo")}>{t.fullList}</a>
    </div>
    <div class="grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => {
          const items = services.filter((service) => service.category === category.id);
          const name = lang === "en" ? category.name_en : category.name_fil;
          return (
            <div class="border-t border-line py-4">
              <h3 class="flex items-baseline justify-between gap-3 text-[19px] font-semibold tracking-[-0.01em]">
                <a class="link-draw" href={href(lang, `/serbisyo#${category.id}`)}>
                  {name}
                </a>
                <span class="num text-[14px] font-medium text-muted">{items.length}</span>
              </h3>
              <ul class="mt-2.5 grid gap-1.5">
                {items.slice(0, 3).map((service) => (
                  <li>
                    <a class="link-draw" href={href(lang, `/serbisyo/${service.id}`)}>
                      {lang === "en" ? service.title_en : service.title_fil}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
