---
import { barangays, categories, facilities, historicalUpdates, hotlines, officials, officialsDirectory, opportunities, pasigSources, places, programs, serviceUpdates, services, transparencyFigures } from "../lib/data";
import { href, langFromUrl, ui } from "../i18n";
import { eventState, isSourceFresh } from "../lib/freshness";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
// Where a city official is listed on /opisyal (ids from OfficialsPage).
function officialAnchor(person: (typeof officials)[number]): string {
  if (person.position === "Councilor") return `opisyal-council-${person.district}`;
  if (person.position === "Ex-officio") return "opisyal-ex-officio";
  return `opisyal-${person.position.toLowerCase().replaceAll(" ", "-")}`;
}

// Everyday Filipino words and the terms the data uses. Each side is added to a row that contains the other,
// so "sedula" finds the community tax certificate and "real property tax" finds amilyar rows.
const synonyms: [string, string[]][] = [
  ["amilyar", ["real property tax"]],
  ["sedula", ["community tax", "cedula"]],
  ["kapanganakan", ["birth"]],
  ["kasal", ["marriage"]],
  ["namatay", ["death"]],
  ["libing", ["burial"]],
  ["negosyo", ["business"]],
  ["trabaho", ["job", "employment"]],
  ["lisensya", ["license"]],
  ["pensyon", ["pension"]],
  ["iskolar", ["scholarship"]],
  ["nakatatanda", ["senior"]],
  ["kapansanan", ["pwd", "disability"]],
  ["ospital", ["hospital"]],
  ["baha", ["flood"]],
];
function withSynonyms(text: string): string {
  const extra = synonyms.flatMap(([word, terms]) =>
    terms.some((term) => text.includes(term)) ? [word] : text.includes(word) ? terms : [],
  );
  return extra.length ? `${text} ${extra.join(" ")}` : text;
}

const index = [
  ...services.map((service) => {
  const category = categories.find((item) => item.id === service.category);
  const summary = service.summary_fil ?? "";
  return {
    id: service.id,
    href: href(lang, `/serbisyo/${service.id}`),
    title: lang === "en" ? service.title_en : service.title_fil,
    category: lang === "en" ? (category?.name_en ?? "") : (category?.name_fil ?? ""),
    text: `${service.title_fil} ${service.title_en} ${summary} ${category?.name_fil ?? ""} ${category?.name_en ?? ""}`.toLowerCase(),
  };
  }),
  ...places.map((place) => { const date = Object.values(place.evidence).flat().map((ref) => pasigSources.find((source) => source.id === ref.split(":")[0])?.published_date ?? "").sort().at(-1) ?? ""; const fresh = isSourceFresh(date, new Date()); return { id: place.id, href: href(lang, `/lugar/${place.id}/`), title: place.name, category: `${lang === "en" ? "Place" : "Lugar"}${fresh ? "" : (lang === "en" ? " · older source" : " · lumang sanggunian")}`, text: `${place.name} ${place.address ?? ""} ${place.barangay_id ?? ""}`.toLowerCase() }; }),
  ...serviceUpdates.map((item) => { const fresh = isSourceFresh(item.published_date, new Date()); return { id: item.id, href: !fresh ? href(lang, "/ngayong-linggo/arkibo/") : item.service_id ? href(lang, `/serbisyo/${item.service_id}`) : href(lang, "/ngayong-linggo/"), title: lang === "en" ? item.title_en : item.title_fil, category: `${lang === "en" ? "Service notice" : "Abiso sa serbisyo"}${fresh ? "" : (lang === "en" ? " · archived" : " · arkibo")}`, text: `${item.title_fil} ${item.title_en} ${item.id}`.toLowerCase() }; }),
  ...opportunities.map((item) => { const past = eventState(item.event_date, new Date()) === "past"; const fresh = isSourceFresh(item.published_date, new Date()); return { id: item.id, href: past || !fresh ? href(lang, "/ngayong-linggo/arkibo/") : href(lang, "/ngayong-linggo/"), title: lang === "en" ? item.title_en : item.title_fil, category: `${lang === "en" ? "Dated opportunity" : "Oportunidad na may petsa"}${past || !fresh ? (lang === "en" ? " · past" : " · nagdaan") : ""}`, text: `${item.title_fil} ${item.title_en} ${item.id}`.toLowerCase() }; }),
  ...historicalUpdates.map((item) => ({ id: item.id, href: href(lang, "/ngayong-linggo/arkibo/"), title: item.id, category: lang === "en" ? "Past notice" : "Nagdaang abiso", text: `${item.id} ${item.summary}`.toLowerCase() })),
  ...barangays.map((item) => ({ id: item.id, href: href(lang, `/barangay/${item.id}/`), title: item.name, category: lang === "en" ? "Barangay" : "Barangay", text: `${item.name} ${item.district ?? ""}`.toLowerCase() })),
  ...[
    { path: "/opisyal/", title: t.officialsPageTitle, keys: "opisyal officials alkalde mayor konsehal councilor kapitan punong barangay department head" },
    { path: "/emergency/", title: t.emergencyPageTitle, keys: "emergency hotline ospital hospital evacuation evacuation center baha flood rescue" },
    { path: "/tulong/", title: t.benefitsTitle, keys: "benepisyo benefits tulong ayuda programs" },
    { path: "/pondo/", title: t.fundsTitle, keys: "pondo budget funds transparency foi coa" },
    { path: "/tungkol/", title: t.aboutTitle, keys: "tungkol about github correction mali" },
  ].map((page) => ({ id: `page${page.path}`, href: href(lang, page.path), title: page.title, category: t.searchKindPage, text: `${page.title} ${page.keys}`.toLowerCase() })),
  ...programs.map((item) => ({ id: `program-${item.id}`, href: href(lang, `/tulong/#${item.id}`), title: lang === "en" ? item.title_en : item.title_fil, category: t.searchKindProgram, text: `${item.title_fil} ${item.title_en} ${item.office} ${item.for}`.toLowerCase() })),
  ...officials.map((item) => ({ id: `official-${item.id}`, href: href(lang, `/opisyal/#${officialAnchor(item)}`), title: item.name, category: t.searchKindOfficial, text: `${item.name} ${item.position} ${"role" in item ? item.role : ""}`.toLowerCase() })),
  ...officialsDirectory.departments.map((item, index) => ({ id: `department-${index}`, href: href(lang, "/opisyal/#opisyal-departamento"), title: item.office, category: t.searchKindOffice, text: `${item.office} ${item.head ?? ""} ${item.position ?? ""}`.toLowerCase() })),
  ...hotlines.map((item) => ({ id: `hotline-${item.id}`, href: href(lang, "/emergency/#hotlines"), title: lang === "en" ? item.label_en : item.label_fil, category: t.searchKindHotline, text: `${item.label_fil} ${item.label_en} ${item.name} ${item.kind} ${item.numbers.join(" ")}`.toLowerCase() })),
  ...facilities.hospitals.map((item, index) => ({ id: `hospital-${index}`, href: href(lang, "/emergency/#ospital"), title: item.name, category: t.searchKindHospital, text: `${item.name} ${item.address ?? ""} ospital hospital`.toLowerCase() })),
  ...facilities.evacuation_centers.map((item, index) => ({ id: `evacuation-${index}`, href: href(lang, "/emergency/#evacuation"), title: item.name, category: t.searchKindEvacuation, text: `${item.name} ${item.barangay} evacuation center`.toLowerCase() })),
  ...transparencyFigures.map((item) => ({ id: `figure-${item.id}`, href: href(lang, `/pondo/#${item.id}`), title: item.label_fil, category: t.fundsTitle, text: `${item.label_fil} ${item.value}`.toLowerCase() })),
].map((row) => ({ ...row, text: withSynonyms(row.text) }));
const datedIndex = index.map(row => {
  const place = places.find(item => item.id === row.id);
  const update = serviceUpdates.find(item => item.id === row.id);
  const opportunity = opportunities.find(item => item.id === row.id);
  const history = historicalUpdates.find(item => item.id === row.id);
  const date = place ? Object.values(place.evidence).flat().map(ref => pasigSources.find(source => source.id === ref.split(':')[0])?.published_date ?? '').sort().at(-1) : update?.published_date ?? opportunity?.published_date ?? history?.published_date;
  return {...row, publishedDate: date, eventDate: opportunity?.event_date, archiveHref: href(lang, '/ngayong-linggo/arkibo/'), kind: place ? 'place' : update ? 'service_update' : opportunity ? 'opportunity' : history ? 'historical' : barangays.some(item => item.id === row.id) ? 'barangay' : 'service'};
});
const json = JSON.stringify(datedIndex).replace(/</g, "\\u003c");
---

<div
  class="bp-search mt-6 max-w-[580px]"
  data-empty={t.noMatch}
  data-one={t.matchOne}
  data-many={t.matchMany}
  data-keys={t.searchKeys}
>
  <div class="field">
  <form role="search">
    <label class="sr-only" for="q">{t.searchLabel}</label>
    <input
      id="q"
      type="search"
      name="q"
      autocomplete="off"
      placeholder={t.searchPlaceholder}
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-expanded="false"
    />
    <button type="submit">{t.searchButton}</button>
  </form>
  <div id="search-results" class="results" role="listbox"></div>
  </div>
  <div class="popular">
    <span>{t.popularLabel}</span>
    {t.popular.map((term) => (
      <button type="button" data-q={term}>{term}</button>
    ))}
  </div>
</div>
<script type="application/json" id="bp-search" is:inline set:html={json} />

<script>
  import {isSourceFresh,eventState} from '../lib/freshness';
  const box = document.querySelector<HTMLElement>(".bp-search");
  const dataEl = document.getElementById("bp-search");
  if (box && dataEl?.textContent) {
    type Row = { id: string; href: string; title: string; category: string; text: string; publishedDate?: string; eventDate?: string; archiveHref: string; kind: string };
    const rows = JSON.parse(dataEl.textContent) as Row[];
    const form = box.querySelector("form");
    const input = box.querySelector("input");
    const results = box.querySelector<HTMLElement>(".results");
    if (form && input && results) {
      const empty = box.dataset.empty ?? "";
      const one = box.dataset.one ?? "";
      const many = box.dataset.many ?? "{n}";
      const keys = box.dataset.keys ?? "";
      let links: HTMLAnchorElement[] = [];
      let active = -1;

      const countLabel = (n: number) => (n === 1 ? one : many.replace("{n}", String(n)));

      const highlight = (text: string, words: string[]) => {
        const frag = document.createDocumentFragment();
        const lower = text.toLowerCase();
        const usable = words.filter((word) => word.length > 1);
        let i = 0;
        while (i < text.length) {
          let at = -1;
          let len = 0;
          for (const word of usable) {
            const found = lower.indexOf(word, i);
            if (found !== -1 && (at === -1 || found < at)) {
              at = found;
              len = word.length;
            }
          }
          if (at === -1) {
            frag.append(text.slice(i));
            break;
          }
          if (at > i) frag.append(text.slice(i, at));
          const mark = document.createElement("mark");
          mark.textContent = text.slice(at, at + len);
          frag.append(mark);
          i = at + len;
        }
        return frag;
      };

      const paint = () => {
        links.forEach((link, index) => {
          link.classList.toggle("active", index === active);
          link.setAttribute("aria-selected", index === active ? "true" : "false");
        });
        if (active >= 0) links[active]?.scrollIntoView({ block: "nearest" });
      };

      const close = () => {
        results.classList.remove("open");
        input.setAttribute("aria-expanded", "false");
      };

      const run = () => {
        const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        results.replaceChildren();
        links = [];
        active = -1;
        if (words.length === 0) {
          close();
          return;
        }
        const expired = (row: Row) => Boolean(row.publishedDate && !isSourceFresh(row.publishedDate,new Date())) || eventState(row.eventDate,new Date()) === 'past' || row.kind === 'historical';
        const hits = rows.filter((row) => words.every((word) => row.text.includes(word))).sort((a,b) => Number(expired(a))-Number(expired(b)));
        if (hits.length === 0) {
          const note = document.createElement("p");
          note.textContent = empty;
          results.append(note);
        } else {
          for (const hit of hits.slice(0, 7)) {
            const link = document.createElement("a");
            link.href = expired(hit) ? hit.archiveHref : hit.href;
            link.setAttribute("role", "option");
            const title = document.createElement("span");
            title.append(highlight(hit.title, words));
            const category = document.createElement("small");
            category.textContent = hit.category.split(' · ')[0] + (expired(hit) ? (document.documentElement.lang === 'en' ? ' · archived' : ' · arkibo') : '');
            link.append(title, category);
            results.append(link);
            links.push(link);
          }
          const hint = document.createElement("div");
          hint.className = "hint";
          const shown = document.createElement("span");
          shown.textContent = countLabel(hits.length);
          const help = document.createElement("span");
          help.textContent = keys;
          hint.append(shown, help);
          results.append(hint);
        }
        results.classList.add("open");
        input.setAttribute("aria-expanded", "true");
      };

      input.addEventListener("input", run);
      input.addEventListener("focus", () => {
        if (input.value.trim()) run();
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          if (!links.length) return;
          active = (active + 1) % links.length;
          paint();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          if (!links.length) return;
          active = (active - 1 + links.length) % links.length;
          paint();
        } else if (event.key === "Escape") {
          close();
        } else if (event.key === "Enter" && active >= 0) {
          event.preventDefault();
          links[active]?.click();
        }
      });
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (active >= 0) links[active]?.click();
        else run();
      });
      box.addEventListener("click", (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("[data-q]");
        if (!button) return;
        input.value = button.dataset.q ?? "";
        run();
        input.focus();
      });
      document.addEventListener("click", (event) => {
        if (!(event.target as Element).closest(".bp-search")) close();
      });
    }
  }
</script>

<style>
  form {
    display: flex;
    border: 2px solid var(--ink);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
    transition: box-shadow var(--mid) var(--ease);
  }
  form:focus-within {
    box-shadow: 0 0 0 4px var(--mark-bg);
  }
  input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    border: 0;
    outline: 0;
    font: 500 18px var(--font);
    padding: 12px 16px;
    background: transparent;
    color: var(--ink);
  }
  input::placeholder {
    color: var(--muted);
  }
  form button {
    border: 0;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 16px;
    padding: 0 22px;
    min-height: 48px;
  }
  .field {
    position: relative;
  }
  .results {
    display: none;
    position: absolute;
    z-index: 20;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 18px 44px var(--shadow);
    max-height: 400px;
    overflow: auto;
  }
  .results.open {
    display: block;
  }
  .results :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    text-decoration: none;
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .results :global(a:first-child) {
    border-top: 0;
  }
  .results :global(a:hover),
  .results :global(a.active) {
    background: var(--subtle);
  }
  .results :global(small) {
    color: var(--muted);
    font-size: 14px;
  }
  .results :global(mark) {
    background: var(--mark-bg);
    color: inherit;
    border-radius: 3px;
  }
  .results :global(p) {
    margin: 0;
    padding: 14px 16px;
    color: var(--muted);
    font-size: 15px;
  }
  .results :global(.hint) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 16px;
    font-size: 13px;
    color: var(--muted);
    border-top: 1px solid var(--line);
    background: var(--subtle);
  }
  .popular {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .popular button {
    background: var(--subtle);
    border: 1px solid var(--line);
    border-radius: 6px;
    min-height: 48px;
    padding: 8px 12px;
    color: var(--ink);
    font-size: 15px;
  }
  .popular button:hover {
    border-color: var(--blue);
    color: var(--blue);
  }
</style>
