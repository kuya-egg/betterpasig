---
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<div
  class="bp-search mt-6 max-w-[580px]"
  data-pagefind-ignore
  data-empty={t.noMatch}
  data-one={t.matchOne}
  data-many={t.matchMany}
  data-keys={t.searchKeys}
  data-kinds={JSON.stringify(t.searchKinds)}
  data-archived={t.searchArchived}
  data-older={t.searchOlderSource}
  data-archive-href={href(lang, "/ngayong-linggo/arkibo/")}
>
  <div class="field">
  <form role="search">
    <label class="sr-only" for="q">{t.searchLabel}</label>
    <input
      id="q"
      type="search"
      name="q"
      autocomplete="off"
      placeholder={t.searchPlaceholder}
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-expanded="false"
    />
    <button type="submit">{t.searchButton}</button>
  </form>
  <div id="search-results" class="results" role="listbox"></div>
  </div>
  <div class="popular">
    <span>{t.popularLabel}</span>
    {t.popular.map((term) => (
      <button type="button" data-q={term}>{term}</button>
    ))}
  </div>
</div>
<script>
  import { eventState, isSourceFresh } from "../lib/freshness";
  import { searchVariants } from "../lib/search-synonyms";

  type SubResult = { title: string; url: string; anchor?: { id: string } };
  type PageData = { url: string; meta: { title?: string; kind?: string }; sub_results: SubResult[] };
  type Pagefind = { options: (options: object) => Promise<void>; search: (query: string) => Promise<{ results: { id: string; score: number; data: () => Promise<PageData> }[] }> };
  type Dates = { notices: Record<string, { published: string; event: string | null; historical: boolean }>; places: Record<string, string> };
  type Row = { href: string; title: string; kind: string; note: string };

  const box = document.querySelector<HTMLElement>(".bp-search");
  const form = box?.querySelector("form");
  const input = box?.querySelector("input");
  const results = box?.querySelector<HTMLElement>(".results");
  if (box && form && input && results) {
    const empty = box.dataset.empty ?? "";
    const one = box.dataset.one ?? "";
    const many = box.dataset.many ?? "{n}";
    const keys = box.dataset.keys ?? "";
    const kinds = JSON.parse(box.dataset.kinds ?? "{}") as Record<string, string>;
    const archivedLabel = box.dataset.archived ?? "";
    const olderLabel = box.dataset.older ?? "";
    const archiveHref = box.dataset.archiveHref ?? "";
    let links: HTMLAnchorElement[] = [];
    let active = -1;
    let latest = 0;
    let timer = 0;

    // Pagefind and the date table load on first use, not with the page. Pagefind picks the index of <html lang>.
    let pagefind: Promise<Pagefind | null> | undefined;
    const loadPagefind = () => {
      const url = "/pagefind/pagefind.js";
      // pageLength 0.1: hub pages (officials, emergency, funds) are long; the default would rank short pages that merely mention a name above them.
      pagefind ??= import(/* @vite-ignore */ url).then(async (module: Pagefind) => {
        await module.options({ ranking: { pageLength: 0.1 } });
        return module;
      }, () => null);
      return pagefind;
    };
    let dates: Promise<Dates> | undefined;
    const loadDates = () => {
      dates ??= fetch("/notice-dates.json").then((response) => response.json() as Promise<Dates>);
      return dates;
    };

    const countLabel = (n: number) => (n === 1 ? one : many.replace("{n}", String(n)));

    const highlight = (text: string, words: string[]) => {
      const frag = document.createDocumentFragment();
      const lower = text.toLowerCase();
      const usable = words.filter((word) => word.length > 1);
      let i = 0;
      while (i < text.length) {
        let at = -1;
        let len = 0;
        for (const word of usable) {
          const found = lower.indexOf(word, i);
          if (found !== -1 && (at === -1 || found < at)) {
            at = found;
            len = word.length;
          }
        }
        if (at === -1) {
          frag.append(text.slice(i));
          break;
        }
        if (at > i) frag.append(text.slice(i, at));
        const mark = document.createElement("mark");
        mark.textContent = text.slice(at, at + len);
        frag.append(mark);
        i = at + len;
      }
      return frag;
    };

    const paint = () => {
      links.forEach((link, index) => {
        link.classList.toggle("active", index === active);
        link.setAttribute("aria-selected", index === active ? "true" : "false");
      });
      if (active >= 0) links[active]?.scrollIntoView({ block: "nearest" });
    };

    const close = () => {
      results.classList.remove("open");
      input.setAttribute("aria-expanded", "false");
    };

    // Every notice is indexed once, on the current-notices page. An expired one (old source, past event,
    // or a historical record) is sent to the archive with the same anchor and labelled, never offered as current.
    const noticeRow = (page: PageData, sub: SubResult, dateTable: Dates): Row | null => {
      const id = sub.anchor?.id;
      const notice = id ? dateTable.notices[id] : undefined;
      if (!id || !notice) return null;
      const now = new Date();
      const expired = notice.historical || !isSourceFresh(notice.published, now) || eventState(notice.event, now) === "past";
      const prefix = page.url.startsWith("/en/") ? "/en" : "";
      return {
        href: expired ? `${archiveHref}#${id}` : `${prefix}/ngayong-linggo/#${id}`,
        title: sub.title || page.meta.title || "",
        kind: kinds["ngayong-linggo"] ?? "",
        note: expired ? archivedLabel : "",
      };
    };

    const toRows = async (pages: PageData[]): Promise<Row[]> => {
      const needsDates = pages.some((page) => page.meta.kind === "ngayong-linggo" || page.meta.kind === "lugar");
      const dateTable = needsDates ? await loadDates().catch(() => null) : null;
      const rows: Row[] = [];
      for (const page of pages) {
        const kind = page.meta.kind ?? "";
        const anchored = page.sub_results.filter((sub) => sub.anchor);
        if (kind === "ngayong-linggo" && dateTable) {
          const notices = anchored.map((sub) => noticeRow(page, sub, dateTable)).filter((row): row is Row => row !== null);
          if (notices.length) {
            rows.push(...notices);
            continue;
          }
        }
        let note = "";
        if (kind === "lugar" && dateTable) {
          const published = dateTable.places[page.url.split("/").filter(Boolean).pop() ?? ""];
          if (!isSourceFresh(published, new Date())) note = olderLabel;
        }
        // Without the date table a notice links to the notices page itself, which hides expired rows on its own.
        rows.push({ href: kind === "ngayong-linggo" ? page.url : (page.sub_results[0]?.url ?? page.url), title: page.meta.title ?? "", kind: kinds[kind] ?? "", note });
      }
      // Expired and older-source results sort after current ones (stable).
      return rows.sort((a, b) => Number(a.note !== "") - Number(b.note !== ""));
    };

    const run = async () => {
      const query = input.value.trim();
      const ticket = ++latest;
      if (!query) {
        results.replaceChildren();
        links = [];
        active = -1;
        close();
        return;
      }
      const variants = searchVariants(query);
      const words = [...new Set(variants.flatMap((variant) => variant.split(/\s+/)))];
      const pf = await loadPagefind();
      const found = pf ? await Promise.all(variants.map((variant) => pf.search(variant))).catch(() => []) : [];
      // One result per page, best score first, across the query and its synonym variants.
      const best = new Map<string, (typeof found)[number]["results"][number]>();
      for (const result of found.flatMap((set) => set.results)) {
        if ((best.get(result.id)?.score ?? -1) < result.score) best.set(result.id, result);
      }
      const unique = [...best.values()].sort((a, b) => b.score - a.score);
      const pages = await Promise.all(unique.slice(0, 12).map((result) => result.data())).catch(() => []);
      const rows = await toRows(pages);
      if (ticket !== latest) return;
      results.replaceChildren();
      links = [];
      active = -1;
      if (rows.length === 0) {
        const note = document.createElement("p");
        note.textContent = empty;
        results.append(note);
      } else {
        for (const row of rows.slice(0, 7)) {
          const link = document.createElement("a");
          link.href = row.href;
          link.setAttribute("role", "option");
          const title = document.createElement("span");
          title.append(highlight(row.title, words));
          const category = document.createElement("small");
          category.textContent = row.note ? `${row.kind} · ${row.note}` : row.kind;
          link.append(title, category);
          results.append(link);
          links.push(link);
        }
        const hint = document.createElement("div");
        hint.className = "hint";
        const shown = document.createElement("span");
        shown.textContent = countLabel(rows.length);
        const help = document.createElement("span");
        help.textContent = keys;
        hint.append(shown, help);
        results.append(hint);
      }
      results.classList.add("open");
      input.setAttribute("aria-expanded", "true");
    };
    const runSoon = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(run, 80);
    };

    input.addEventListener("input", runSoon);
    input.addEventListener("focus", () => {
      void loadPagefind();
      if (input.value.trim()) void run();
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        if (!links.length) return;
        active = (active + 1) % links.length;
        paint();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        if (!links.length) return;
        active = (active - 1 + links.length) % links.length;
        paint();
      } else if (event.key === "Escape") {
        close();
      } else if (event.key === "Enter" && active >= 0) {
        event.preventDefault();
        links[active]?.click();
      }
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (active >= 0) links[active]?.click();
      else void run();
    });
    box.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-q]");
      if (!button) return;
      input.value = button.dataset.q ?? "";
      void run();
      input.focus();
    });
    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest(".bp-search")) close();
    });
  }
</script>

<style>
  form {
    display: flex;
    border: 2px solid var(--ink);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
    transition: box-shadow var(--mid) var(--ease);
  }
  form:focus-within {
    box-shadow: 0 0 0 4px var(--mark-bg);
  }
  input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    border: 0;
    outline: 0;
    font: 500 18px var(--font);
    padding: 12px 16px;
    background: transparent;
    color: var(--ink);
  }
  input::placeholder {
    color: var(--muted);
  }
  form button {
    border: 0;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 16px;
    padding: 0 22px;
    min-height: 48px;
  }
  .field {
    position: relative;
  }
  .results {
    display: none;
    position: absolute;
    z-index: 20;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 18px 44px var(--shadow);
    max-height: 400px;
    overflow: auto;
  }
  .results.open {
    display: block;
  }
  .results :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    text-decoration: none;
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .results :global(a:first-child) {
    border-top: 0;
  }
  .results :global(a:hover),
  .results :global(a.active) {
    background: var(--subtle);
  }
  .results :global(small) {
    color: var(--muted);
    font-size: 14px;
  }
  .results :global(mark) {
    background: var(--mark-bg);
    color: inherit;
    border-radius: 3px;
  }
  .results :global(p) {
    margin: 0;
    padding: 14px 16px;
    color: var(--muted);
    font-size: 15px;
  }
  .results :global(.hint) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 16px;
    font-size: 13px;
    color: var(--muted);
    border-top: 1px solid var(--line);
    background: var(--subtle);
  }
  .popular {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .popular button {
    background: var(--subtle);
    border: 1px solid var(--line);
    border-radius: 6px;
    min-height: 48px;
    padding: 8px 12px;
    color: var(--ink);
    font-size: 15px;
  }
  .popular button:hover {
    border-color: var(--blue);
    color: var(--blue);
  }
</style>
