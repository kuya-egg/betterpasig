---
// The home page's barangay section: a picker and its panel left, the 30-barangay map right.
// The choice is remembered in localStorage on this browser only. Without script each shape links to its page.
import map from "../../design/map/pasig-map.json";
import { barangays, places, pasigSources } from "../lib/data";
import { href, langFromUrl, ui } from "../i18n";
import Verify from "./Verify.astro";
import { isSourceFresh } from "../lib/freshness";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const idByName = new Map(barangays.map((barangay) => [barangay.name, barangay.id]));
const choices = [...barangays].sort((a, b) => a.name.localeCompare(b.name, "fil"));
const recentPlaceDates = (barangayId: string) =>
  places
    .filter((place) => place.barangay_id === barangayId)
    .map(
      (place) =>
        Object.values(place.evidence)
          .flat()
          .map((ref) => pasigSources.find((source) => source.id === ref.split(":")[0])?.published_date ?? "")
          .sort()
          .at(-1) ?? "",
    );

function districtLabel(district: number | null): string | null {
  if (district === 1) return t.district1;
  if (district === 2) return t.district2;
  return null;
}
---

<section class="section bp-barangay" id="mapa" aria-labelledby="mapa-h">
  <div class="wrap grid grid--top bp-map">
    <div class="span-5 info">
      <div class="section-head">
        <h2 id="mapa-h">{t.mapTitle}</h2>
        <p>{t.mapLead}</p>
      </div>
      <label for="bsel" hidden>{t.yourBarangay}</label>
      <select id="bsel" hidden>
        <option value="" selected disabled>{t.mapPrompt}</option>
        {choices.map((barangay) => <option value={barangay.id}>{barangay.name}</option>)}
      </select>
      {
        choices.map((barangay) => {
          const district = districtLabel(barangay.district);
          const dates = recentPlaceDates(barangay.id);
          return (
            <dl class="bp-panel" data-panel={barangay.id}>
              {district && (
                <div>
                  <dt>{t.district}</dt>
                  <dd>
                    {district}
                    {barangay.verify && <Verify />}
                  </dd>
                </div>
              )}
              {barangay.punong_barangay && (
                <div>
                  <dt>{t.punongBarangay}</dt>
                  <dd>
                    {barangay.punong_barangay}
                    {barangay.verify && <Verify />}
                  </dd>
                </div>
              )}
              {barangay.hall_address && (
                <div>
                  <dt>{t.address}</dt>
                  <dd>
                    {barangay.hall_address}
                    {barangay.verify && <Verify />}
                  </dd>
                </div>
              )}
              <div>
                <dt>{en ? "New places" : "Mga bagong lugar"}</dt>
                <dd data-place-source-dates={JSON.stringify(dates)}>{dates.filter((date) => isSourceFresh(date, new Date())).length}</dd>
              </div>
              <div class="more">
                <a class="link" href={href(lang, `/barangay/${barangay.id}/`)}>
                  {en ? "Open barangay details" : "Tingnan ang detalye ng barangay"}
                </a>
              </div>
            </dl>
          );
        })
      }
    </div>
    <div class="span-6 start-7 bp-map__art">
      <svg viewBox="100 0 360 560" role="group" aria-label={t.mapLabel}>
        {
          map.barangays.map((shape) => {
            const id = idByName.get(shape.name);
            return (
              <a href={id ? href(lang, `/barangay/${id}/`) : "#mapa"} data-id={id} data-name={shape.name} data-x={shape.x} data-y={shape.y} aria-label={shape.name}>
                <path d={shape.d} />
              </a>
            );
          })
        }
        <text class="tip" text-anchor="middle" />
      </svg>
    </div>
    <div class="bp-map__directory">
      <h3>{en ? "Barangays by name" : "Mga barangay ayon sa pangalan"}</h3>
      <ul>
        {choices.map((barangay) => (
          <li><a href={href(lang, `/barangay/${barangay.id}/`)}>{barangay.name}</a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>(".bp-map");
  const select = root?.querySelector<HTMLSelectElement>("select");
  const anchors = root ? [...root.querySelectorAll<SVGAElement>("a[data-id]")] : [];
  const panels = root ? [...root.querySelectorAll<HTMLElement>("[data-panel]")] : [];
  const tip = root?.querySelector("text");
  if (root && select) {
    select.hidden = false;
    for (const label of select.labels ?? []) label.hidden = false;
    const show = (id: string | null) => {
      for (const anchor of anchors) {
        const on = Boolean(id) && anchor.dataset.id === id;
        anchor.classList.toggle("on", on);
        if (on) anchor.setAttribute("aria-current", "true");
        else anchor.removeAttribute("aria-current");
      }
      for (const panel of panels) panel.classList.toggle("on", panel.dataset.panel === id);
      if (id) {
        select.value = id;
        try {
          localStorage.setItem("bp-brgy", id);
        } catch {
          /* this browser is blocking storage */
        }
      }
    };

    const resolve = (saved: string | null) => {
      if (!saved) return null;
      if (panels.some((panel) => panel.dataset.panel === saved)) return saved;
      return anchors.find((anchor) => anchor.dataset.name === saved)?.dataset.id ?? null;
    };

    let saved: string | null = null;
    try {
      saved = localStorage.getItem("bp-brgy");
    } catch {
      /* this browser is blocking storage */
    }
    const restored = resolve(new URLSearchParams(location.search).get("barangay")) ?? resolve(saved);
    if (restored) show(restored);

    select.addEventListener("change", () => show(select.value || null));

    const placeTip = (anchor: SVGAElement) => {
      if (!tip) return;
      tip.textContent = anchor.dataset.name ?? "";
      tip.setAttribute("x", anchor.dataset.x ?? "0");
      tip.setAttribute("y", String(Number(anchor.dataset.y ?? "0") + 4));
      tip.classList.add("show");
    };

    for (const anchor of anchors) {
      anchor.addEventListener("click", (event) => {
        event.preventDefault();
        show(anchor.dataset.id ?? null);
      });
      anchor.addEventListener("mouseenter", () => placeTip(anchor));
      anchor.addEventListener("mouseleave", () => tip?.classList.remove("show"));
      anchor.addEventListener("focus", () => placeTip(anchor));
      anchor.addEventListener("blur", () => tip?.classList.remove("show"));
    }
  }
</script>

<style>
  /* Hallmark · dropped #mapa, {langFromUrl(Astro.url) === "en" ? `/en/barangay/${barangay.id}/` : `/barangay/${barangay.id}/`} · the same barangay pages are linked through href(lang, `/barangay/<id>/`) and the map anchor through href(lang, "/#mapa") in the nav and footer */
  .bp-barangay { background: var(--bg); }
  .bp-map__art {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: var(--s-5);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 0;
  }
  svg {
    width: auto;
    height: clamp(22rem, 42vw, 34rem);
    max-width: 100%;
    overflow: visible;
  }
  a path {
    fill: var(--pale);
    stroke: var(--bg);
    stroke-width: 1.5;
    stroke-linejoin: round;
    cursor: pointer;
    transition: fill var(--m-in, 150ms) var(--ease);
  }
  a:hover path,
  a:focus-visible path {
    fill: var(--hover);
  }
  a.on path {
    fill: var(--accent);
  }
  a:focus-visible path {
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .tip {
    pointer-events: none;
    font: 500 13px var(--font-text);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    opacity: 0;
  }
  .tip.show {
    opacity: 1;
  }
  .info {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    min-width: 0;
  }
  .info .section-head {
    margin-bottom: var(--s-5);
  }
  label {
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--muted);
  }
  select {
    font: 500 18px var(--font-text);
    padding: 0 var(--s-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--ink);
    min-height: 48px;
    width: 100%;
  }
  select:focus-visible {
    outline: 2px solid var(--action);
    outline-offset: 2px;
  }
  .bp-panel {
    display: none;
    margin: 0;
  }
  .bp-panel.on {
    display: grid;
  }
  .bp-panel div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .bp-panel .more {
    display: block;
    border-bottom: 0;
  }
  dt {
    color: var(--muted);
    font-size: var(--t-small);
  }
  dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .bp-map__directory { grid-column: 1 / -1; }
  .bp-map__directory h3 { margin-bottom: var(--s-3); }
  .bp-map__directory ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    column-gap: var(--s-4);
  }
  .bp-map__directory a {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-block: var(--s-2);
    min-height: 3rem;
    color: var(--blue);
    font-size: .9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 1023px) {
    .info,
    .bp-map__art {
      grid-column: 1 / -1;
    }
    svg {
      height: auto;
      width: min(100%, 420px);
    }
  }
</style>
