---
import Base from "../layouts/Base.astro";
import Verify from "./Verify.astro";
import { categories, officeById, servicesRetrieved, sourceLabel, type Service } from "../lib/data";
import { formatDate, href, langFromUrl, ui } from "../i18n";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const title = lang === "en" && service.title_en ? service.title_en : service.title_fil;
const office = officeById(service.office);
const officeLabel = office ? (office.acronym ? `${office.name} (${office.acronym})` : office.name) : service.office;
const category = categories.find((item) => item.id === service.category);
const categoryName = category ? (lang === "en" ? category.name_en : category.name_fil) : "";
const requirements = lines(service.requirements);
const steps = lines(service.steps);
const online = service.online?.url && /^https?:\/\//.test(service.online.url) ? service.online.url : "";
const fee = typeof service.fee === "string" && service.fee.trim() ? service.fee : "";
const time = typeof service.processing_time === "string" && service.processing_time.trim() ? service.processing_time : "";

function lines(value: unknown): string[] {
  if (!Array.isArray(value)) return [];
  return value.filter((item): item is string => typeof item === "string" && item.trim().length > 0);
}
---

<Base title={title} description={lang === "en" ? service.title_en : service.summary_fil || title}>
  <article class="wrap max-w-[760px] py-12">
    <p>
      <a class="link-draw" href={href(lang, `/serbisyo#${service.category}`)}>{categoryName || t.allServices}</a>
    </p>
    <h1 class="mt-3 text-[34px] font-bold leading-[1.15] tracking-[-0.04em]">
      {title}
      {service.verify && <Verify />}
    </h1>
    {
      service.summary_fil && (
        <p class="mt-4 text-muted" lang={lang === "en" ? "fil" : undefined}>
          {service.summary_fil}
        </p>
      )
    }

    <dl class="mt-8 border-t-2 border-ink">
      <div class="grid gap-0.5 border-b border-line py-3 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
        <dt class="text-[14px] font-medium text-muted">{t.colOffice}</dt>
        <dd>{officeLabel}</dd>
      </div>
      {
        office?.location && (
          <div class="grid gap-0.5 border-b border-line py-3 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
            <dt class="text-[14px] font-medium text-muted">{t.whereLabel}</dt>
            <dd>{office.location}</dd>
          </div>
        )
      }
      {
        office?.contact && (
          <div class="grid gap-0.5 border-b border-line py-3 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
            <dt class="text-[14px] font-medium text-muted">{t.officeContact}</dt>
            <dd class="[overflow-wrap:anywhere]">{office.contact}</dd>
          </div>
        )
      }
      {
        time && (
          <div class="grid gap-0.5 border-b border-line py-3 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
            <dt class="text-[14px] font-medium text-muted">{t.colTime}</dt>
            <dd class="num">{time}</dd>
          </div>
        )
      }
      {
        fee && (
          <div class="grid gap-0.5 border-b border-line py-3 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
            <dt class="text-[14px] font-medium text-muted">{t.colFee}</dt>
            <dd class="num">{fee}</dd>
          </div>
        )
      }
    </dl>

    {
      requirements.length > 0 && (
        <>
          <h2 class="mt-10 text-[19px] font-semibold tracking-[-0.01em]">{t.requirements}</h2>
          <ul class="mt-3 grid gap-2">
            {requirements.map((item) => (
              <li class="border-b border-line py-2">{item}</li>
            ))}
          </ul>
        </>
      )
    }

    {
      steps.length > 0 && (
        <>
          <h2 class="mt-10 text-[19px] font-semibold tracking-[-0.01em]">{t.stepsLabel}</h2>
          <ol class="mt-3 grid gap-2">
            {steps.map((item, index) => (
              <li class="border-b border-line py-2">
                <span class="num text-muted">{index + 1}. </span>
                {item}
              </li>
            ))}
          </ol>
        </>
      )
    }

    {
      online && (
        <p class="mt-8">
          <a href={online}>
            {t.doOnline}: {new URL(online).hostname.replace(/^www\./, "")}
          </a>
        </p>
      )
    }

    <p class="mt-8 text-[14px] text-muted">
      {t.sources}:{" "}
      {
        service.sources.map((url, index) => (
          <>
            {index > 0 && ", "}
            <a href={url}>{sourceLabel(url)}</a>
          </>
        ))
      }
      {" · "}
      {t.checked}: <span class="num">{formatDate(lang, servicesRetrieved)}</span>
    </p>
  </article>
</Base>
