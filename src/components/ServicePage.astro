---
import { ButtonLink } from "@/components/ui/button-link";
import Site from "../layouts/Site.astro";
import Verify from "./Verify.astro";
import ServiceNotices from "./ServiceNotices.astro";
import { categories, officeById, programs, servicesRetrieved, sourceLabel, type Service } from "../lib/data";
import { formatDate, href, langFromUrl, ui } from "../i18n";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const title = lang === "en" && service.title_en ? service.title_en : service.title_fil;
const office = officeById(service.office);
const officeLabel = office ? (office.acronym ? `${office.name} (${office.acronym})` : office.name) : service.office;
const category = categories.find((item) => item.id === service.category);
const categoryName = category ? (lang === "en" ? category.name_en : category.name_fil) : "";
const english = lang === "en" && "english" in service ? service.english : undefined;
const summary = english?.summary ?? service.summary_fil;
const detailLanguage = lang === "en" && !english ? "fil" : undefined;
const requirements = lines(english?.requirements ?? service.requirements);
const steps = lines(english?.steps ?? service.steps);
const online = service.id !== "pay-business-tax-online" && service.online?.url && /^https?:\/\//.test(service.online.url) ? service.online.url : "";
const fee = typeof service.fee === "string" && service.fee.trim()
  ? (english && "fee" in english ? english.fee : service.fee)
  : "";
const time = typeof service.processing_time === "string" && service.processing_time.trim()
  ? (english?.processing_time ?? service.processing_time)
  : "";
const factsTitle = fee
  ? (lang === "en" ? "Office and fee" : "Opisina at bayad")
  : (lang === "en" ? "Service details" : "Mga detalye ng serbisyo");
const onlineHost = online ? new URL(online).hostname.replace(/^www\./, "") : "";
/*
 * Related benefits: explicit program id -> office ids (from data/services.json `offices`).
 * Each mapping mirrors the office(s) named in that program's `office` string in
 * data/programs.json. A service is related when its `office` is listed here.
 * Programs whose office has no entry in `offices` (barangay, DepEd, mental health,
 * City Government generally) are intentionally unmapped, so they never mislink.
 */
const programOffices: Record<string, string[]> = {
  "local-senior-pension": ["osca"],
  "senior-year-end-cash-gift": ["osca"],
  "senior-milestone-incentive": ["osca"],
  "senior-burial-assistance": ["osca"],
  "senior-health-perks": ["osca", "pcgh", "chd"],
  "solo-parent-subsidy": ["cswdo"],
  "pwd-cash-gift": ["pdao"],
  "pwd-business-assistance": ["pdao"],
  "pagasa-scholarship": ["pced"],
  "pasig-city-scholars": ["pced"],
  "plp-admission": ["plp"],
};
const relatedPrograms = programs.filter((program) => programOffices[program.id]?.includes(service.office));
function lines(value: unknown): string[] {
  if (!Array.isArray(value)) return [];
  return value.filter((item): item is string => typeof item === "string" && item.trim().length > 0);
}
---

<Site title={title} description={lang === "en" ? english?.summary || title : summary || title}>
  <section class="section section--flow bp-service-page" aria-labelledby="service-h">
    <div class="wrap bp-svc">
      <div class="section-head">
        <a class="bp-svc__back" href={href(lang, `/serbisyo/#${service.category}`)}><span aria-hidden="true">←</span> {categoryName || t.allServices}</a>
        <h1 id="service-h">{title}</h1>
        {summary && <p lang={detailLanguage}>{summary}</p>}
        {service.verify && <Verify />}
      </div>

      <nav class="bp-svc__jump" aria-label={lang === "en" ? "On this page" : "Sa pahinang ito"} data-pagefind-ignore>
        <ul>
          <li><a href="#service-facts">{factsTitle}</a></li>
          {requirements.length > 0 && <li><a href="#service-requirements">{t.requirements}</a></li>}
          {steps.length > 0 && <li><a href="#service-steps">{t.stepsLabel}</a></li>}
        </ul>
      </nav>

      <div class="bp-svc__answers">
        <section class="bp-svc__overview" aria-labelledby="service-facts">
          <h2 id="service-facts" tabindex="-1">{factsTitle}</h2>
          <dl class="bp-svc__facts">
            <div><dt>{t.colOffice}</dt><dd>{officeLabel}</dd></div>
            {office?.location && <div><dt>{t.whereLabel}</dt><dd>{office.location}</dd></div>}
            {fee && <div><dt>{t.colFee}</dt><dd class="num" lang={detailLanguage}>{fee}</dd></div>}
            {time && <div><dt>{t.colTime}</dt><dd class="num" lang={detailLanguage}>{time}</dd></div>}
            {office?.contact && <div><dt>{t.officeContact}</dt><dd>{office.contact}</dd></div>}
          </dl>
          {online && (
            <ButtonLink className="bp-svc__online" href={online}>
              {onlineHost === "facebook.com" ? (lang === "en" ? "Official office page" : "Opisyal na pahina ng tanggapan") : t.doOnline}
              <span aria-hidden="true">↗</span>
            </ButtonLink>
          )}
          <p class="t-small muted bp-svc__source">
            {t.sources}
            {service.sources.map((url) => <a href={url}>{sourceLabel(url)}</a>)}
            <span>{t.checked} {formatDate(lang, servicesRetrieved)}</span>
          </p>
        </section>

        <div class="bp-svc__instructions">
          {requirements.length > 0 && (
            <section aria-labelledby="service-requirements">
              <h2 id="service-requirements" tabindex="-1">{t.requirements}</h2>
              <ul class="bp-svc__list" lang={detailLanguage}>
                {requirements.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )}
          {steps.length > 0 && (
            <section aria-labelledby="service-steps">
              <h2 id="service-steps" tabindex="-1">{t.stepsLabel}</h2>
              <ol class="bp-svc__list" lang={detailLanguage}>
                {steps.map((item) => <li>{item}</li>)}
              </ol>
            </section>
          )}
        </div>
      </div>

      <ServiceNotices serviceId={service.id} />

      {relatedPrograms.length > 0 && (
        <section class="bp-svc__related" aria-labelledby="service-benefits">
          <h2 id="service-benefits">{t.relatedBenefits}</h2>
          <ul>
            {relatedPrograms.map((program) => (
              <li><a class="link" href={href(lang, `/tulong/#${program.id}`)}>{lang === "en" ? program.title_en : program.title_fil}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</Site>

<style>
  .bp-service-page { padding-block-start: clamp(1.25rem, 3vw, 2.5rem); }
  .bp-svc__back {
    display: inline-flex;
    gap: var(--s-2);
    min-height: 3rem;
    align-items: center;
    justify-self: start;
    color: var(--blue);
    font-size: .9375rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bp-svc .section-head h1 {
    font: 800 clamp(2rem, 1.45rem + 2.6vw, 4.25rem)/1.08 var(--font-text);
    letter-spacing: -.035em;
    max-inline-size: 29ch;
    text-wrap: wrap;
  }
  .bp-svc__jump { margin-block: var(--s-5) var(--s-6); border-block: 1px solid var(--line); }
  .bp-svc__jump ul { display: flex; flex-wrap: wrap; column-gap: var(--s-5); }
  .bp-svc__jump a {
    display: inline-flex;
    align-items: center;
    min-block-size: 3rem;
    color: var(--blue);
    font-weight: 750;
    font-size: .9375rem;
    text-decoration: underline;
    text-underline-offset: .24em;
  }
  .bp-svc__answers {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .bp-svc__overview {
    border-radius: var(--r-lg);
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--pale);
  }
  .bp-svc__overview h2, .bp-svc__instructions h2, .bp-svc__related h2 {
    font: 800 clamp(1.28rem, 1.1rem + .8vw, 1.85rem)/1.3 var(--font-text);
    letter-spacing: -.025em;
  }
  .bp-svc__overview h2 { margin-block-end: var(--s-3); }
  .bp-svc__instructions h2 { padding-block-end: var(--s-3); border-block-end: 1px solid var(--line); }
  .bp-svc__facts { margin: 0; }
  .bp-svc__facts > div {
    display: grid;
    grid-template-columns: minmax(5rem, .6fr) minmax(0, 1.4fr);
    gap: var(--s-3);
    padding-block: var(--s-3);
  }
  .bp-svc__facts > div + div { border-top: 1px solid var(--line-strong); }
  .bp-svc__facts dt { font-weight: 750; }
  .bp-svc__facts dd { margin: 0; overflow-wrap: anywhere; }
  .bp-svc__online { margin-top: var(--s-3); height: auto; white-space: normal; gap: var(--s-2); }
  .bp-svc__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    margin-top: var(--s-3);
  }
  .bp-svc__source a { display: inline-flex; align-items: center; min-height: 3rem; color: var(--blue); text-decoration: underline; }
  .bp-svc__instructions > section + section { margin-top: var(--s-6); }
  .bp-svc__list { margin: var(--s-2) 0 0; padding-inline-start: var(--s-5); }
  .bp-svc__list :global(li::marker) { color: var(--blue); font-weight: 750; }
  ul.bp-svc__list { list-style: disc; }
  ol.bp-svc__list { list-style: decimal; }
  .bp-svc__list > li { padding-block: var(--s-2); padding-inline-start: var(--s-1); }
  .bp-svc__related { margin-top: var(--s-6); }
  .bp-svc__related a { display: inline-flex; align-items: center; min-height: 3rem; }
  @media (max-width: 48rem) {
    .bp-svc__answers { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 24rem) {
    .bp-svc__facts > div { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
  }
</style>
