---
import Kit from "../layouts/Kit.astro";
import Verify from "./Verify.astro";
import ServiceNotices from "./ServiceNotices.astro";
import { categories, officeById, programs, servicesRetrieved, sourceLabel, type Service } from "../lib/data";
import { formatDate, href, langFromUrl, ui } from "../i18n";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const title = lang === "en" && service.title_en ? service.title_en : service.title_fil;
const office = officeById(service.office);
const officeLabel = office ? (office.acronym ? `${office.name} (${office.acronym})` : office.name) : service.office;
const category = categories.find((item) => item.id === service.category);
const categoryName = category ? (lang === "en" ? category.name_en : category.name_fil) : "";
const requirements = lines(service.requirements);
const steps = lines(service.steps);
const online = service.id !== "pay-business-tax-online" && service.online?.url && /^https?:\/\//.test(service.online.url) ? service.online.url : "";
const fee = typeof service.fee === "string" && service.fee.trim() ? service.fee : "";
const time = typeof service.processing_time === "string" && service.processing_time.trim() ? service.processing_time : "";
/*
 * Related benefits: explicit program id -> office ids (from data/services.json `offices`).
 * Each mapping mirrors the office(s) named in that program's `office` string in
 * data/programs.json. A service is related when its `office` is listed here.
 * Programs whose office has no entry in `offices` (barangay, DepEd, mental health,
 * City Government generally) are intentionally unmapped, so they never mislink.
 */
const programOffices: Record<string, string[]> = {
  "local-senior-pension": ["osca"],
  "senior-year-end-cash-gift": ["osca"],
  "senior-milestone-incentive": ["osca"],
  "senior-burial-assistance": ["osca"],
  "senior-health-perks": ["osca", "pcgh", "chd"],
  "solo-parent-subsidy": ["cswdo"],
  "pwd-cash-gift": ["pdao"],
  "pwd-business-assistance": ["pdao"],
  "pagasa-scholarship": ["pced"],
  "pasig-city-scholars": ["pced"],
  "plp-admission": ["plp"],
};
const relatedPrograms = programs.filter((program) => programOffices[program.id]?.includes(service.office));
function lines(value: unknown): string[] {
  if (!Array.isArray(value)) return [];
  return value.filter((item): item is string => typeof item === "string" && item.trim().length > 0);
}
---

<Kit title={title} description={lang === "en" ? service.title_en : service.summary_fil || title}>
  <section class="section section--flow" aria-labelledby="service-h">
    <div class="wrap bp-svc">
      <div class="section-head">
        <a class="bp-svc__back" href={href(lang, `/serbisyo#${service.category}`)}>{categoryName || t.allServices}</a>
        <h1 id="service-h">
          {title}
          {service.verify && <Verify />}
        </h1>
        {service.summary_fil && <p lang={lang === "en" ? "fil" : undefined}>{service.summary_fil}</p>}
      </div>

      <ul class="rows rows--spec bp-svc__rows">
        <li>
          <span class="rows__name">{t.colOffice}</span>
          <span class="bp-svc__val">{officeLabel}</span>
        </li>
        {office?.location && (
          <li>
            <span class="rows__name">{t.whereLabel}</span>
            <span class="bp-svc__val">{office.location}</span>
          </li>
        )}
        {office?.contact && (
          <li>
            <span class="rows__name">{t.officeContact}</span>
            <span class="bp-svc__val bp-svc__break">{office.contact}</span>
          </li>
        )}
        {time && (
          <li>
            <span class="rows__name">{t.colTime}</span>
            <span class="bp-svc__val num">{time}</span>
          </li>
        )}
        {fee && (
          <li>
            <span class="rows__name">{t.colFee}</span>
            <span class="bp-svc__val num">{fee}</span>
          </li>
        )}
      </ul>

      <ServiceNotices serviceId={service.id} />

      {requirements.length > 0 && (
        <>
          <h2 class="t-label muted bp-svc__h">{t.requirements}</h2>
          <ul class="bp-svc__list">
            {requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}

      {steps.length > 0 && (
        <>
          <h2 class="t-label muted bp-svc__h">{t.stepsLabel}</h2>
          <ol class="bp-svc__list">
            {steps.map((item, index) => (
              <li>
                <span class="num muted">{index + 1}.</span>
                <span>{item}</span>
              </li>
            ))}
          </ol>
        </>
      )}

      {online && (
        <p class="bp-svc__online">
          <a class="btn btn--primary" href={online}>
            {t.doOnline}: {new URL(online).hostname.replace(/^www\./, "")}
          </a>
        </p>
      )}

      {relatedPrograms.length > 0 && (
        <>
          <h2 class="t-label muted bp-svc__h">{t.relatedBenefits}</h2>
          <ul class="bp-svc__list">
            {relatedPrograms.map((program) => (
              <li>
                <a class="rel" href={href(lang, `/tulong/#${program.id}`)}>
                  {lang === "en" ? program.title_en : program.title_fil}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      <p class="t-small muted bp-svc__source">
        <span>
          {t.sources}:{" "}
          {service.sources.map((url, index) => (
            <>
              {index > 0 && ", "}
              <a href={url}>{sourceLabel(url)}</a>
            </>
          ))}
        </span>
        <span>{t.checked}: <span class="num">{formatDate(lang, servicesRetrieved)}</span></span>
      </p>
    </div>
  </section>
</Kit>

<style>
  .bp-svc {
    max-width: 760px;
  }
  .bp-svc__back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-self: start;
    color: var(--muted);
    font-size: var(--t-small);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bp-svc__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bp-svc__rows > li {
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    align-items: baseline;
  }
  .bp-svc__val {
    min-width: 0;
  }
  .bp-svc__break {
    overflow-wrap: anywhere;
  }
  .bp-svc__h {
    margin-top: var(--s-8);
  }
  .bp-svc__list {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }
  .bp-svc__list > li {
    display: flex;
    gap: var(--s-3);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--line);
  }
  .bp-svc__online {
    margin-top: var(--s-7);
  }
  .rel {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bp-svc__source {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    margin-top: var(--s-8);
  }
  @media (max-width: 639px) {
    .bp-svc__rows > li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
