---
import { href, langFromUrl, ui } from "../../i18n";
import { emergencyHotlines, telHref } from "../../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const lines = emergencyHotlines.filter(({ id }) => id === "pasig-emergency-hotline" || id === "national-emergency-911");
---

<aside class="bp-urgent" aria-label={t.emergencyPageTitle}>
  <div class="wrap bp-urgent__inner">
    <ul class="bp-urgent__links">
      {lines.map((line) => (
        <li>
          <a href={telHref(line.numbers[0])}>
            <span>{line.id === "pasig-emergency-hotline" ? "Pasig DRRMO" : t.guideNational}</span>
            <strong>{line.numbers[0]}</strong>
          </a>
        </li>
      ))}
    </ul>
    <a class="bp-urgent__all" href={href(lang, "/emergency/#hotlines")}>{t.allHotlines} <span aria-hidden="true">→</span></a>
    <p class="bp-urgent__clock">
      <time data-ph-clock hidden data-weekdays={JSON.stringify(t.weekdays)} data-months={JSON.stringify(t.months)}>
        <span class="sr-only">{t.guideTime} </span>
        <strong data-clock-time></strong>
        <span data-clock-date></span>
      </time>
      <noscript>UTC+8</noscript>
    </p>
  </div>
</aside>

<script>
  import { manilaTimeZone } from "../../lib/freshness";

  const clock = document.querySelector<HTMLTimeElement>("[data-ph-clock]");
  const time = clock?.querySelector("[data-clock-time]");
  const date = clock?.querySelector("[data-clock-date]");

  if (clock && time && date) {
    const timeFormatter = new Intl.DateTimeFormat("en-PH", {
      timeZone: manilaTimeZone,
      hour: "numeric",
      minute: "2-digit",
      hourCycle: "h12",
    });
    const weekdays = JSON.parse(clock.dataset.weekdays ?? "[]") as string[];
    const months = JSON.parse(clock.dataset.months ?? "[]") as string[];
    const weekdayIndex: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    const dateParts = new Intl.DateTimeFormat("en-US", {
      timeZone: manilaTimeZone,
      weekday: "short",
      month: "numeric",
      day: "numeric",
      year: "numeric",
    });
    const minute = 60_000;
    let timer = 0;

    const update = () => {
      window.clearTimeout(timer);
      if (document.hidden) return;
      const now = new Date();
      time.textContent = timeFormatter.format(now);
      const parts = Object.fromEntries(dateParts.formatToParts(now).map((part) => [part.type, part.value]));
      const weekday = weekdays[weekdayIndex[parts.weekday]] ?? parts.weekday;
      const month = months[Number(parts.month) - 1] ?? parts.month;
      date.textContent = `${weekday}, ${month} ${Number(parts.day)}, ${parts.year}`;
      clock.dateTime = now.toISOString();
      clock.hidden = false;
      timer = window.setTimeout(update, minute - (now.getTime() % minute));
    };

    document.addEventListener("visibilitychange", update);
    window.addEventListener("pageshow", update);
    update();
  }
</script>

<style>
  /* pinned on every page and every width: the emergency numbers never scroll away */
  .bp-urgent { position: sticky; top: 0; z-index: 21; background: var(--red); color: white; }
  .bp-urgent__inner { display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--s-5); }
  .bp-urgent__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-5); }
  .bp-urgent__links li { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .bp-urgent__links a, .bp-urgent__all {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    min-height: 3rem;
    font-size: .875rem;
    text-underline-offset: 4px;
  }
  .bp-urgent__links strong { font-size: 1rem; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bp-urgent__all { text-decoration: underline; }
  .bp-urgent :is(a, button):focus-visible { outline-color: white; }
  .bp-urgent__clock { margin-inline-start: auto; font-size: var(--t-small); }
  .bp-urgent__clock time { display: inline-flex; gap: var(--s-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .bp-urgent__clock strong { font-weight: 600; }
  @media (hover: hover) { .bp-urgent a:hover { text-decoration: underline; } }
  @media (max-width: 56rem) {
    .bp-urgent__inner { gap: 0 var(--s-3); }
    .bp-urgent__links { flex-basis: 100%; gap: 0 var(--s-3); }
    .bp-urgent__clock { margin-inline-start: 0; padding-block: 0; }
    .bp-urgent__all { margin-inline-end: auto; }
    .bp-urgent__links a, .bp-urgent__all { min-height: 2.75rem; }
  }
</style>
