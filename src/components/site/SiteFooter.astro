---
// The navy footer (handoff 2026-11), the same on every page.
import Verify from "../Verify.astro";
import { formatDate, href, langFromUrl, ui } from "../../i18n";
import { cityHallHotline, mapsHref, site, telHref } from "../../lib/data";
import { photos } from "../../lib/photos";
import { buildCommit, buildVersion } from "../../lib/version";

interface Props {
  /** ids from data/photos.json shown on this page; when any, the legal row links the credits page. */
  photoIds?: string[];
}

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const { photoIds = [] } = Astro.props;
const showsPhotos = photos.some((item) => photoIds.includes(item.id));
const hall = site.city_hall;
const trunk = cityHallHotline?.numbers[0];
const year = new Date().getFullYear();
const notice = lang === "en" ? site.notice_en : site.notice_fil;
const [noticeStart, noticeEnd] = notice.split("pasigcity.gov.ph");
const columns = [
  {
    title: t.navServices,
    links: [
      { label: t.allServices, url: href(lang, "/serbisyo/") },
      { label: t.benefitsTitle, url: href(lang, "/tulong/") },
      { label: t.weeklyTitle, url: href(lang, "/ngayong-linggo/") },
    ],
  },
  {
    title: t.footCity,
    links: [
      { label: t.navBarangay, url: href(lang, "/barangay/") },
      { label: t.guideExplore, url: href(lang, "/pasyalan/") },
      { label: t.officialsPageTitle, url: href(lang, "/opisyal/") },
      { label: t.fundsTitle, url: href(lang, "/pondo/") },
    ],
  },
  {
    title: t.footHelp,
    links: [
      { label: t.emergencyPageTitle, url: href(lang, "/emergency/") },
      { label: t.aboutTitle, url: href(lang, "/tungkol/") },
      { label: t.aboutReport, url: "https://github.com/kuya-egg/betterpasig/issues/new" },
    ],
  },
];
---

<footer class="footer bp-footer" id="contact">
  <div class="wrap">
    <div class="closing__links" id="close-h">
      <div class="grid">
        <div class="span-5 stack-4 bp-foot-about">
          <p class="bp-footer__title">{t.footTitle}</p>
          <p class="t-small muted">{noticeStart}<a href="https://pasigcity.gov.ph">pasigcity.gov.ph</a>{noticeEnd}</p>
          <p class="t-small muted">
            {t.partOf} <a href="https://bettergov.ph">BetterGov.ph</a>. {t.dataUpdated}: {formatDate(lang, site.updated)}.
          </p>
          <p class="t-small muted">
            {hall.name}: <a href={mapsHref(`${hall.name}, ${hall.address}`)}>{hall.address}</a>
            {hall.verify && <Verify />}
            {trunk && (
              <>
                {" "}<a class="num" href={telHref(trunk)}>{trunk}</a>
                {cityHallHotline?.verify && <Verify />}
              </>
            )}
          </p>
        </div>
        {
          columns.map((column, index) => (
            <div class={`span-2 ${index === 0 ? "start-7" : ""} stack-4`}>
              <h2 class="bp-footer__column">{column.title}</h2>
              <ul class="bp-foot-links">
                {column.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="footer__legal">
        <p class="footer__legal-meta">
          {buildVersion && <a href={`https://github.com/kuya-egg/betterpasig/commit/${buildCommit}`}>{t.footVersion} {buildVersion}</a>}
          <span>{year} BetterPasig. {t.footRights}</span>
        </p>
        <p class="footer__legal-links">
          <a href="https://github.com/kuya-egg/betterpasig">{t.footContribute}</a>
          <a href="/sitemap-index.xml">{t.footSitemap}</a>
          {showsPhotos && <a href={href(lang, "/larawan/")}>{t.photoCredits}</a>}
        </p>
      </div>
    </div>
  </div>
</footer>
