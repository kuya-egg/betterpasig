---
import { ButtonLink } from "@/components/ui/button-link";
import Site from '../layouts/Site.astro';
import SourceNote from './SourceNote.astro';
import PageHead from './site/PageHead.astro';
import IbaPaTabs from './IbaPaTabs.astro';
import {historicalUpdates,opportunities,pasigSources,serviceUpdates,services} from '../lib/data';
import {contentLang,formatDate,href,langFromUrl,ui} from '../i18n';
import {eventState,isSourceFresh} from '../lib/freshness';
interface Props { archive?: boolean }
const {archive=false}=Astro.props;
const lang=langFromUrl(Astro.url);
const t=ui[lang];
const copy=contentLang(lang);
const title=archive?t.archiveTitle:t.recentTitle;
const historyTitle=(id:string)=>id.includes('parking')?t.historyParkingTitle:id.includes('blood')?t.historyBloodTitle:t.historyJobTitle;
const historyBody=(id:string,english:string)=>copy==='en'?english:id.includes('parking')?t.historyParkingBody:id.includes('blood')?t.historyBloodBody:t.historyJobBody;
const rows=[...serviceUpdates.map(item=>({id:item.id,title:copy==='en'?item.title_en:item.title_fil,date:item.published_date,eventDate:null,refs:item.evidence,service:item.service_id,summary:null,historical:false})),...opportunities.map(item=>({id:item.id,title:copy==='en'?item.title_en:item.title_fil,date:item.published_date,eventDate:item.event_date,refs:item.evidence,service:item.service_id,summary:null,historical:false})),...historicalUpdates.map(item=>({id:item.id,title:historyTitle(item.id),date:item.published_date,eventDate:null,refs:item.evidence,service:null,summary:historyBody(item.id,item.summary),historical:true}))];
---
<Site title={title} description={t.weeklyDesc}>
 <section class="section bp-weekly-top ground-white" aria-labelledby="weekly-h">
  <div class="wrap">
   <PageHead id="weekly-h" crumbs={archive?[[t.noticesTab,'/ngayong-linggo/'],[title]]:[[t.noticesTab]]} kicker={t.noticesTab} lead={archive?t.archiveLead:t.recentLead}>
    {archive?<>{t.archiveBefore}<em>{t.archiveEm}</em>{t.archiveAfter}</>:<>{t.recentBefore}<em>{t.recentEm}</em>{t.recentAfter}</>}
   </PageHead>
   <IbaPaTabs current="weekly" />
  </div>
 </section>
 <section class="section">
  <div class="wrap" data-current-feed={!archive||undefined} data-pagefind-ignore={archive||undefined}>
   <ol class="weekly">
    {rows.map(row=>{const current=!row.historical&&isSourceFresh(row.date,new Date())&&eventState(row.eventDate,new Date())!=='past';const source=pasigSources.find(s=>s.id===row.refs[0].split(':')[0]);const reg=opportunities.find(o=>o.id===row.id)?.registration_url;const when=new Date(`${row.date}T00:00:00Z`);const month=t.months[when.getUTCMonth()];return <li id={row.id} data-pagefind-title={row.title} data-published-date={row.date} data-event-date={row.eventDate} data-archive-record={archive||undefined} data-historical={String(row.historical)} hidden={archive?current:!current} class="weekly__item">
     <div class="weekly__date" aria-hidden="true"><span class="weekly__month">{month}</span><span class="weekly__day">{when.getUTCDate()}</span></div>
     <div class="weekly__body">
      <h2 class="weekly__title"><a class="link" href={services.some(service=>service.id===row.service)?href(lang,`/serbisyo/${row.service}/`):source?.url}>{row.title}</a></h2>
      <div class="weekly__dates t-small">
       <span>{t.publishedLabel}: {formatDate(lang,row.date)}</span>
       {row.eventDate&&<span>{t.scheduledLabel}: {formatDate(lang,row.eventDate)}</span>}
      </div>
      {row.eventDate&&<p class="t-small muted" data-event-status>{t.confirmSchedule}</p>}
      {row.summary&&<p>{row.summary}</p>}
      {row.id==='bfp-fsis-assistance-2026-10'&&<p class="t-small">{t.bfpNote} 09603402260, {t.weekdayRange} 08:00–17:00; {t.holidayPhoneNote}</p>}
      {row.id==='libreng-sakay-pasigpass-2026-10'&&<p class="t-small">{t.sakayNote}</p>}
      {reg&&row.eventDate&&eventState(row.eventDate,new Date())!=='past'&&<p><a class="link" data-registration href={reg}>{t.registrationForm}</a></p>}
      <SourceNote refs={row.refs}/>
     </div>
    </li>;})}
   </ol>
   {!archive && <p class="muted" data-feed-empty hidden={rows.length > 0}>{t.noRecentNotices}</p>}
   {archive && rows.length === 0 && <p class="muted">{t.noArchivedNotices}</p>}
   <p class="weekly__more"><ButtonLink variant="outline" href={href(lang,archive?'/ngayong-linggo/':'/ngayong-linggo/arkibo/')}>{archive?t.seeRecent:t.openArchive}</ButtonLink></p>
  </div>
 </section>
</Site>

<style>
  .bp-weekly-top { padding-block-end: var(--s-6); }
  .bp-weekly-top :global(.bp-tabs) { margin-block-start: var(--s-6); }
  .weekly { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .weekly__item { display: flex; flex-wrap: wrap; gap: var(--s-5); align-items: flex-start; background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-lg); padding: var(--s-5); scroll-margin-top: var(--sticky-offset); }
  .weekly__item[hidden] { display: none; }
  .weekly__date { flex: 0 0 6rem; display: grid; justify-items: center; background: var(--pale); border-radius: var(--r-md); padding: var(--s-3) var(--s-2); }
  .weekly__month { font: 600 var(--t-label)/1.5 var(--font-text); letter-spacing: .12em; text-transform: uppercase; color: var(--blue); }
  .weekly__day { font: 500 2.5rem/1 var(--font-display); color: var(--ink); }
  .weekly__body { flex: 1 1 24rem; min-width: 0; display: grid; gap: var(--s-2); }
  .weekly__body > * { margin: 0; }
  .weekly__title { font-size: var(--t-h3); }
  .weekly__dates { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); color: var(--muted); }
  .weekly__more { margin-top: var(--s-6); }
</style>
