---
import Base from '../layouts/Base.astro';
import SourceNote from './SourceNote.astro';
import {historicalUpdates,opportunities,pasigSources,serviceUpdates} from '../lib/data';
import {formatDate,href,langFromUrl} from '../i18n';
import {eventState,isSourceFresh} from '../lib/freshness';
interface Props { archive?: boolean }
const {archive=false}=Astro.props;
const lang=langFromUrl(Astro.url),en=lang==='en';
const title=archive?(en?'Notice archive':'Arkibo ng mga abiso'):(en?'Recent notices and opportunities':'Mga bagong abiso at oportunidad');
const rows=[...serviceUpdates.map(item=>({id:item.id,title:en?item.title_en:item.title_fil,date:item.published_date,eventDate:null,refs:item.evidence,service:item.service_id,summary:null,historical:false})),...opportunities.map(item=>({id:item.id,title:en?item.title_en:item.title_fil,date:item.published_date,eventDate:item.event_date,refs:item.evidence,service:item.service_id,summary:null,historical:false})),...historicalUpdates.map(item=>({id:item.id,title:en?(item.id.includes('parking')?'Mega Parking I maintenance':item.id.includes('blood')?'PCIST blood donation announcement':'October 1–2 job fair report'):(item.id.includes('parking')?'Maintenance sa Mega Parking I':item.id.includes('blood')?'Anunsyo ng blood donation sa PCIST':'Ulat sa job fair noong Oktubre 1–2'),date:item.published_date,eventDate:null,refs:item.evidence,service:null,summary:en?item.summary:item.id.includes('parking')?'May anunsyo ng pagsasara sa ikatlong palapag noong Oktubre 7, 08:00–12:01. Hindi nito itinatakda ang kasalukuyang bukas na kapasidad.':item.id.includes('blood')?'Nakatakda noon ang aktibidad noong Oktubre 8, 08:00–13:00. Hindi patunay ang anunsyo na natuloy ito.':'Iniulat ng lungsod ang 1,067 jobseeker at 1,753 kwalipikadong application noong Oktubre 1–2. Magkaibang sukatan ang tao at application.',historical:true}))];
---
<Base title={title}>
 <article class="wrap max-w-[820px] py-10" data-current-feed={!archive||undefined}>
  <h1 class="text-[30px] font-bold">{title}</h1>
  <ul class="mt-3 divide-y divide-line border-y border-line">
   {rows.map(row=>{const current=!row.historical&&isSourceFresh(row.date,new Date())&&eventState(row.eventDate,new Date())!=='past';const source=pasigSources.find(s=>s.id===row.refs[0].split(':')[0]);return <li id={row.id} data-published-date={row.date} data-event-date={row.eventDate} data-archive-record={archive||undefined} data-historical={String(row.historical)} hidden={archive?current:!current} class="py-4">
    <h2 class="text-[20px] font-semibold"><a href={row.service?href(lang,`/serbisyo/${row.service}`):source?.url}>{row.title}</a></h2>
    <p>{en?'Published':'Inanunsyo'}: {formatDate(lang,row.date)}{row.eventDate&&` · ${en?'Scheduled':'Nakatakda'}: ${formatDate(lang,row.eventDate)}`}</p>
    {row.eventDate&&<p data-event-status>{en?'Scheduled event; confirm with the organizer.':'Nakatakdang aktibidad; kumpirmahin sa tagapag-ayos.'}</p>}
    {row.summary&&<p class="mt-2">{row.summary}</p>}
    {row.id==='bfp-fsis-assistance-2026-10'&&<p class="mt-2">{en?'BFP transaction assistance; not an emergency hotline.':'Tulong sa transaksyon sa BFP; hindi emergency hotline.'} 09603402260 · {en?'Mon–Fri':'Lun–Biy'} 08:00–17:00; {en?'holidays excluded. Published number; not checked by phone.':'hindi kasama ang mga holiday. Hindi pa nasusubukang tawagan.'}</p>}
    {row.id==='libreng-sakay-pasigpass-2026-10'&&<p class="mt-2">{en?'The notice reports six routes. QR is optional; manual registration is available. Stops and route geometry are unverified.':'Anim na ruta ang iniulat. Opsyonal ang QR; may manual na rehistrasyon. Hindi pa napatutunayan ang mga hintuan at guhit ng ruta.'}</p>}
    <SourceNote refs={row.refs}/>
   </li>;})}
  </ul>
  {!archive&&<p data-feed-empty hidden>{en?'No recent official notices are listed.':'Walang nakalistang bagong opisyal na anunsyo.'}</p>}
  <p class="mt-6"><a href={href(lang,archive?'/ngayong-linggo/':'/ngayong-linggo/arkibo/')}>{archive?(en?'Recent notices':'Mga bagong abiso'):(en?'Notice archive':'Arkibo ng mga abiso')}</a></p>
 </article>
</Base>

<style>
  a { display: inline-flex; min-height: 48px; align-items: center; }
</style>
