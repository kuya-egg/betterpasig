---
import Kit from '../layouts/Kit.astro';
import SourceNote from './SourceNote.astro';
import {historicalUpdates,opportunities,pasigSources,serviceUpdates} from '../lib/data';
import {formatDate,href,langFromUrl} from '../i18n';
import {eventState,isSourceFresh} from '../lib/freshness';
interface Props { archive?: boolean }
const {archive=false}=Astro.props;
const lang=langFromUrl(Astro.url),en=lang==='en';
const title=archive?(en?'Notice archive':'Arkibo ng mga abiso'):(en?'Recent notices and opportunities':'Mga bagong abiso at oportunidad');
const rows=[...serviceUpdates.map(item=>({id:item.id,title:en?item.title_en:item.title_fil,date:item.published_date,eventDate:null,refs:item.evidence,service:item.service_id,summary:null,historical:false})),...opportunities.map(item=>({id:item.id,title:en?item.title_en:item.title_fil,date:item.published_date,eventDate:item.event_date,refs:item.evidence,service:item.service_id,summary:null,historical:false})),...historicalUpdates.map(item=>({id:item.id,title:en?(item.id.includes('parking')?'Mega Parking I maintenance':item.id.includes('blood')?'PCIST blood donation announcement':'October 1–2 job fair report'):(item.id.includes('parking')?'Maintenance sa Mega Parking I':item.id.includes('blood')?'Anunsyo ng blood donation sa PCIST':'Ulat sa job fair noong Oktubre 1–2'),date:item.published_date,eventDate:null,refs:item.evidence,service:null,summary:en?item.summary:item.id.includes('parking')?'May anunsyo ng pagsasara sa ikatlong palapag noong Oktubre 7, 08:00–12:01. Hindi nito itinatakda ang kasalukuyang bukas na kapasidad.':item.id.includes('blood')?'Nakatakda noon ang aktibidad noong Oktubre 8, 08:00–13:00. Hindi patunay ang anunsyo na natuloy ito.':'Iniulat ng lungsod ang 1,067 jobseeker at 1,753 kwalipikadong application noong Oktubre 1–2. Magkaibang sukatan ang tao at application.',historical:true}))];
---
<Kit title={title} description={en?'Recent official notices and opportunities from Pasig City, each with its source and date.':'Mga bagong opisyal na abiso at oportunidad sa Lungsod ng Pasig, may pinagmulan at petsa.'}>
 <section class="section section--flow" aria-labelledby="weekly-h">
  <div class="wrap" data-current-feed={!archive||undefined} data-pagefind-ignore={archive||undefined}>
   <div class="section-head">
    <h1 id="weekly-h">{title}</h1>
    <p>{archive?(en?'Older notices and ones whose date has passed.':'Mga lumang abiso at mga lumipas na ang petsa.'):(en?'Official notices still current, each with its source.':'Mga opisyal na abisong kasalukuyan pa, may pinagmulan bawat isa.')}</p>
   </div>
   <ul class="weekly">
    {rows.map(row=>{const current=!row.historical&&isSourceFresh(row.date,new Date())&&eventState(row.eventDate,new Date())!=='past';const source=pasigSources.find(s=>s.id===row.refs[0].split(':')[0]);return <li id={row.id} data-pagefind-title={row.title} data-published-date={row.date} data-event-date={row.eventDate} data-archive-record={archive||undefined} data-historical={String(row.historical)} hidden={archive?current:!current} class="weekly__item">
     <h2 class="weekly__title"><a class="link" href={row.service?href(lang,`/serbisyo/${row.service}`):source?.url}>{row.title}</a></h2>
     <div class="weekly__dates t-small">
      <span>{en?'Published':'Inanunsyo'}: {formatDate(lang,row.date)}</span>
      {row.eventDate&&<span>{en?'Scheduled':'Nakatakda'}: {formatDate(lang,row.eventDate)}</span>}
     </div>
     {row.eventDate&&<p class="t-small muted" data-event-status>{en?'Scheduled event; confirm with the organizer.':'Nakatakdang aktibidad; kumpirmahin sa tagapag-ayos.'}</p>}
     {row.summary&&<p>{row.summary}</p>}
     {row.id==='bfp-fsis-assistance-2026-10'&&<p class="t-small">{en?'BFP transaction assistance; not an emergency hotline.':'Tulong sa transaksyon sa BFP; hindi emergency hotline.'} 09603402260, {en?'Mon–Fri':'Lun–Biy'} 08:00–17:00; {en?'holidays excluded. Published number; not checked by phone.':'hindi kasama ang mga holiday. Hindi pa nasusubukang tawagan.'}</p>}
     {row.id==='libreng-sakay-pasigpass-2026-10'&&<p class="t-small">{en?'The notice reports six routes. QR is optional; manual registration is available. Stops and route geometry are unverified.':'Anim na ruta ang iniulat. Opsyonal ang QR; may manual na rehistrasyon. Hindi pa napatutunayan ang mga hintuan at guhit ng ruta.'}</p>}
     <SourceNote refs={row.refs}/>
    </li>;})}
   </ul>
   {!archive&&<p class="muted" data-feed-empty hidden>{en?'No recent official notices are listed.':'Walang nakalistang bagong opisyal na anunsyo.'}</p>}
   <p class="weekly__more"><a class="btn btn--secondary" href={href(lang,archive?'/ngayong-linggo/':'/ngayong-linggo/arkibo/')}>{archive?(en?'See recent notices':'Tingnan ang mga bagong abiso'):(en?'Open notice archive':'Buksan ang arkibo ng mga abiso')}</a></p>
  </div>
 </section>
</Kit>

<style>
  .weekly { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .weekly__item { display: grid; gap: var(--s-2); padding: var(--s-4) 0; border-bottom: 1px solid var(--line); }
  .weekly__item[hidden] { display: none; }
  .weekly__item > * { margin: 0; }
  .weekly__title { font-size: var(--t-card); }
  .weekly__dates { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); color: var(--muted); }
  .weekly__more { margin-top: var(--s-6); }
</style>
