---
import CopyButton from "./CopyButton.astro";
import Verify from "./Verify.astro";
import { emergencyHotlines, telHref } from "../lib/data";
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const label = (h: (typeof emergencyHotlines)[number]) => (lang === "en" ? h.label_en : h.label_fil);
const [main, ...rest] = emergencyHotlines;
---

<section class="border-b border-red/20 bg-red-bg" aria-label={t.emergency}>
  <div class="wrap flex flex-wrap items-center gap-x-4 gap-y-1 py-1 text-[15px]">
    <span class="font-semibold text-red">{t.emergency}</span>
    {
      [main, ...rest].map((h, i) => (
        <span class="inline-flex items-center gap-1">
          <span class="text-muted">{label(h)}</span>
          <a
            class:list={["num font-bold whitespace-nowrap", i === 0 ? "text-[20px] text-red" : "text-ink"]}
            href={telHref(h.numbers[0])}
          >
            {h.numbers[0]}
          </a>
          {h.verify && <Verify />}
          <CopyButton value={h.numbers[0]} label={t.copyNumber(h.numbers[0])} />
        </span>
      ))
    }
    <a class="link-draw ml-auto text-[14px] font-medium" href={href(lang, "/emergency/")}>{t.moreNumbers}</a>
  </div>
</section>
