const { id } = Astro.props;
const d = paths[id];
if (!d) throw new Error(`LifeIcon: no glyph for "${id}"`);
---

<span class="bp-life-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg>
</span>

<style>
  .bp-life-icon {
    display: inline-grid;
    place-items: center;
    color: var(--accent);
    flex: none;
  }
  .bp-life-icon svg {
    width: 28px;
    height: 28px;
  }
</style>
