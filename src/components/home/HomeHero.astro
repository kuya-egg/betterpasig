---
import { Picture } from "astro:assets";
import Search from "../Search.astro";
import { href, langFromUrl, ui } from "../../i18n";
import { liveAlerts } from "../../lib/alerts";
import { photo, photoAlt } from "../../lib/photos";
import TopServices from "./TopServices.astro";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const alert = liveAlerts(lang)[0];
const hero = photo("plaza-rizal");
---

<section class="bp-intro" aria-labelledby="hero-h">
  <div class="wrap bp-intro__layout">
    <div class="bp-intro__main">
      {
        alert && (
          <p class="bp-intro__alert" data-alert-expires={alert.expires}>
            {alert.text} <a href={alert.source}>{alert.host}</a>
          </p>
        )
      }
      <h1 id="hero-h">{t.homeTitle}</h1>
      <p class="bp-intro__lead">{t.homeLead}</p>
      <Search />
      <TopServices />
    </div>
    <div class="bp-intro__photo">
      <Picture
        src={hero.image}
        alt={photoAlt(hero, lang)}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[400, 640, 960, 1200]}
        sizes="(max-width: 799px) 90vw, (max-width: 1343px) 42vw, 540px"
        width={960}
        loading="eager"
        fetchpriority="high"
      />
      <a class="bp-intro__visit" href={href(lang, "/#pasyalan")}>
        <span>{t.guideExplore}</span><span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<style>
  .bp-intro { background: var(--pale); border-bottom: 1px solid var(--line); }
  .bp-intro .bp-intro__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.07fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .bp-intro__main { min-width: 0; }
  .bp-intro h1 {
    max-width: 14ch;
    font-size: clamp(2.1rem, 1.18rem + 3.3vw, 4.65rem);
    font-weight: 760;
    letter-spacing: -.058em;
    text-wrap: balance;
  }
  .bp-intro__lead { max-width: 44ch; margin-block: var(--s-4) var(--s-5); color: var(--muted); }
  .bp-intro__alert {
    margin-bottom: var(--s-4);
    padding: var(--s-3);
    background: var(--bg);
    border-inline-start: 3px solid var(--blue);
  }
  .bp-intro__alert a { text-decoration: underline; }

  .bp-intro__photo {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--surface);
    aspect-ratio: 1 / 1.08;
  }
  .bp-intro__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 53% center;
    outline: 1px solid rgb(0 0 0 / .1);
    outline-offset: -1px;
  }
  .bp-intro__visit {
    position: absolute;
    inset-inline: var(--s-4);
    inset-block-end: var(--s-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    min-height: 3rem;
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--blue);
    font-weight: 700;
  }
  @media (hover: hover) { .bp-intro__visit:hover span:first-child { text-decoration: underline; } }

  @media (max-width: 49.9375rem) {
    .bp-intro .bp-intro__layout { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .bp-intro h1 { max-width: 19ch; letter-spacing: -.045em; text-wrap: balance; }
    .bp-intro__photo { aspect-ratio: 16 / 9; }
  }

  @media (max-width: 29rem) {
    .bp-intro__lead { margin-block: var(--s-2) var(--s-4); }
    .bp-intro__photo { aspect-ratio: 4 / 3; }
  }
</style>
