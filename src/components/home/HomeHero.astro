---
import { Picture } from "astro:assets";
import Search from "../Search.astro";
import TopServices from "./TopServices.astro";
import { href, langFromUrl, ui } from "../../i18n";
import { liveAlerts } from "../../lib/alerts";
import { photo, photoAlt } from "../../lib/photos";
import { programs, services } from "../../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const alert = liveAlerts(lang)[0];
const lead = t.homeLead.replace("{services}", String(services.length)).replace("{programs}", String(programs.length));
const image = photo("pasig-museum");
---

<section class="wrap civic-hero" aria-labelledby="hero-h">
  <div class="civic-hero__frame">
    <div class="civic-hero__poster">
      <Picture
        src={image.image}
        alt={photoAlt(image, lang)}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[400, 640, 880, 1080]}
        sizes="(max-width: 767px) 94vw, 70vw"
        width={880}
        quality={51}
        loading="eager"
        fetchpriority="high"
        class="civic-hero__photo"
      />
      <div class="civic-hero__lead">
        {alert && (
          <p class="civic-hero__alert" data-alert-expires={alert.expires}>
            {alert.text} <a href={alert.source}>{alert.host}</a>
          </p>
        )}
        <h1 id="hero-h">{t.homeTitle}</h1>
        <p>{lead}</p>
        <Search />
      </div>
      <a class="civic-hero__place" href={href(lang, "/#pasyalan-pasig-city-museum")}>
        Pasig City Museum
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <TopServices />
</section>

<style>
  .civic-hero { position: relative; padding-block: var(--s-2) var(--s-5); }
  .civic-hero__frame {
    position: relative;
    border-radius: calc(var(--r-lg) + .5rem);
    padding: .5rem;
    background: var(--surface);
    box-shadow: 0 12px 40px var(--shadow);
  }
  .civic-hero__frame:has(:global(.bp-search__popup:not([hidden]))) { z-index: 2; }
  .civic-hero__poster {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 42vw, 35rem);
    border-radius: var(--r-lg);
    background: #121d31;
    color: #fff8e9;
  }
  .civic-hero__poster :global(picture) {
    position: absolute;
    z-index: -2;
    inset: 0 0 0 23%;
    border-radius: inherit;
    overflow: hidden;
  }
  .civic-hero__poster :global(.civic-hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 56% 55%;
  }
  .civic-hero__poster::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    content: "";
    background: linear-gradient(90deg, #121d31 3%, #121d31 23%, #121d31e8 37%, #121d3194 56%, #121d3110 84%);
  }
  .civic-hero__lead { width: min(58%, 44rem); padding: var(--s-6) 0 var(--s-8) clamp(2rem, 5vw, 5rem); }
  .civic-hero__lead h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 2rem + 5.1vw, 7.3rem);
    line-height: .92;
    letter-spacing: -.048em;
    text-wrap: wrap;
    font-weight: 500;
  }
  .civic-hero__lead > p:not(.civic-hero__alert) {
    color: #e6eaf3;
    max-width: 41ch;
    margin-block: var(--s-4) var(--s-5);
    line-height: 1.65;
  }
  .civic-hero__lead :global(.bp-search) { max-width: 32rem; }
  .civic-hero__lead :global(.bp-search__label) {
    position: absolute;
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
  }
  .civic-hero__alert {
    margin-block-end: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-sm);
    background: #f7f4ec;
    color: #182032;
  }
  .civic-hero__alert a { text-decoration: underline; }
  .civic-hero__place {
    position: absolute;
    inset: auto 1.25rem 3.875rem auto;
    display: inline-flex;
    gap: var(--s-2);
    align-items: center;
    min-height: 3rem;
    padding-inline: var(--s-4) var(--s-2);
    border-radius: var(--r-btn);
    background: #111b2bf2;
    color: #fff8e9;
    font-size: .875rem;
    font-weight: 650;
  }
  .civic-hero__place span {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background: rgb(255 255 255 / .13);
  }
  .civic-hero__place:focus-visible { outline-color: #fff8e9; }

  @media (prefers-reduced-motion: no-preference) {
    .civic-hero__lead { animation: civic-arrive 540ms var(--ease) both; }
    .civic-hero__poster :global(.civic-hero__photo) { animation: civic-photo 950ms var(--ease) both; }
    .civic-hero__place span { transition: transform var(--mid) var(--ease); }
    @keyframes civic-arrive { from { opacity: .5; transform: translateY(.75rem); } }
    @keyframes civic-photo { from { opacity: .5; transform: scale(1.025); } }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .civic-hero__place:hover span { transform: translate(.125rem, -.125rem); }
  }
  @media (max-width: 47.9375rem) {
    .civic-hero { padding-block-start: 0; }
    .civic-hero__frame { padding: .3125rem; border-radius: calc(var(--r-md) + .3125rem); }
    .civic-hero__poster { min-height: auto; border-radius: var(--r-md); }
    .civic-hero__poster :global(picture) { inset: 0; }
    .civic-hero__poster :global(.civic-hero__photo) { object-position: 66% center; }
    .civic-hero__poster::after {
      background: linear-gradient(90deg, #121d31f6 0%, #121d31b5 66%, #121d3185 100%),
        linear-gradient(0deg, #121d31d9, transparent 70%);
    }
    .civic-hero__lead { width: 100%; padding: 2.25rem var(--s-4) 4.5rem; }
    .civic-hero__lead h1 { max-width: 14ch; text-wrap: balance; }
    .civic-hero__lead > p:not(.civic-hero__alert) { font-size: .9375rem; margin-block: var(--s-3) var(--s-4); }
    .civic-hero__place { inset: auto .625rem .625rem auto; }
  }
</style>
