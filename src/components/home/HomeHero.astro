---
import Search from "../Search.astro";
import TopServices from "./TopServices.astro";
import { langFromUrl, ui } from "../../i18n";
import { liveAlerts } from "../../lib/alerts";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const alert = liveAlerts(lang)[0];
---

<section class="civic-hero" aria-labelledby="hero-h">
  <div class="wrap civic-hero__layout">
    <div class="civic-hero__intro">
      {alert && (
        <p class="civic-hero__alert" data-alert-expires={alert.expires}>
          {alert.text} <a href={alert.source}>{alert.host}</a>
        </p>
      )}
      <h1 id="hero-h">{t.homeTitle}</h1>
      <p class="civic-hero__lead">{t.homeLead}</p>
      <Search includePlaces />
    </div>
    <TopServices />
  </div>
</section>

<style>
  .civic-hero {
    background: var(--pale);
    border-block-end: 1px solid var(--line);
    padding-block: clamp(1.5rem, 4.5vw, 4.25rem);
  }
  .civic-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4.5rem);
  }
  .civic-hero__intro h1 {
    max-inline-size: 18ch;
    font: 800 clamp(2rem, 1.45rem + 2.6vw, 4.25rem)/1.05 var(--font-text);
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .civic-hero__lead {
    max-inline-size: 48ch;
    color: var(--muted);
    margin-block: var(--s-3) var(--s-5);
  }
  .civic-hero__alert {
    margin-block-end: var(--s-4);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
  }
  .civic-hero__alert a { color: var(--blue); text-decoration: underline; }

  @media (max-width: 54rem) {
    .civic-hero__layout { grid-template-columns: minmax(0, 1fr); }
    .civic-hero__intro h1 { max-inline-size: 22ch; text-wrap: wrap; }
  }
</style>
