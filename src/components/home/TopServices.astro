---
import { href, langFromUrl, ui } from "../../i18n";
import { featuredServices } from "../../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const labels: Record<string, { fil: string; en: string }> = {
  "pay-real-property-tax": { fil: "Magbayad ng amilyar", en: "Pay property tax" },
  "senior-citizen-id": { fil: "Kumuha ng Senior Citizen ID", en: "Get a senior ID" },
  aics: { fil: "Humingi ng tulong pinansiyal", en: "Get financial assistance" },
  "certified-copy-civil-document": { fil: "Kumuha ng rekord ng civil registry", en: "Get civil registry records" },
  "business-permit-renewal": { fil: "Mag-renew ng business permit", en: "Renew a business permit" },
  "scholarship-new": { fil: "Mag-apply ng scholarship", en: "Apply for a scholarship" },
};
---

<div class="bp-quick" id="serbisyo">
  <div class="bp-quick__paper">
    <div class="bp-quick__intro">
      <h2 id="serbisyo-h">{t.topTitle}</h2>
      <a class="bp-quick__all" href={href(lang, "/serbisyo/")}>{t.allServices}<span aria-hidden="true">↗</span></a>
    </div>
    <ul>
      {featuredServices.map((service) => (
        <li>
          <a href={href(lang, `/serbisyo/${service.id}/`)}>
            {labels[service.id]?.[lang] ?? (lang === "en" ? service.title_en : service.title_fil)}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .bp-quick {
    position: relative;
    z-index: 1;
    width: calc(100% - clamp(2rem, 8vw, 8rem));
    margin: -3rem auto 0;
    padding: .4375rem;
    border-radius: calc(var(--r-lg) + .4375rem);
    background: var(--surface);
    box-shadow: 0 16px 48px var(--shadow);
  }
  .bp-quick__paper {
    display: grid;
    grid-template-columns: minmax(10rem, .8fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--s-4) var(--s-7);
    border-radius: var(--r-lg);
    background: var(--bg);
    padding: var(--s-4) var(--s-6);
  }
  .bp-quick h2 { font-size: clamp(1.5rem, 1.16rem + 1vw, 2.2rem); text-wrap: wrap; }
  .bp-quick ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-5);
  }
  .bp-quick li:nth-child(n + 3) { border-block-start: 1px solid var(--line); }
  .bp-quick li a, .bp-quick__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    min-height: 3rem;
    padding-block: var(--s-2);
    font-size: .875rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .bp-quick__all { display: inline-flex; color: var(--blue); text-decoration: underline; text-underline-offset: .25em; }
  .bp-quick li a span {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background: var(--pale);
    color: var(--blue);
  }
  @media (hover: hover) {
    .bp-quick li a:hover { color: var(--blue); text-decoration: underline; text-underline-offset: .2em; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .bp-quick li a span { transition: transform var(--mid) var(--ease); }
    .bp-quick li a:hover span { transform: translate(.125rem, -.125rem); }
  }
  @media (max-width: 52rem) {
    .bp-quick { width: 100%; margin-top: var(--s-3); }
    .bp-quick__paper { grid-template-columns: 1fr; padding: var(--s-3) var(--s-4); }
    .bp-quick__intro { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 0 var(--s-2); }
  }
  @media (max-width: 23rem) {
    .bp-quick ul { grid-template-columns: 1fr; }
    .bp-quick li + li { border-block-start: 1px solid var(--line); }
  }
</style>
