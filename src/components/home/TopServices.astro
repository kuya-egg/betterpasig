---
// Popular services: a card per featured service with its category icon, title and arrow.
import SectionHead from "./SectionHead.astro";
import { href, langFromUrl, ui } from "../../i18n";
import { categories, featuredServices } from "../../lib/data";
import { arrowPath, categoryIcon, serviceLabels } from "./content";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const iconFor = (categoryId: string) => categoryIcon(categories.find((category) => category.id === categoryId)?.icon);
---

<section class="section--home bp-quick" id="serbisyo" aria-labelledby="serbisyo-h">
  <div class="wrap">
    <SectionHead id="serbisyo-h">
      {t.topTitle}
      <a slot="action" class="bp-quick__all" href={href(lang, "/serbisyo/")}>{t.allServices} <svg class="ic" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={arrowPath} /></svg></a>
    </SectionHead>
    <ul class="bp-quick__grid">
      {featuredServices.map((service) => (
        <li>
          <a class="cd bp-quick__card" href={href(lang, `/serbisyo/${service.id}/`)}>
            <span class="icon-well"><svg class="ic" aria-hidden="true" width="26" height="26" viewBox="0 0 24 24"><path d={iconFor(service.category)} /></svg></span>
            <span class="bp-quick__title">{serviceLabels[service.id]?.[lang] ?? (en ? service.title_en : service.title_fil)}</span>
            <svg class="ic ar" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d={arrowPath} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bp-quick { padding-block-start: var(--s-6); }
  .bp-quick__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 21.25rem), 1fr)); gap: var(--s-4); }
  .bp-quick__card { display: flex; align-items: center; gap: var(--s-4); min-block-size: 6.5rem; padding: var(--s-5) var(--s-5); }
  .bp-quick__title { flex: 1; min-inline-size: 0; font: 600 var(--t-card)/1.3 var(--font-text); }
</style>
