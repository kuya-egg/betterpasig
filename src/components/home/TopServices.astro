---
import { href, langFromUrl, ui } from "../../i18n";
import { featuredServices } from "../../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const labels: Record<string, { fil: string; en: string }> = {
  "pay-real-property-tax": { fil: "Magbayad ng amilyar", en: "Pay property tax" },
  "senior-citizen-id": { fil: "Kumuha ng senior ID", en: "Get a senior ID" },
  aics: { fil: "Humingi ng tulong pinansyal", en: "Get financial assistance" },
  "certified-copy-civil-document": { fil: "Kumuha ng rekord ng civil registry", en: "Get civil registry records" },
  "business-permit-renewal": { fil: "Mag-renew ng business permit", en: "Renew a business permit" },
  "scholarship-new": { fil: "Mag-apply ng scholarship", en: "Apply for a scholarship" },
};
---

<div class="bp-quick" id="serbisyo">
  <h2 id="serbisyo-h">{lang === "en" ? "Quick links" : "Diretso sa serbisyo"}</h2>
  <ul>
    {featuredServices.map((service) => (
      <li>
        <a href={href(lang, `/serbisyo/${service.id}/`)}>
          {labels[service.id]?.[lang] ?? (lang === "en" ? service.title_en : service.title_fil)}
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
  <a class="bp-quick__all" href={href(lang, "/serbisyo/")}>{t.allServices}<span aria-hidden="true"> →</span></a>
</div>

<style>
  .bp-quick { margin-top: var(--s-5); }
  .bp-quick h2 { font-size: .875rem; font-weight: 750; letter-spacing: 0; margin-bottom: var(--s-2); }
  .bp-quick ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    column-gap: var(--s-5);
  }
  .bp-quick li { border-bottom: 1px solid var(--line-strong); }
  .bp-quick li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    min-height: 3rem;
    height: 100%;
    padding-block: var(--s-2);
    font-size: .9375rem;
    font-weight: 650;
    line-height: 1.35;
  }
  .bp-quick a span { color: var(--blue); }
  .bp-quick__all {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: var(--s-2);
    color: var(--blue);
    font-size: .9375rem;
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (hover: hover) { .bp-quick li a:hover { color: var(--blue); text-decoration: underline; } }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .bp-quick li a span { transition: translate var(--fast) var(--ease); }
    .bp-quick li a:hover span { translate: 2px; }
  }
  @media (max-width: 29rem) { .bp-quick ul { column-gap: var(--s-4); } }
</style>
