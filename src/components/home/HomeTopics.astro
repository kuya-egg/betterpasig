---
// Topic index: every service category with its service count, linking to /serbisyo/#<id>.
import { href, langFromUrl } from "../../i18n";
import { categories, services } from "../../lib/data";
import { arrowPath, categoryIcon } from "./content";

const lang = langFromUrl(Astro.url);
const en = lang === "en";
const count = (id: string) => services.filter((service) => service.category === id).length;
---

<section class="section--home home-topics" aria-labelledby="top-h">
  <div class="wrap home-topics__layout">
    <div class="home-topics__intro">
      <p class="kicker">{en ? "By topic" : "Ayon sa paksa"}</p>
      <h2 id="top-h">{en ? "Every service, grouped" : "Lahat ng serbisyo, nakapangkat"}</h2>
    </div>
    <ul class="home-topics__list">
      {categories.map((category) => (
        <li>
          <a class="row home-topics__row" href={href(lang, `/serbisyo/#${category.id}`)}>
            <svg class="ic home-topics__icon" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path d={categoryIcon(category.icon)} /></svg>
            <span class="home-topics__name">{en ? category.name_en : category.name_fil}</span>
            <span class="home-topics__count"><span class="num">{count(category.id)}</span> {en ? "services" : "serbisyo"}</span>
            <svg class="ic ar" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={arrowPath} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-topics__layout { display: flex; flex-wrap: wrap; gap: var(--s-7); }
  .home-topics__intro { flex: 1 1 18.75rem; min-inline-size: 0; display: grid; gap: var(--s-3); align-content: start; }
  .home-topics__list { flex: 2 1 40rem; min-inline-size: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.75rem), 1fr)); column-gap: var(--s-6); align-content: start; }
  .home-topics__list > li { border-block-start: 1px solid var(--line); }
  .home-topics__row { padding: var(--s-4) var(--s-3); min-block-size: 4.25rem; border-radius: var(--r-sm); }
  .home-topics__icon { color: var(--blue); }
  .home-topics__name { flex: 1; min-inline-size: 0; font-weight: 600; font-size: var(--t-body); line-height: 1.35; }
  .home-topics__count { color: var(--muted); font-size: var(--t-small); }
</style>
