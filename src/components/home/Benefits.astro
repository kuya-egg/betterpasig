---
// Benefits band: featured city programs on a pale panel, each linking to /tulong/#<id>.
import { href, langFromUrl, ui } from "../../i18n";
import { programs } from "../../lib/data";
import { arrowPath } from "./content";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const featuredIds = ["local-senior-pension", "pagasa-scholarship", "solo-parent-subsidy", "pwd-cash-gift"];
const featured = featuredIds.flatMap((id) => programs.find((program) => program.id === id) ?? []);
---

<section class="section--home bp-ben" aria-labelledby="ben-h">
  <div class="wrap">
    <div class="bp-ben__panel">
      <div class="bp-ben__intro">
        <p class="kicker">{t.benefitsTitle}</p>
        <h2 id="ben-h">{en ? "There may be help " : "Baka may "}<em>{en ? "for you" : "para sa'yo"}</em></h2>
        <p class="bp-ben__lead">{en ? "City programs that many eligible residents do not know about." : "Mga programa ng lungsod na madalas hindi alam ng mga puwedeng makinabang."}</p>
        <a class="pill pill--primary" href={href(lang, "/tulong/")}>{t.benefitsAll} <svg class="ic" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={arrowPath} /></svg></a>
      </div>
      <ul class="bp-ben__grid">
        {featured.map((program) => (
          <li>
            <a class="cd bp-ben__card" href={href(lang, `/tulong/#${program.id}`)}>
              <span class="bp-ben__title">{en ? program.title_en : program.title_fil}</span>
              <span class="bp-ben__foot">
                <span class="bp-ben__benefit">{en ? program.preview_en ?? program.benefit_en : program.preview_fil ?? program.benefit_fil}</span>
                <svg class="ic ar" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d={arrowPath} /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .bp-ben__panel { display: flex; flex-wrap: wrap; gap: var(--s-7); padding: var(--s-8) var(--s-7); background: var(--pale); border-radius: var(--r-panel); }
  .bp-ben__intro { flex: 1 1 20rem; min-inline-size: 0; display: grid; gap: var(--s-3); align-content: start; justify-items: start; }
  .bp-ben__lead { font-size: var(--t-body); color: var(--muted); max-inline-size: 30ch; }
  .bp-ben__intro .pill { margin-block-start: var(--s-4); }
  .bp-ben__grid { flex: 2 1 37.5rem; min-inline-size: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: var(--s-3); align-content: start; }
  .bp-ben__grid > li { display: grid; }
  .bp-ben__card { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); }
  .bp-ben__title { font: var(--display-weight) 1.5rem/1.15 var(--font-display); letter-spacing: -.01em; }
  .bp-ben__foot { flex: 1; display: flex; justify-content: space-between; align-items: start; gap: var(--s-3); color: var(--muted); font-size: var(--t-meta); line-height: 1.45; }
  .bp-ben__foot .ar { align-self: end; }
  @media (max-width: 40rem) {
    .bp-ben__panel { padding: var(--s-6) var(--s-5); }
    .bp-ben__grid { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
  }
</style>
