---
// photo-chapters (dealt moment): places to visit, one photograph each, the chapter on a panel at its foot.
import { Picture } from "astro:assets";
import Verify from "../Verify.astro";
import { langFromUrl, ui } from "../../i18n";
import { pasyalan } from "../../lib/data";
import { photo, photoAlt } from "../../lib/photos";

interface Props {
  /** pasyalan ids, in order, each with a photo */
  ids: string[];
}

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const chapters = Astro.props.ids.map((id) => {
  const place = pasyalan.find((item) => item.id === id);
  if (!place?.photo_id) throw new Error(`Pasyalan chapter "${id}" needs a place with a photo`);
  return { place, picture: photo(place.photo_id) };
});
---

<section class="section" id="pasyalan" data-moment="photo-chapters" aria-labelledby="pasyalan-h">
  <div class="wrap mo-ph">
    <div class="mo-ph__head">
      <h2 id="pasyalan-h">{t.pasyalanTitle}</h2>
      <p>{t.pasyalanLead}</p>
    </div>
    <ol class="mo-ph__list">
      {
        chapters.map(({ place, picture }) => {
          const hours = en ? place.hours_en : place.hours_fil;
          const fee = en ? place.fee_en : place.fee_fil;
          return (
            <li class="mo-ph__ch">
              <figure class="mo-ph__pic">
                <Picture
                  src={picture.image}
                  alt={photoAlt(picture, lang)}
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  widths={[640, 960, 1280]}
                  sizes="100vw"
                  width={1280}
                  quality={55}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <h3>{place.name}</h3>
              <p>
                {place.kind === "bago" && <span class="bp-new">{t.pasyalanNew}</span>}
                {place.verify && <Verify />}
                {en ? place.line_en : place.line_fil}
                {(hours || fee) && <span class="bp-ch-fact">{[hours, fee].filter(Boolean).join(". ")}.</span>}
              </p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .bp-new {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 var(--s-2);
    margin-right: var(--s-2);
    border-radius: 999px;
    background: var(--pale);
    color: var(--accent);
    font: 500 var(--t-label) var(--font-text);
    vertical-align: middle;
  }
  .mo-ph__ch p :global(.verify) {
    margin: 0 var(--s-2) 0 0;
  }
  .bp-ch-fact {
    display: block;
    margin-top: var(--s-2);
    color: var(--muted);
    font-size: var(--t-small);
  }
</style>
