---
// Places to visit: one large card and three compact ones from data/pasyalan.json, with their photos.
// A card opens the place page at /lugar/<id>/ when one exists, else the place's card on /pasyalan/.
import { Picture } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import Verify from "../Verify.astro";
import { formatDate, href, langFromUrl, ui } from "../../i18n";
import { barangays, pasyalan, pasyalanRetrieved, places } from "../../lib/data";
import { photo, photoAlt } from "../../lib/photos";
import { arrowPath } from "./content";

interface Props { ids: string[] }

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const kindLabel: Record<string, { fil: string; en: string }> = {
  pasyalan: { fil: "Pasyalan", en: "Place to visit" },
  kainan: { fil: "Kainan", en: "Food" },
  bago: { fil: "Bago", en: "New" },
};
const cards = Astro.props.ids.map((id) => {
  const place = pasyalan.find((item) => item.id === id);
  if (!place?.photo_id) throw new Error(`Pasyalan needs a photo for ${id}`);
  const target = places.some((item) => item.id === place.id) ? href(lang, `/lugar/${place.id}/`) : href(lang, `/pasyalan/#pasyalan-${place.id}`);
  const barangay = barangays.find((item) => item.id === place.barangay_id);
  const hasTimes = Boolean(place.hours_fil || place.fee_fil);
  return { place, target, barangay, hasTimes, picture: photo(place.photo_id) };
});
const [lead, ...rest] = cards;
---

<section class="section--home bp-places" id="pasyalan" aria-labelledby="pl-h">
  <div class="wrap">
    <SectionHead id="pl-h">
      {t.pasyalanTitle}
      <a slot="action" href={href(lang, "/pasyalan/")}>{en ? "All places" : "Lahat ng pasyalan"} <svg class="ic" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={arrowPath} /></svg></a>
    </SectionHead>
    <div class="bp-places__layout">
      {lead && (
        <a class="cd bp-places__lead" href={lead.target}>
          <span class="bp-places__photo">
            <Picture src={lead.picture.image} alt={photoAlt(lead.picture, lang)} formats={["avif", "webp"]} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="(max-width: 1023px) 92vw, 640px" width={960} quality={55} loading="lazy" decoding="async" />
          </span>
          <span class="bp-places__body">
            <span class="kicker">{kindLabel[lead.place.kind]?.[lang] ?? ""}{lead.barangay && <span class="bp-places__brgy">{lead.barangay.name}</span>}</span>
            <h3 id={`pasyalan-${lead.place.id}`}>{lead.place.name}{lead.place.verify && <Verify />}</h3>
            <span class="bp-places__line">{en ? lead.place.line_en : lead.place.line_fil}</span>
            {lead.hasTimes && <span class="bp-places__line muted">{en ? "Hours and fee" : "Oras at bayad"}: {en ? "checked" : "sinuri noong"} {formatDate(lang, pasyalanRetrieved)}</span>}
          </span>
        </a>
      )}
      <ul class="bp-places__side">
        {rest.map(({ place, target, barangay, picture }) => (
          <li>
            <a class="cd bp-places__small" href={target}>
              <span class="bp-places__thumb">
                <Picture src={picture.image} alt={photoAlt(picture, lang)} formats={["avif", "webp"]} fallbackFormat="webp" widths={[224, 336]} sizes="112px" width={224} quality={55} loading="lazy" decoding="async" />
              </span>
              <span class="bp-places__small-body">
                <span class="kicker">{kindLabel[place.kind]?.[lang] ?? ""}</span>
                <h3 id={`pasyalan-${place.id}`}>{place.name}{place.verify && <Verify />}</h3>
                {barangay && <span class="muted bp-places__where">{barangay.name}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .bp-places__layout { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: stretch; }
  .bp-places__lead { flex: 2 1 35rem; min-inline-size: 0; display: flex; flex-direction: column; overflow: hidden; }
  .bp-places__photo { display: block; block-size: 23.75rem; background: var(--pale); }
  .bp-places__photo :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .bp-places__body { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-5) var(--s-6); }
  .bp-places__body .kicker { display: flex; flex-wrap: wrap; gap: 0 var(--s-4); }
  .bp-places__brgy { color: var(--muted); }
  .bp-places__body h3 { font-size: 2.25rem; line-height: 1.1; }
  .bp-places__line { font-size: var(--t-meta); line-height: 1.5; }
  .bp-places__side { flex: 1 1 21.25rem; min-inline-size: 0; display: flex; flex-direction: column; gap: var(--s-4); }
  .bp-places__side > li { flex: 1; display: grid; }
  .bp-places__small { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-3); }
  .bp-places__thumb { flex: none; inline-size: 7rem; block-size: 7rem; border-radius: var(--r-md); overflow: hidden; background: var(--pale); }
  .bp-places__thumb :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .bp-places__small-body { display: flex; flex-direction: column; gap: var(--s-1); min-inline-size: 0; }
  .bp-places__small-body h3 { font-size: 1.5rem; line-height: 1.15; }
  .bp-places__where { font-size: var(--t-meta); }
  @media (max-width: 40rem) { .bp-places__photo { block-size: 15rem; } .bp-places__body { padding: var(--s-5); } .bp-places__body h3 { font-size: 1.75rem; } }
</style>
