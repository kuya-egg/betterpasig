---
import { Picture } from "astro:assets";
import Verify from "../Verify.astro";
import { formatDate, href, langFromUrl, ui } from "../../i18n";
import { barangays, pasyalan, pasyalanRetrieved } from "../../lib/data";
import { photo, photoAlt } from "../../lib/photos";

interface Props { ids: string[] }

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const chapters = Astro.props.ids.map((id) => {
  const place = pasyalan.find((item) => item.id === id);
  if (!place?.photo_id) throw new Error(`Pasyalan needs a photo for ${id}`);
  return { place, picture: photo(place.photo_id), barangay: barangays.find((item) => item.id === place.barangay_id) };
});
---

<section class="section bp-discover" id="pasyalan" data-pagefind-body data-pagefind-meta="kind:pasyalan" aria-labelledby="pasyalan-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="pasyalan-h">{t.pasyalanTitle}</h2>
      <p>{t.pasyalanLead}</p>
    </div>
    <ul class="bp-discover__places">
      {
        chapters.map(({ place, picture, barangay }, index) => {
          const hours = en ? place.hours_en : place.hours_fil;
          const fee = en ? place.fee_en : place.fee_fil;
          return (
            <li>
              <article class="bp-discover__place">
                <div class="bp-discover__photo" data-visit-photo>
                  <Picture
                    src={picture.image}
                    alt={photoAlt(picture, lang)}
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={[400, 640, 800]}
                    sizes={`(max-width: 767px) 90vw, ${index === 0 || index === 3 ? 53 : 35}vw`}
                    width={640}
                    quality={49}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="bp-discover__body">
                  {barangay && <a class="bp-discover__barangay" href={href(lang, `/barangay/${barangay.id}/`)}>{barangay.name}</a>}
                  <h3 id={`pasyalan-${place.id}`}>{place.name}</h3>
                  {place.verify && <Verify />}
                  <p>{en ? place.line_en : place.line_fil}</p>
                  {(place.address || hours || fee) && (
                    <dl>
                      {place.address && <div><dt>{t.address}</dt><dd>{place.address}</dd></div>}
                      {hours && <div><dt>{t.hours}</dt><dd>{hours}</dd></div>}
                      {fee && <div><dt>{t.colFee}</dt><dd>{fee}</dd></div>}
                    </dl>
                  )}
                  <p class="bp-discover__sources">
                    {place.sources.map((url, index) => (
                      <a href={url}>{place.sources.length === 1 ? t.sourceWord : `${t.sourceWord} ${index + 1}`}</a>
                    ))}
                    <span>{t.checked} {formatDate(lang, pasyalanRetrieved)}</span>
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window && "animate" in Element.prototype) {
    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting) continue;
        observer.unobserve(target);
        target.animate([
          { opacity: .7, transform: "translateY(10px)" },
          { opacity: 1, transform: "translateY(0)" },
        ], { duration: 540, easing: "cubic-bezier(.22,.8,.24,1)" });
      }
    }, { threshold: .2 });
    for (const photo of document.querySelectorAll("[data-visit-photo]")) observer.observe(photo);
  }
</script>

<style>
  .bp-discover { background: var(--surface); }
  .bp-discover .section-head { margin-bottom: var(--s-7); }
  .bp-discover__places {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }
  .bp-discover__places > li {
    grid-column: span 5;
    border-radius: calc(var(--r-lg) + .5rem);
    padding: .5rem;
    background: var(--paper);
  }
  .bp-discover__places > li:is(:first-child, :last-child) { grid-column: span 7; }
  .bp-discover__places > li:nth-child(2) { margin-block-start: var(--s-7); }
  .bp-discover__place { background: var(--bg); border-radius: var(--r-lg); }
  .bp-discover__photo { aspect-ratio: 16 / 9; background: var(--surface); border-radius: var(--r-lg) var(--r-lg) 0 0; overflow: hidden; }
  .bp-discover__places > li:nth-child(2) .bp-discover__photo { aspect-ratio: 5 / 4; }
  .bp-discover__photo :global(picture) { display: block; height: 100%; }
  .bp-discover__body h3 { font-size: clamp(1.65rem, 1.35rem + 1.2vw, 2.55rem); }
  .bp-discover__photo :global(img) { width: 100%; height: 100%; object-fit: cover; outline: 1px solid rgb(0 0 0 / .1); outline-offset: -1px; }
  .bp-discover__body { display: grid; justify-items: start; gap: var(--s-2); padding: var(--s-5); }
  .bp-discover__body > p { color: var(--muted); }
  .bp-discover__body dl { width: 100%; margin: var(--s-2) 0 0; font-size: .9375rem; }
  .bp-discover__body dl > div { border-top: 1px solid var(--line); padding-block: var(--s-2); display: grid; grid-template-columns: minmax(5rem, 1fr) 3fr; gap: var(--s-2); }
  .bp-discover__body dt { font-weight: 700; }
  .bp-discover__body dd { margin: 0; }
  .bp-discover__sources, .bp-discover__barangay { font-size: .875rem; }
  .bp-discover__sources { display: flex; flex-wrap: wrap; gap: 0 var(--s-3); align-items: center; }
  .bp-discover__body a { display: inline-flex; align-items: center; min-height: 3rem; color: var(--blue); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 47.9375rem) {
    .bp-discover__places { grid-template-columns: minmax(0, 1fr); }
    .bp-discover__places > li, .bp-discover__places > li:is(:first-child, :last-child) { grid-column: 1; margin-block-start: 0; }
    .bp-discover__places > li:nth-child(2) .bp-discover__photo { aspect-ratio: 16 / 9; }
  }
</style>
