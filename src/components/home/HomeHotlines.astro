---
// Emergency hotlines from data/hotlines.json: tap to call (tel:) or text (sms:), with the date they were checked.
import { formatDate, href, langFromUrl, ui } from "../../i18n";
import { emergencyHotlines, hotlinesRetrieved, telHref } from "../../lib/data";
import { arrowPath, messagePath, phonePath } from "./content";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const isSms = (label: string) => /\bSMS\b/i.test(label);
const smsHref = (number: string) => `sms:${number.replace(/[^\d+]/g, "")}`;
---

<section class="section--home bp-hot" id="emergency" aria-labelledby="hot-h">
  <div class="wrap bp-hot__layout">
    <div class="bp-hot__intro">
      <p class="kicker bp-hot__kicker">Emergency</p>
      <h2 id="hot-h">{t.hotlinesTitle}</h2>
      <p class="muted">{t.hotlinesChecked.replace("{date}", formatDate(lang, hotlinesRetrieved))}</p>
      <a class="bp-hot__all" href={href(lang, "/emergency/")}>{t.allHotlines} <svg class="ic" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={arrowPath} /></svg></a>
    </div>
    <ul class="bp-hot__grid">
      {emergencyHotlines.map((hotline) => {
        const label = en ? hotline.label_en : hotline.label_fil;
        const number = hotline.numbers[0];
        const sms = isSms(label);
        return (
          <li>
            <a class="cd bp-hot__card" href={sms ? smsHref(number) : telHref(number)}>
              <span class="bp-hot__text">
                <span class="bp-hot__label">{label}</span>
                <span class="bp-hot__number num">{number}</span>
              </span>
              <span class="bp-hot__call" aria-hidden="true"><svg class="ic" width="22" height="22" viewBox="0 0 24 24"><path d={sms ? messagePath : phonePath} /></svg></span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .bp-hot__layout { display: flex; flex-wrap: wrap; gap: var(--s-7); align-items: flex-start; }
  .bp-hot__intro { flex: 1 1 18.75rem; min-inline-size: 0; display: grid; gap: var(--s-3); justify-items: start; }
  .bp-hot__kicker { color: var(--red); }
  .bp-hot__all { display: inline-flex; align-items: center; gap: var(--s-2); min-block-size: 2.75rem; color: var(--blue); font-weight: 600; }
  .bp-hot__all:hover { text-decoration: underline; text-underline-offset: .23em; }
  .bp-hot__grid { flex: 2 1 40rem; min-inline-size: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr)); gap: var(--s-3); }
  .bp-hot__grid > li { display: grid; }
  .bp-hot__card { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding: var(--s-5); }
  .bp-hot__text { display: flex; flex-direction: column; min-inline-size: 0; }
  .bp-hot__label { color: var(--muted); font-size: var(--t-small); font-weight: 600; }
  .bp-hot__number { font: 600 1.75rem/1.3 var(--font-text); letter-spacing: -.01em; }
  .bp-hot__call { display: inline-grid; place-items: center; flex: none; inline-size: 3rem; block-size: 3rem; border-radius: 50%; background: var(--red); color: #fff; }
</style>
