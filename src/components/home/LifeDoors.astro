---
// Life situations: a ruled grid of rows, each linking to its checklist at /buhay/<id>/.
import SectionHead from "./SectionHead.astro";
import LifeIcon from "./LifeIcon.astro";
import { href, langFromUrl, ui } from "../../i18n";
import { lifeEvents } from "../../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
---

<section class="section--home ground-white" id="buhay" aria-labelledby="buhay-h">
  <div class="wrap">
    <SectionHead id="buhay-h" kicker={en ? "By situation" : "Ayon sa sitwasyon"}>
      {t.doorsTitle}
      <Fragment slot="lead">{t.doorsLead}</Fragment>
    </SectionHead>
    <ul class="bp-doors">
      {
        lifeEvents.map((event) => (
          <li>
            <a class="row bp-door" href={href(lang, `/buhay/${event.id}/`)}>
              <LifeIcon id={event.id} />
              <h3>{en ? event.title_en : event.title_fil}</h3>
              <p>{en ? event.line_en : event.line_fil}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ground-white { border-block: 1px solid var(--line); }
  .bp-doors { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.25rem), 1fr)); border-block-start: 1px solid var(--line); border-inline-start: 1px solid var(--line); }
  .bp-doors > li { display: grid; border-inline-end: 1px solid var(--line); border-block-end: 1px solid var(--line); }
  .bp-door { flex-direction: column; align-items: flex-start; gap: var(--s-3); padding: var(--s-5) var(--s-5); min-block-size: 12.25rem; }
  .bp-door h3 { font-size: 1.6875rem; line-height: 1.1; }
  .bp-door p { color: var(--muted); font-size: var(--t-meta); line-height: 1.45; }
</style>
