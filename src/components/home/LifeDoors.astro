---
// Life-event guides link directly to their checklists.
import { href, langFromUrl, ui } from "../../i18n";
import { lifeEvents } from "../../lib/data";
import LifeIcon from "./LifeIcon.astro";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<section class="section ground-surface" id="buhay" aria-labelledby="buhay-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="buhay-h">{t.doorsTitle}</h2>
      <p>{t.doorsLead}</p>
    </div>
    <ul class="bp-doors">
      {
        lifeEvents.map((event) => (
          <li>
            <a class="bp-door" href={href(lang, `/buhay/${event.id}/`)}>
              <LifeIcon id={event.id} />
              <h3>{lang === "en" ? event.title_en : event.title_fil}</h3>
              <p class="bp-door__line">{lang === "en" ? event.line_en : event.line_fil}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bp-doors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(1.25rem, 4vw, 3rem);
  }
  .bp-doors > li { border-block-start: 1px solid var(--line); }
  .bp-door {
    block-size: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    column-gap: var(--s-4);
    row-gap: var(--s-1);
    padding-block: var(--s-4);
  }
  .bp-door :global(.bp-life-icon) { grid-row: 1 / span 2; }
  .bp-door h3 {
    color: var(--blue);
    font: 800 var(--t-card)/1.3 var(--font-text);
    letter-spacing: -.02em;
    text-underline-offset: .23em;
  }
  .bp-door__line { font-size: .9375rem; line-height: 1.5; color: var(--muted); }
  @media (hover: hover) { .bp-door:hover h3 { text-decoration: underline; } }
  @media (max-width: 57.9375rem) { .bp-doors { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 35.9375rem) { .bp-doors { grid-template-columns: minmax(0, 1fr); } }
</style>
