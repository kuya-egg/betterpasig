---
// Places that opened recently (pasyalan kind "bago" not already shown in the chapters), newest first,
// beside the 30-barangay map with each place's barangay numbered to match the list.
import map from "../../../design/map/pasig-map.json";
import Verify from "../Verify.astro";
import { formatDate, href, langFromUrl, ui } from "../../i18n";
import { barangays, pasyalan } from "../../lib/data";

interface Props {
  /** ids already shown elsewhere on the page */
  skip: string[];
}

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const en = lang === "en";
const rows = pasyalan
  .filter((place) => place.kind === "bago" && place.opened && !Astro.props.skip.includes(place.id))
  .sort((a, b) => (b.opened ?? "").localeCompare(a.opened ?? ""));
const barangayName = (id: string | null) => barangays.find((item) => item.id === id)?.name;
const openedDate = (value: string) => (value.length === 7 ? formatDate(lang, `${value}-01`).replace(/^\S+ \d+, /, "") : formatDate(lang, value));
// list number of the place in each barangay shape (a place with no barangay gets no marker)
const markerFor = (shapeName: string) => {
  const index = rows.findIndex((place) => barangayName(place.barangay_id) === shapeName);
  return index < 0 ? null : index + 1;
};
---

<section class="section" id="bago" aria-labelledby="bago-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="bago-h">{t.newTitle}</h2>
      <p>{t.newLead}</p>
    </div>
    <div class="grid grid--top">
      <ol class="span-6 bp-new-list">
        {
          rows.map((place, index) => {
            const barangay = barangayName(place.barangay_id);
            return (
              <li class="bp-new-item">
                <span class="bp-new-item__n" aria-hidden="true">{index + 1}</span>
                <div>
                  <h3>
                    {place.name}
                    {place.verify && <Verify />}
                  </h3>
                  <p>{en ? place.line_en : place.line_fil}</p>
                  <p class="t-small muted bp-new-item__meta">
                    <span class="bp-new-item__date">{t.openedOn} {openedDate(place.opened!)}</span>
                    {barangay && place.barangay_id && <a href={href(lang, `/barangay/${place.barangay_id}/`)}>Brgy. {barangay}</a>}
                    <a href={place.sources[0]}>{t.sourceWord}</a>
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
      <div class="span-6 start-7 bp-new-map">
        <svg viewBox="100 0 360 560" role="img" aria-label={t.newMapLabel}>
          {map.barangays.map((shape) => <path d={shape.d} class={markerFor(shape.name) ? "on" : undefined} />)}
          {
            map.barangays.map((shape) => {
              const n = markerFor(shape.name);
              return (
                n && (
                  <g transform={`translate(${shape.x} ${shape.y})`}>
                    <circle r="11" />
                    <text text-anchor="middle" dy="4.5">{n}</text>
                  </g>
                )
              );
            })
          }
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .bp-new-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bp-new-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-new-item > div {
    display: grid;
    gap: var(--s-1);
  }
  .bp-new-item__n {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font: 500 var(--t-small) / 1 var(--font-text);
    font-variant-numeric: tabular-nums;
  }
  .bp-new-item h3 {
    margin: 0;
    font-size: var(--t-card);
    font-weight: 500;
  }
  .bp-new-item p {
    margin: 0;
    max-width: 56ch;
  }
  .bp-new-item__date {
    color: var(--accent);
  }
  .bp-new-item a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-new-item a:hover {
    text-decoration-color: currentColor;
  }
  .bp-new-item__meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-4);
  }
  .bp-new-map {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .bp-new-map svg {
    width: auto;
    height: min(560px, calc(100svh - var(--padt) - var(--padb) - 180px));
    max-width: 100%;
  }
  .bp-new-map path {
    fill: var(--subtle);
    stroke: var(--bg);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .bp-new-map path.on {
    fill: var(--hover);
  }
  .bp-new-map circle {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .bp-new-map text {
    fill: var(--accent-ink);
    font: 600 13px var(--font-text);
  }
  @media (pointer: coarse) {
    .bp-new-item a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  @media (max-width: 1023px) {
    .bp-new-list,
    .bp-new-map {
      grid-column: 1 / -1;
    }
    .bp-new-map svg {
      height: auto;
      width: min(100%, 360px);
    }
  }
</style>
