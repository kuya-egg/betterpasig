---
// "Bago sa Pasig": places that opened with a recorded date, newest first.
import { formatDate, href, langFromUrl, ui } from "../../i18n";
import { pasyalan, places } from "../../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const rows = pasyalan
  .filter((place) => place.kind === "bago" && place.opened)
  .sort((a, b) => (b.opened ?? "").localeCompare(a.opened ?? ""));
const target = (id: string) => (places.some((place) => place.id === id) ? href(lang, `/lugar/${id}/`) : href(lang, `/pasyalan/#pasyalan-${id}`));
---

{rows.length > 0 && (
  <section class="section--home bp-new" id="bago" aria-labelledby="bago-h">
    <div class="wrap">
      <div class="bp-new__bar">
        <h3 id="bago-h">{t.newTitle}</h3>
        <ul class="bp-new__list">
          {rows.map((place) => (
            <li>
              <a class="bp-new__name" href={target(place.id)}>{place.name}</a>
              <span class="bp-new__date muted">{t.openedOn} {formatDate(lang, place.opened!)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .bp-new { padding-block-start: var(--s-7); }
  .bp-new__bar { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); align-items: baseline; padding-block: var(--s-5); border-block: 1px solid var(--line); }
  .bp-new__bar h3 { font-size: 1.625rem; }
  .bp-new__list { flex: 1; min-inline-size: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); font-size: var(--t-meta); }
  .bp-new__list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-2); }
  .bp-new__name { display: inline-flex; align-items: center; min-block-size: 2.75rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .bp-new__name:hover { color: var(--blue); text-decoration-color: currentColor; }
</style>
