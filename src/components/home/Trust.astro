---
import { href, langFromUrl, ui } from "../../i18n";
const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<section class="section bp-trust" id="pinagmulan" aria-labelledby="pinagmulan-h">
  <div class="wrap bp-trust__content">
    <div>
      <h2 id="pinagmulan-h">{t.trustTitle}</h2>
      <p>{t.trustBefore} <strong>{t.trustStrong}</strong>{t.trustAfter}</p>
    </div>
    <div class="bp-trust__links">
      <a href={href(lang, "/tungkol/")}>{t.aboutTitle} <span aria-hidden="true">→</span></a>
      <a href="https://github.com/kuya-egg/betterpasig/issues/new">{t.aboutReport} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .bp-trust { background: var(--pale); }
  .bp-trust .bp-trust__content { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: center; gap: var(--s-5); }
  .bp-trust p { margin-top: var(--s-3); max-width: 62ch; }
  .bp-trust__links { display: grid; gap: var(--s-2); }
  .bp-trust__links a { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; gap: var(--s-3); font-weight: 650; color: var(--blue); border-bottom: 1px solid var(--line-strong); }
  @media (max-width: 39.9375rem) { .bp-trust .bp-trust__content { grid-template-columns: minmax(0, 1fr); } }
</style>
