---
import Verify from "./Verify.astro";
import { cityHallHotline, mapsHref, site, telHref } from "../lib/data";
import { formatDate, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const hall = site.city_hall;
const trunk = cityHallHotline?.numbers[0];
---

<footer class="mt-0 border-t border-line bg-subtle">
  <div class="wrap flex flex-wrap gap-x-16 gap-y-8 py-10 text-[15px] text-muted">
    <div class="grid max-w-[60ch] min-w-[16rem] flex-1 gap-2">
      <strong class="text-ink">BetterPasig</strong>
      <p>{lang === "en" ? site.notice_en : site.notice_fil}</p>
      <p>
        {t.partOf} <a href="https://bettergov.ph">BetterGov.ph</a>. {t.dataUpdated}:{" "}
        <span class="num">{formatDate(lang, site.updated)}</span>.
      </p>
    </div>
    <div class="grid max-w-[36ch] content-start gap-1.5">
      <strong class="text-ink">{hall.name}</strong>
      <p>
        {hall.address}
        {hall.verify && <Verify />}
      </p>
      <a href={mapsHref(`${hall.name}, ${hall.address}`)}>{t.openMaps}</a>
      {
        trunk && (
          <p>
            <a class="num font-semibold text-ink" href={telHref(trunk)}>
              {trunk}
            </a>
            {cityHallHotline?.verify && <Verify />}
          </p>
        )
      }
    </div>
  </div>
</footer>
