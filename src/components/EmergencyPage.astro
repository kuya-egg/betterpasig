---
import Kit from "../layouts/Kit.astro";
import CopyButton from "./CopyButton.astro";
import Verify from "./Verify.astro";
import {
  emergencyHotlines,
  otherHotlines,
  hotlinesRetrieved,
  hotlineConflicts,
  facilities,
  telHref,
  mapsHref,
  sourceLabel,
} from "../lib/data";
import { evacuationCenters } from "../lib/evacuation";
import { formatDate, href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];

const groups: { title: string; items: typeof otherHotlines }[] = [
  { title: t.emergencyGroupMain, items: emergencyHotlines },
  { title: t.groupPoliceFire, items: otherHotlines.filter((h) => ["police", "fire"].includes(h.kind)) },
  { title: t.groupMedical, items: otherHotlines.filter((h) => h.kind === "medical") },
  {
    title: t.groupOther,
    items: otherHotlines.filter((h) => ["emergency", "rescue", "traffic", "city-hall"].includes(h.kind)),
  },
].filter((g) => g.items.length > 0);

// "(02) 8643-3333; 8988-1000 / 8988-7000 (ER locals 2222)" -> [{ number, rest }]
const parseContact = (contact: string) =>
  contact
    .split(/[;/]/)
    .map((part) => part.trim())
    .filter(Boolean)
    .map((part) => {
      const m = part.match(/^([\d()+\s-]*\d)\s*(.*)$/);
      return m ? { number: m[1].trim(), rest: m[2] } : { number: null, rest: part };
    });

const byBarangay = new Map<string, { name: string; id?: string; centers: typeof evacuationCenters }>();
for (const c of evacuationCenters) {
  const entry = byBarangay.get(c.barangay) ?? { name: c.barangay, id: c.barangayId, centers: [] };
  entry.centers.push(c);
  byBarangay.set(c.barangay, entry);
}
const evacGroups = [...byBarangay.values()].sort((a, b) => a.name.localeCompare(b.name));

const hospitalType = (type: string) =>
  type === "public" ? t.hospitalPublic : type === "private" ? t.hospitalPrivate : type;

const jump = [
  ["hotlines", t.allHotlines],
  ["conflicts", t.conflictsTitle],
  ["ospital", t.hospitalsTitle],
  ["evacuation", t.evacTitle],
  ["baha", t.floodTitle],
];
const retrieved = formatDate(lang, facilities.retrieved);
---

<Kit title={t.emergencyPageTitle} description={t.emergencyLead}>
  <section class="section section--flow bp-em" aria-labelledby="emergency-page-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="emergency-page-h">{t.emergencyPageTitle}</h1>
        <p>{t.emergencyLead}</p>
      </div>
      <nav aria-label={t.emergencyJump}>
        <ul class="bp-em__jump">
          {jump.map(([id, label]) => <li><a class="link" href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  <section id="hotlines" class="section section--flow ground-surface bp-em" aria-labelledby="hotlines-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="hotlines-h">{t.allHotlines}</h2>
        <p>{t.tapToCall}</p>
      </div>
      {
        groups.map((g, gi) => (
          <div class="bp-em__group">
            <h3 class:list={["t-label", gi === 0 ? "bp-em__emergency" : "muted"]}>{g.title}</h3>
            <ul class:list={["grid", "bp-hotlines", gi === 0 && "bp-hotlines--main"]}>
              {g.items.map((h) => (
                <li class="span-6">
                  <div class="bp-hotline">
                    <p class="t-small muted">
                      {lang === "en" ? h.label_en : h.label_fil}
                      {h.verify && <Verify />}
                    </p>
                    <ul class="bp-hotline__nums">
                      {h.numbers.map((n) => (
                        <li>
                          <a class="bp-hotline__number" href={telHref(n)}>{n}</a>
                          <CopyButton value={n} label={t.copyNumber(n)} />
                        </li>
                      ))}
                    </ul>
                    <p class="t-small muted">
                      {t.sources}:{" "}
                      {h.sources.map((s, i) => (
                        <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                      ))}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="t-small muted bp-em__checked">{t.checked}: {formatDate(lang, hotlinesRetrieved)}</p>
    </div>
  </section>

  <section id="conflicts" class="section section--flow bp-em" aria-labelledby="conflicts-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="conflicts-h">{t.conflictsTitle}</h2>
        <p>{t.conflictsIntro}</p>
      </div>
      <ul class="bp-em__list">
        {
          hotlineConflicts.map((c) => (
            <li>
              <p>{lang === "en" ? c.text_en : c.text_fil}<Verify /></p>
            </li>
          ))
        }
      </ul>
      <p class="t-small muted bp-em__checked">{t.checked}: {formatDate(lang, hotlinesRetrieved)}</p>
    </div>
  </section>

  <section id="ospital" class="section section--flow ground-surface bp-em" aria-labelledby="ospital-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ospital-h">{t.hospitalsTitle}</h2>
      </div>
      <ul class="bp-em__list">
        {
          facilities.hospitals.map((h) => (
            <li class="bp-em__item">
              <h3 class="bp-em__name">
                {h.name}
                {h.verify && <Verify />}
              </h3>
              <p class="t-small muted">{hospitalType(h.type)}</p>
              {h.address && (
                <p class="bp-em__addr">
                  {h.address}
                  <a class="link" href={mapsHref(`${h.name}, ${h.address}`)}>{t.openMaps}</a>
                </p>
              )}
              {h.contact ? (
                <ul class="bp-em__contacts">
                  {parseContact(h.contact).map((c) => (
                    <li>
                      {c.number ? (
                        <>
                          <a class="bp-em__tel" href={telHref(c.number)}>{c.number}</a>
                          <CopyButton value={c.number} label={t.copyNumber(c.number)} />
                          {c.rest && <span class="t-small muted">{c.rest}</span>}
                        </>
                      ) : (
                        <span class="t-small muted">{c.rest}</span>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="t-small muted">{t.noContactListed}</p>
              )}
              <p class="t-small muted">
                {t.sources}:{" "}
                {h.sources.map((s, i) => (
                  <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="t-small muted bp-em__checked">{t.checked}: {retrieved}</p>
    </div>
  </section>

  <section id="evacuation" class="section section--flow bp-em" aria-labelledby="evacuation-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="evacuation-h">{t.evacTitle}</h2>
        <p><strong>{t.evacCaveat}</strong> {lang === "en" ? facilities.notes_en : facilities.notes_fil}</p>
      </div>
      {
        evacGroups.map((g) => (
          <div class="bp-em__group">
            <h3 class="bp-em__name">
              {g.id ? <a class="bp-em__link" href={href(lang, `/barangay/${g.id}/`)}>{g.name}</a> : g.name}
            </h3>
            <ul class="bp-em__list">
              {g.centers.map((c) => (
                <li class="bp-em__item">
                  <p>
                    {c.name}
                    {c.verify && <Verify />}
                  </p>
                  <p class="t-small muted">{c.address ?? t.evacNoAddress}</p>
                  <p class="t-small muted">
                    {t.sources}:{" "}
                    {c.sources.map((s, i) => (
                      <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                    ))}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="t-small muted bp-em__checked">{t.checked}: {retrieved}</p>
    </div>
  </section>

  <section id="baha" class="section section--flow ground-surface bp-em" aria-labelledby="baha-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="baha-h">{t.floodTitle}</h2>
      </div>
      <ul class="bp-em__list">
        {
          facilities.flood_prone_notes.map((n) => (
            <li class="bp-em__item">
              <p>{lang === "en" ? n.text_en : n.text_fil}</p>
              <p class="t-small muted">
                {t.sources}:{" "}
                {n.sources.map((s, i) => (
                  <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="t-small muted bp-em__checked">{t.checked}: {retrieved}</p>
    </div>
  </section>
</Kit>

<style>
  .bp-em section,
  section.bp-em {
    scroll-margin-top: var(--s-8);
  }
  .bp-em__jump {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }
  .bp-em__jump a,
  .bp-em__src,
  .bp-em__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .bp-em__src {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-em__link {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .bp-em__group {
    margin-top: var(--s-7);
  }
  .bp-em__group > h3 {
    margin: 0;
  }
  .bp-em__emergency {
    color: var(--red);
  }
  .bp-hotlines {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    row-gap: 0;
  }
  .bp-hotline {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-hotlines--main .bp-hotline {
    border-top-color: var(--red);
  }
  .bp-hotline p,
  .bp-em__list p {
    margin: 0;
  }
  .bp-hotline__nums,
  .bp-em__contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-4);
  }
  .bp-hotline__nums li,
  .bp-em__contacts li {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .bp-hotline__number,
  .bp-em__tel {
    font: var(--display-weight) var(--t-card) / 1.2 var(--font-display);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
  }
  .bp-hotlines--main .bp-hotline__number {
    font-size: clamp(26px, 2.2vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .bp-em__list {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    max-width: 70ch;
  }
  .bp-em__item,
  .bp-em__list > li {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-em__name {
    font-size: var(--t-card);
    font-weight: 500;
  }
  .bp-em__addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-4);
  }
  .bp-em__addr a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .bp-em__checked {
    margin-top: var(--s-5);
  }
  @media (max-width: 1023px) {
    .bp-hotlines > li {
      grid-column: 1 / -1;
    }
  }
</style>
