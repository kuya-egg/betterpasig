---
import Base from "../layouts/Base.astro";
import CopyButton from "./CopyButton.astro";
import Verify from "./Verify.astro";
import {
  emergencyHotlines,
  otherHotlines,
  hotlinesRetrieved,
  hotlineConflicts,
  facilities,
  telHref,
  mapsHref,
  sourceLabel,
} from "../lib/data";
import { evacuationCenters } from "../lib/evacuation";
import { formatDate, href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];

const groups: { title: string; items: typeof otherHotlines }[] = [
  { title: t.emergencyGroupMain, items: emergencyHotlines },
  { title: t.groupPoliceFire, items: otherHotlines.filter((h) => ["police", "fire"].includes(h.kind)) },
  { title: t.groupMedical, items: otherHotlines.filter((h) => h.kind === "medical") },
  {
    title: t.groupOther,
    items: otherHotlines.filter((h) => ["emergency", "rescue", "traffic", "city-hall"].includes(h.kind)),
  },
].filter((g) => g.items.length > 0);

// "(02) 8643-3333; 8988-1000 / 8988-7000 (ER locals 2222)" -> [{ number, rest }]
const parseContact = (contact: string) =>
  contact
    .split(/[;/]/)
    .map((part) => part.trim())
    .filter(Boolean)
    .map((part) => {
      const m = part.match(/^([\d()+\s-]*\d)\s*(.*)$/);
      return m ? { number: m[1].trim(), rest: m[2] } : { number: null, rest: part };
    });

const byBarangay = new Map<string, { name: string; id?: string; centers: typeof evacuationCenters }>();
for (const c of evacuationCenters) {
  const entry = byBarangay.get(c.barangay) ?? { name: c.barangay, id: c.barangayId, centers: [] };
  entry.centers.push(c);
  byBarangay.set(c.barangay, entry);
}
const evacGroups = [...byBarangay.values()].sort((a, b) => a.name.localeCompare(b.name));

const hospitalType = (type: string) =>
  type === "public" ? t.hospitalPublic : type === "private" ? t.hospitalPrivate : type;

const jump = [
  ["hotlines", t.allHotlines],
  ["conflicts", t.conflictsTitle],
  ["ospital", t.hospitalsTitle],
  ["evacuation", t.evacTitle],
  ["baha", t.floodTitle],
];
const retrieved = formatDate(lang, facilities.retrieved);
---

<Base title={t.emergencyPageTitle}>
  <article class="wrap py-10">
    <h1 class="text-[34px] font-bold leading-[1.05] tracking-[-0.04em] md:text-[52px]">{t.emergencyPageTitle}</h1>
    <p class="mt-3 max-w-[60ch] text-[19px] text-red">{t.emergencyLead}</p>

    <nav class="mt-4" aria-label={t.emergencyJump}>
      <ul class="flex flex-wrap gap-x-4 text-[15px]">
        {jump.map(([id, label]) => <li><a class="link-draw" href={`#${id}`}>{label}</a></li>)}
      </ul>
    </nav>

    <section id="hotlines" class="mt-12" aria-labelledby="hotlines-h">
      <h2 id="hotlines-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.allHotlines}</h2>
      <p class="mt-1 text-[15px] text-muted">{t.tapToCall}</p>
      {
        groups.map((g, gi) => (
          <>
            <h3 class:list={["mt-6 text-[14px] font-medium", gi === 0 ? "text-red" : "text-muted"]}>{g.title}</h3>
            <ul class:list={["mt-1 border-t-2", gi === 0 ? "border-red" : "border-ink"]}>
              {g.items.map((h) => (
                <li class="border-b border-line py-2.5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                    <span>
                      {lang === "en" ? h.label_en : h.label_fil}
                      {h.verify && <Verify />}
                    </span>
                    <span class="flex flex-wrap items-center gap-x-1">
                      {h.numbers.map((n) => (
                        <span class="inline-flex items-center">
                          <a class="num font-semibold whitespace-nowrap text-ink" href={telHref(n)}>{n}</a>
                          <CopyButton value={n} label={t.copyNumber(n)} />
                        </span>
                      ))}
                    </span>
                  </div>
                  <p class="text-[14px] text-muted">
                    {t.sources}:{" "}
                    {h.sources.map((s, i) => (
                      <>{i > 0 && ", "}<a href={s}>{sourceLabel(s)}</a></>
                    ))}
                  </p>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p class="mt-3 text-[14px] text-muted">{t.checked}: {formatDate(lang, hotlinesRetrieved)}</p>
    </section>

    <section id="conflicts" class="mt-12" aria-labelledby="conflicts-h">
      <h2 id="conflicts-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.conflictsTitle}</h2>
      <p class="mt-1 max-w-[65ch]">{t.conflictsIntro}</p>
      <ul class="mt-3 border-t-2 border-ink">
        {
          hotlineConflicts.map((c) => (
            <li class="border-b border-line py-3">
              <p class="max-w-[70ch]">{lang === "en" ? c.text_en : c.text_fil}<Verify /></p>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-[14px] text-muted">{t.checked}: {formatDate(lang, hotlinesRetrieved)}</p>
    </section>

    <section id="ospital" class="mt-12" aria-labelledby="ospital-h">
      <h2 id="ospital-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.hospitalsTitle}</h2>
      <ul class="mt-3 border-t-2 border-ink">
        {
          facilities.hospitals.map((h) => (
            <li class="border-b border-line py-3">
              <h3 class="text-[19px] font-semibold tracking-[-0.01em]">
                {h.name}
                {h.verify && <Verify />}
              </h3>
              <p class="text-[14px] font-medium text-muted">{hospitalType(h.type)}</p>
              {h.address && (
                <p class="text-[15px]">
                  {h.address} ·{" "}
                  <a class="link-draw" href={mapsHref(`${h.name}, ${h.address}`)}>{t.openMaps}</a>
                </p>
              )}
              {h.contact ? (
                <ul class="flex flex-wrap items-center gap-x-4 text-[15px]">
                  {parseContact(h.contact).map((c) => (
                    <li class="inline-flex items-center">
                      {c.number ? (
                        <>
                          <a class="num font-semibold whitespace-nowrap text-ink" href={telHref(c.number)}>{c.number}</a>
                          <CopyButton value={c.number} label={t.copyNumber(c.number)} />
                          {c.rest && <span class="ml-1 text-muted">{c.rest}</span>}
                        </>
                      ) : (
                        <span class="text-muted">{c.rest}</span>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-[15px] text-muted">{t.noContactListed}</p>
              )}
              <p class="text-[14px] text-muted">
                {t.sources}:{" "}
                {h.sources.map((s, i) => (
                  <>{i > 0 && ", "}<a href={s}>{sourceLabel(s)}</a></>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-[14px] text-muted">{t.checked}: {retrieved}</p>
    </section>

    <section id="evacuation" class="mt-12" aria-labelledby="evacuation-h">
      <h2 id="evacuation-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.evacTitle}</h2>
      <p class="mt-1 max-w-[70ch] text-[15px] text-muted"><strong class="font-semibold">{t.evacCaveat}</strong> {lang === "en" ? facilities.notes_en : facilities.notes_fil}</p>
      {
        evacGroups.map((g) => (
          <>
            <h3 class="mt-6 text-[19px] font-semibold tracking-[-0.01em]">
              {g.id ? <a href={href(lang, `/barangay/${g.id}/`)}>{g.name}</a> : g.name}
            </h3>
            <ul class="mt-1 border-t-2 border-ink">
              {g.centers.map((c) => (
                <li class="border-b border-line py-2.5">
                  <p>
                    {c.name}
                    {c.verify && <Verify />}
                  </p>
                  <p class="text-[15px] text-muted">{c.address ?? t.evacNoAddress}</p>
                  <p class="text-[14px] text-muted">
                    {t.sources}:{" "}
                    {c.sources.map((s, i) => (
                      <>{i > 0 && ", "}<a href={s}>{sourceLabel(s)}</a></>
                    ))}
                  </p>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p class="mt-3 text-[14px] text-muted">{t.checked}: {retrieved}</p>
    </section>

    <section id="baha" class="mt-12" aria-labelledby="baha-h">
      <h2 id="baha-h" class="text-[30px] font-bold tracking-[-0.03em]">{t.floodTitle}</h2>
      <ul class="mt-3 border-t-2 border-ink">
        {
          facilities.flood_prone_notes.map((n) => (
            <li class="border-b border-line py-3">
              <p class="max-w-[70ch]">{lang === "en" ? n.text_en : n.text_fil}</p>
              <p class="text-[14px] text-muted">
                {t.sources}:{" "}
                {n.sources.map((s, i) => (
                  <>{i > 0 && ", "}<a href={s}>{sourceLabel(s)}</a></>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-[14px] text-muted">{t.checked}: {retrieved}</p>
    </section>
  </article>
</Base>

<style>
  a { display: inline-flex; min-height: 48px; align-items: center; }
</style>
