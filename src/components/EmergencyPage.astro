---
import Site from "../layouts/Site.astro";
import CopyButton from "./CopyButton.astro";
import Verify from "./Verify.astro";
import PageHead from "./site/PageHead.astro";
import {
  hotlines,
  hotlinesRetrieved,
  hotlineConflicts,
  facilities,
  telHref,
  mapsHref,
  sourceLabel,
} from "../lib/data";
import { evacuationCenters } from "../lib/evacuation";
import { formatDate, href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];

const primaryIds = ["pasig-emergency-hotline", "national-emergency-911"];
const primary = primaryIds.map((id) => hotlines.find((h) => h.id === id)).filter((h) => h !== undefined);
const rest = hotlines.filter((h) => !primaryIds.includes(h.id));
const kindsOf = (...kinds: string[]) => rest.filter((h) => kinds.includes(h.kind));
const groups: { title: string; items: typeof rest }[] = [
  { title: t.emergencyGroupMain, items: kindsOf("emergency") },
  { title: t.groupCity, items: kindsOf("city-hall", "traffic") },
  { title: t.groupPoliceFire, items: kindsOf("police", "fire") },
  { title: t.groupOther, items: kindsOf("rescue") },
  { title: t.groupMedical, items: kindsOf("medical") },
].filter((g) => g.items.length > 0);
const smsHref = (number: string) => `sms:${number.replace(/[^\d+]/g, "")}`;
const reportUrl = "https://github.com/kuya-egg/betterpasig/issues/new";

// "(02) 8643-3333; 8988-1000 / 8988-7000 (ER locals 2222)" -> [{ number, rest }]
const parseContact = (contact: string) =>
  contact
    .split(/[;/]/)
    .map((part) => part.trim())
    .filter(Boolean)
    .map((part) => {
      const m = part.match(/^([\d()+\s-]*\d)\s*(.*)$/);
      return m ? { number: m[1].trim(), rest: m[2] } : { number: null, rest: part };
    });

const byBarangay = new Map<string, { name: string; id?: string; centers: typeof evacuationCenters }>();
for (const c of evacuationCenters) {
  const entry = byBarangay.get(c.barangay) ?? { name: c.barangay, id: c.barangayId, centers: [] };
  entry.centers.push(c);
  byBarangay.set(c.barangay, entry);
}
const evacGroups = [...byBarangay.values()].sort((a, b) => a.name.localeCompare(b.name));

const hospitalType = (type: string) =>
  type === "public" ? t.hospitalPublic : type === "private" ? t.hospitalPrivate : type;

const jump = [
  ["hotlines", t.allHotlines],
  ["conflicts", t.conflictsTitle],
  ["ospital", t.hospitalsTitle],
  ["evacuation", t.evacTitle],
  ["baha", t.floodTitle],
];
const retrieved = formatDate(lang, facilities.retrieved);
---

<Site title={t.emergencyPageTitle} description={t.emergencyLead}>
  <section class="section bp-em__hero" aria-labelledby="emergency-page-h">
    <div class="wrap">
      <PageHead
        id="emergency-page-h"
        crumbs={[[t.emergencyPageTitle]]}
        kicker={t.emergencyHeroKicker}
        lead={t.emergencyHeroLead}
      >
        {t.emergencyHeroTitle}
      </PageHead>
      <ul class="bp-em__primary">
        {
          primary.map((h) => (
            <li>
              <a class="bp-em__big" href={telHref(h.numbers[0])}>
                <span class="bp-em__call" aria-hidden="true">
                  <svg width="30" height="30" viewBox="0 0 24 24">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
                  </svg>
                </span>
                <span class="bp-em__big-text">
                  <span class="bp-em__big-label">{lang === "en" ? h.label_en : h.label_fil}</span>
                  <span class="bp-em__big-num">{h.numbers[0]}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <nav aria-label={t.emergencyJump}>
        <ul class="bp-em__jump">
          {jump.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  <section id="hotlines" class="section ground-surface bp-em" aria-labelledby="hotlines-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="hotlines-h">{t.allHotlines}</h2>
        <p>{t.tapToCall}</p>
      </div>
      {
        groups.map((g) => (
          <div class="bp-em__group">
            <h3 class="t-label muted">{g.title}</h3>
            <ul class="bp-hotlines">
              {g.items.map((h) => {
                const sms = h.id === "pasig-katxt";
                return (
                  <li>
                    <div class="bp-hotline">
                      <p class="bp-hotline__label">
                        {lang === "en" ? h.label_en : h.label_fil}
                        {h.verify && <Verify />}
                      </p>
                      <ul class="bp-hotline__nums">
                        {h.numbers.map((n) => (
                          <li>
                            <a class="bp-hotline__number" href={sms ? smsHref(n) : telHref(n)}>
                              <span class="bp-hotline__digits">{n}</span>
                              <span class="bp-hotline__verb">{sms ? t.textVerb : t.callVerb}</span>
                            </a>
                            <CopyButton value={n} label={t.copyNumber(n)} />
                          </li>
                        ))}
                      </ul>
                      <p class="t-small muted">
                        {t.sources}:{" "}
                        {h.sources.map((s, i) => (
                          <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                        ))}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
      <p class="t-small muted bp-em__checked bp-em__foot">
        <span>{t.checkedOn(formatDate(lang, hotlinesRetrieved))}</span>
        <span>{t.reportWrong} <a class="link" href={reportUrl}>{t.reportWrongLink}</a></span>
      </p>
    </div>
  </section>

  <section id="conflicts" class="section section--flow bp-em" aria-labelledby="conflicts-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="conflicts-h">{t.conflictsTitle}</h2>
        <p>{t.conflictsIntro}</p>
      </div>
      <ul class="bp-em__list">
        {
          hotlineConflicts.map((c) => (
            <li>
              <p>{lang === "en" ? c.text_en : c.text_fil}<Verify /></p>
            </li>
          ))
        }
      </ul>
      <p class="t-small muted bp-em__checked">{t.checked}: {formatDate(lang, hotlinesRetrieved)}</p>
    </div>
  </section>

  <section id="ospital" class="section section--flow ground-surface bp-em" aria-labelledby="ospital-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ospital-h">{t.hospitalsTitle}</h2>
      </div>
      <ul class="bp-em__list">
        {
          facilities.hospitals.map((h) => (
            <li class="bp-em__item">
              <h3 class="bp-em__name">
                {h.name}
                {h.verify && <Verify />}
              </h3>
              <p class="t-small muted">{hospitalType(h.type)}</p>
              {h.address && (
                <p class="bp-em__addr">
                  {h.address}
                  <a class="link" href={mapsHref(`${h.name}, ${h.address}`)}>{t.openMaps}</a>
                </p>
              )}
              {h.contact ? (
                <ul class="bp-em__contacts">
                  {parseContact(h.contact).map((c) => (
                    <li>
                      {c.number ? (
                        <>
                          <a class="bp-em__tel" href={telHref(c.number)}>{c.number}</a>
                          <CopyButton value={c.number} label={t.copyNumber(c.number)} />
                          {c.rest && <span class="t-small muted">{c.rest}</span>}
                        </>
                      ) : (
                        <span class="t-small muted">{c.rest}</span>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="t-small muted">{t.noContactListed}</p>
              )}
              <p class="t-small muted">
                {t.sources}:{" "}
                {h.sources.map((s, i) => (
                  <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="t-small muted bp-em__checked">{t.checked}: {retrieved}</p>
    </div>
  </section>

  <section id="evacuation" class="section section--flow bp-em" aria-labelledby="evacuation-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="evacuation-h">{t.evacTitle}</h2>
        <p><strong>{t.evacCaveat}</strong> {lang === "en" ? facilities.notes_en : facilities.notes_fil}</p>
      </div>
      {
        evacGroups.map((g) => (
          <div class="bp-em__group">
            <h3 class="bp-em__name">
              {g.id ? <a class="bp-em__link" href={href(lang, `/barangay/${g.id}/`)}>{g.name}</a> : g.name}
            </h3>
            <ul class="bp-em__list">
              {g.centers.map((c) => (
                <li class="bp-em__item">
                  <p>
                    {c.name}
                    {c.verify && <Verify />}
                  </p>
                  <p class="t-small muted">{c.address ?? t.evacNoAddress}</p>
                  <p class="t-small muted">
                    {t.sources}:{" "}
                    {c.sources.map((s, i) => (
                      <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                    ))}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="t-small muted bp-em__checked">{t.checked}: {retrieved}</p>
    </div>
  </section>

  <section id="baha" class="section section--flow ground-surface bp-em" aria-labelledby="baha-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="baha-h">{t.floodTitle}</h2>
      </div>
      <ul class="bp-em__list">
        {
          facilities.flood_prone_notes.map((n) => (
            <li class="bp-em__item">
              <p>{lang === "en" ? n.text_en : n.text_fil}</p>
              <p class="t-small muted">
                {t.sources}:{" "}
                {n.sources.map((s, i) => (
                  <>{i > 0 && ", "}<a class="bp-em__src" href={s}>{sourceLabel(s)}</a></>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="t-small muted bp-em__checked">{t.checked}: {retrieved}</p>
    </div>
  </section>
</Site>

<style>
  section.bp-em,
  .bp-em section {
    scroll-margin-top: var(--s-8);
  }
  /* red hero: emergency only */
  .bp-em__hero {
    background: var(--red);
    color: #fff;
  }
  .bp-em__hero :global(.kicker),
  .bp-em__hero :global(.lead),
  .bp-em__hero :global(.crumbs),
  .bp-em__hero :global(.crumbs a),
  .bp-em__hero :global(.crumbs li + li::before) {
    color: #fff;
  }
  .bp-em__hero :global(h1) {
    color: #fff;
    font-size: var(--t-h1);
  }
  .bp-em__hero :global(a:focus-visible) {
    outline-color: #fff;
  }
  .bp-em__primary {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--s-4);
  }
  .bp-em__big {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
  }
  .bp-em__big:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .bp-em__call {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
  }
  .bp-em__call svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bp-em__big-text {
    display: grid;
    gap: var(--s-1);
  }
  .bp-em__big-label {
    font-size: var(--t-meta);
    font-weight: 600;
    color: var(--ink);
  }
  .bp-em__big-num {
    font: 500 clamp(32px, 4vw, 44px) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--red);
  }
  .bp-em__jump {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }
  .bp-em__jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bp-em__src,
  .bp-em__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .bp-em__group {
    margin-top: var(--s-7);
  }
  .bp-em__group > h3 {
    margin: 0;
  }
  .bp-hotlines {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--s-3);
  }
  .bp-hotline {
    display: grid;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-4) var(--s-5);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: border-color var(--fast) var(--ease), background-color var(--fast) var(--ease);
  }
  .bp-hotline:hover {
    border-color: var(--red);
    background: #fdf4f5;
  }
  .bp-hotline p,
  .bp-em__list p {
    margin: 0;
  }
  .bp-hotline__label {
    font-weight: 600;
  }
  .bp-hotline__nums,
  .bp-em__contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .bp-hotline__nums li,
  .bp-em__contacts li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  @media (min-width: 30rem) { .bp-hotline__nums li { flex-wrap: nowrap; } }
  .bp-em__src { overflow-wrap: anywhere; }
  .bp-hotline__number {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 44px;
    text-decoration: none;
    color: var(--ink);
  }
  .bp-hotline__digits {
    font: 500 var(--t-h3) / 1.1 var(--font-display);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bp-hotline__verb {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-4);
    border-radius: var(--r-btn);
    background: var(--pale);
    color: var(--blue);
    font-weight: 600;
    transition: background-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .bp-hotline__number:hover .bp-hotline__verb {
    background: var(--blue);
    color: #fff;
  }
  .bp-hotline__number:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }
  .bp-em__tel {
    font: 500 var(--t-card) / 1.2 var(--font-display);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
  }
  .bp-em__list {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    max-width: 70ch;
  }
  .bp-em__item,
  .bp-em__list > li {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-em__name {
    font-size: var(--t-card);
    font-weight: 500;
  }
  .bp-em__addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-4);
  }
  .bp-em__addr a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .bp-em__checked {
    margin-top: var(--s-5);
  }
  .bp-em__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    align-items: center;
  }
  .bp-em__foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
