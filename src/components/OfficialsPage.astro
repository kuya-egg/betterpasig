---
// Equal-listing order rule (applies to every person, no exceptions):
// 1. by office rank (Mayor, Vice Mayor, Representative, Councilors, ex-officio, department heads),
// 2. then by district (1 before 2; barangays grouped District 1 then District 2),
// 3. then alphabetical by name exactly as listed in the source.
// Every person gets the same row treatment: name, role, sources, "Sinusuri pa" when unconfirmed.
// No photos, no party, no praise or criticism.
import Site from "../layouts/Site.astro";
import CopyButton from "./CopyButton.astro";
import PageHead from "./site/PageHead.astro";
import IbaPaTabs from "./IbaPaTabs.astro";
import Verify from "./Verify.astro";
import {
  barangays,
  departmentHeads,
  officials,
  officialsDirectory,
  officialsRetrieved,
  sourceLabel,
  telHref,
} from "../lib/data";
import { formatDate, href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const byName = (a: { name: string }, b: { name: string }) =>
  a.name.localeCompare(b.name, "fil", { sensitivity: "base" });
// Prose fields are stored as <field>_fil / <field>_en; null when the record has no such field.
const text = (record: object, field: string): string | null =>
  ((record as Record<string, string | null | undefined>)[`${field}_${lang === "en" ? "en" : "fil"}`]) ?? null;
const uniq = (lists: (readonly string[] | undefined)[]) => [...new Set(lists.flatMap((l) => l ?? []))];

const top = ["Mayor", "Vice Mayor", "Representative"].flatMap((position) =>
  officials.filter((p) => p.position === position).sort(byName),
);
const councilFor = (district: number) =>
  officials.filter((p) => p.position === "Councilor" && p.district === district).sort(byName);
const exOfficioCity = officials.filter((p) => p.position === "Ex-officio").sort(byName);
const exOfficioDirectory = [...officialsDirectory.ex_officio].sort(byName);

function role(position: string): string {
  if (position === "Mayor") return t.mayor;
  if (position === "Vice Mayor") return t.viceMayor;
  if (position === "Representative") return t.representative;
  if (position === "Councilor") return t.councilor;
  return position;
}

// Department heads: directory offices, plus officials.json heads that are not already there (merged by name).
type Office = {
  office: string;
  head: string | null;
  position: string | null;
  phones: readonly { number: string; label?: string | null }[];
  email: string | null;
  location: string | null;
  sources: string[];
  verify: boolean;
  note: string | null;
};
const offices: Office[] = officialsDirectory.departments.map((d) => {
  const extra = departmentHeads.find((h) => h.name === d.head);
  return {
    office: d.office,
    head: d.head || null,
    position: text(d, "position"),
    phones: d.phones,
    email: d.email,
    location: text(d, "location"),
    sources: uniq([d.sources, extra?.sources]),
    verify: d.verify || Boolean(extra?.verify),
    note: text(d, "note"),
  };
});
for (const h of departmentHeads) {
  if (offices.some((o) => o.head === h.name)) continue;
  offices.push({
    office: h.office,
    head: h.name,
    position: null,
    phones: [],
    email: null,
    location: null,
    sources: [...h.sources],
    verify: h.verify,
    note: text(h, "note"),
  });
}
offices.sort((a, b) => a.office.localeCompare(b.office, "fil", { sensitivity: "base" }));

// Barangays: resolve the site id by name; no link when it fails to match.
const barangayRows = officialsDirectory.barangays.map((b) => {
  const match = barangays.find((x) => x.name === b.name);
  return { ...b, id: match?.id ?? null, slug: match?.id ?? b.name.toLowerCase().replace(/[^a-z0-9]+/g, "-") };
});
const districts = [1, 2].map((d) => ({
  district: d,
  rows: barangayRows.filter((b) => b.district === d).sort(byName),
}));
---

<Site title={t.officialsPageTitle} description={lang === "en" ? officialsDirectory.term_en : officialsDirectory.term_fil}>
  <section class="section ground-white bp-off__top" aria-labelledby="page-h">
    <div class="wrap">
      <PageHead crumbs={[[t.officialsPageTitle]]} kicker={lang === "en" ? "Officials" : "Mga opisyal"} lead={lang === "en" ? officialsDirectory.term_en : officialsDirectory.term_fil}>
        {lang === "en" ? <>Pasig <em>officials</em></> : <>Mga <em>opisyal</em> ng Pasig</>}
      </PageHead>
      <IbaPaTabs current="officials" />
    </div>
  </section>

  <section class="section section--flow" aria-labelledby="opisyal-lungsod-h">
    <div class="wrap">
      <div class="bp-off__term stack-2">
        <p class="t-small">{lang === "en" ? officialsDirectory.term_note_en : officialsDirectory.term_note_fil}</p>
        <p class="t-small muted bp-off__meta">
          <span>{t.sources}: {officialsDirectory.term_sources.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}</span>
          <span>{t.checked}: {formatDate(lang, officialsDirectory.retrieved)}</span>
        </p>
      </div>

      <h2 id="opisyal-lungsod-h" class="bp-off__h2">{t.cityOfficialsHeading}</h2>
      <ul class="bp-off__people">
        {top.map((p) => (
          <li id={`opisyal-${p.position.toLowerCase().replaceAll(" ", "-")}`} data-pagefind-title={p.name} class="bp-off__person">
            <p class="kicker">{role(p.position)}</p>
            <p class="bp-off__name">{p.name}{p.verify && <Verify />}</p>
            <p class="t-small muted">
              {text(p, "note") && <>{text(p, "note")} </>}{t.sources}: {p.sources.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}
            </p>
          </li>
        ))}
      </ul>

      <div class="grid bp-off__split">
        {[1, 2].map((d) => (
          <div class="span-6" id={`opisyal-council-${d}`}>
            <h3 class="bp-off__h3">{d === 1 ? t.council1 : t.council2}</h3>
            <ul class="rows bp-off__rows">
              {councilFor(d).map((p) => (
                <li id={`opisyal-${p.id}`} data-pagefind-title={p.name}>
                  <span class="rows__name">{p.name}{p.verify && <Verify />}</span>
                  {text(p, "note") && <p class="t-small muted">{text(p, "note")}</p>}
                  <p class="t-small muted">
                    {t.sources}: {p.sources.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="t-small muted bp-off__checked">{t.checked}: {formatDate(lang, officialsRetrieved)}</p>
    </div>
  </section>

  <section id="opisyal-ex-officio" class="section section--flow ground-surface" aria-labelledby="opisyal-ex-officio-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="opisyal-ex-officio-h">{t.exOfficioHeading}</h2>
        <p>{t.exOfficioConflict}</p>
      </div>
      <div class="grid bp-off__split">
        <div class="span-6">
          <h3 class="bp-off__h3">{t.exOfficioSetA}</h3>
          <ul class="rows bp-off__rows">
            {exOfficioCity.map((p) => (
              <li>
                <span class="rows__name">{p.name}{p.verify && <Verify />}</span>
                {text(p, "role") && <p>{text(p, "role")}</p>}
                {text(p, "note") && <p class="t-small muted">{text(p, "note")}</p>}
                <p class="t-small muted bp-off__meta">
                  <span>{t.sources}: {p.sources.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}</span>
                  <span>{t.checked}: {formatDate(lang, officialsRetrieved)}</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
        <div class="span-6">
          <h3 class="bp-off__h3">{t.exOfficioSetB}</h3>
          <ul class="rows bp-off__rows">
            {exOfficioDirectory.map((p) => (
              <li>
                <span class="rows__name">{p.name}{p.verify && <Verify />}</span>
                <p>{text(p, "position")}{p.barangay && <>, {p.barangay}</>}</p>
                {text(p, "note") && <p class="t-small muted">{text(p, "note")}</p>}
                <p class="t-small muted bp-off__meta">
                  <span>{t.sources}: {p.sources.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}</span>
                  <span>{t.checked}: {formatDate(lang, officialsDirectory.retrieved)}</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="opisyal-departamento" class="section section--flow" aria-labelledby="opisyal-departamento-h">
    <div class="wrap">
      <h2 id="opisyal-departamento-h" class="bp-off__h2">{t.departmentsHeading}</h2>
      <ul class="rows bp-off__rows">
        {offices.map((o) => (
          <li>
            <h3 class="rows__name bp-off__h3">{o.office}</h3>
            {o.head && (
              <p>
                {o.position ? <span class="muted">{o.position}: </span> : null}
                <strong>{o.head}</strong>{o.verify && <Verify />}
              </p>
            )}
            {!o.head && o.verify && <p><Verify /></p>}
            {o.location && <p>{o.location}</p>}
            {o.phones.length > 0 && (
              <ul class="bp-off__phones">
                {o.phones.map((ph) => (
                  <li>
                    <a class="bp-off__tel" href={telHref(ph.number)}>{ph.number}</a>
                    <CopyButton value={ph.number} label={t.copyNumber(ph.number)} />
                    {ph.label && <span class="t-small muted">{ph.label}</span>}
                  </li>
                ))}
              </ul>
            )}
            {o.email && <p><a class="bp-off__tel" href={`mailto:${o.email}`}>{o.email}</a></p>}
            {o.note && <p class="t-small muted">{o.note}</p>}
            <p class="t-small muted bp-off__meta">
              <span>{t.sources}: {o.sources.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}</span>
              <span>{t.checked}: {formatDate(lang, officialsDirectory.retrieved)}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="opisyal-barangay" class="section section--flow ground-surface" aria-labelledby="opisyal-barangay-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="opisyal-barangay-h">{t.barangayOfficialsHeading}</h2>
        <p>{t.barangayOfficialsNote}</p>
      </div>
      {districts.map((g) => (
        <div class="bp-off__district">
          <h3 class="bp-off__h2">{g.district === 1 ? t.district1 : t.district2}</h3>
          <ul class="grid bp-off__cards">
            {g.rows.map((b) => {
              const srcs = uniq([
                b.punong_barangay.sources,
                b.sk_chair.sources,
                ...b.kagawad.map((k) => k.sources),
                ...b.phones.map((ph) => ph.sources),
                b.hall_address.value ? b.hall_address.sources : [],
              ]);
              return (
                <li id={`opisyal-${b.slug}`} data-pagefind-title={b.name} class="span-6">
                  <article class="card bp-off__card">
                    <h4 class="bp-off__h3">
                      {b.id ? <a class="bp-off__tel" href={href(lang, `/barangay/${b.id}/`)}>{b.name}</a> : b.name}
                    </h4>
                    <dl class="bp-off__dl">
                      <div>
                        <dt class="t-small muted">{t.punongBarangay}</dt>
                        <dd>{b.punong_barangay.name}{b.punong_barangay.verify && <Verify />}</dd>
                      </div>
                      <div>
                        <dt class="t-small muted">{t.skChair}</dt>
                        <dd>{b.sk_chair.name}{b.sk_chair.verify && <Verify />}</dd>
                      </div>
                      {b.kagawad.length > 0 && (
                        <div>
                          <dt class="t-small muted">{t.kagawad}</dt>
                          <dd>
                            <ul>
                              {[...b.kagawad].sort(byName).map((k) => (
                                <li>{k.name}{k.verify && <Verify />}</li>
                              ))}
                            </ul>
                          </dd>
                        </div>
                      )}
                      {b.hall_address.value && (
                        <div>
                          <dt class="t-small muted">{t.hallAddress}</dt>
                          <dd>{b.hall_address.value}{b.hall_address.verify && <Verify />}</dd>
                        </div>
                      )}
                      {b.phones.length > 0 && (
                        <div>
                          <dt class="t-small muted">{t.phones}</dt>
                          <dd>
                            <ul class="bp-off__phones">
                              {b.phones.map((ph) => (
                                <li>
                                  <a class="bp-off__tel" href={telHref(ph.number)}>{ph.number}</a>
                                  <CopyButton value={ph.number} label={t.copyNumber(ph.number)} />
                                  {ph.verify && <Verify />}
                                </li>
                              ))}
                            </ul>
                          </dd>
                        </div>
                      )}
                    </dl>
                    <p class="t-small muted bp-off__meta">
                      <span>{t.sources}: {srcs.map((u, i) => (<>{i > 0 && ", "}<a href={u}>{sourceLabel(u)}</a></>))}</span>
                      <span>{t.checked}: {formatDate(lang, officialsDirectory.retrieved)}</span>
                    </p>
                  </article>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Site>

<style>
  .bp-off__top { padding-block-end: var(--s-6); }
  .bp-off__top :global(.bp-tabs) { margin-block-start: var(--s-6); }
  .bp-off__people {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18.75rem, 1fr));
    gap: var(--s-4);
  }
  .bp-off__person {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    scroll-margin-top: var(--sticky-offset);
  }
  .bp-off__person > p { margin: 0; }
  .bp-off__name { font: 500 var(--t-h3)/1.15 var(--font-display); letter-spacing: -.01em; }
  .bp-off__term {
    max-width: 70ch;
    margin-bottom: var(--s-8);
  }
  .bp-off__h2 {
    font-size: var(--t-card);
    font-weight: 600;
  }
  .bp-off__h3 {
    font-size: var(--t-body);
    font-weight: 600;
  }
  .bp-off__split {
    margin-top: var(--s-8);
    row-gap: var(--s-8);
  }
  .bp-off__rows {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
  }
  .bp-off__rows > li {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .bp-off__rows > li > * {
    grid-column: 1 / -1;
  }
  .bp-off__rows > li > .rows__name {
    grid-column: 1;
  }
  .bp-off__rows > li > .rows__value {
    grid-column: 2;
    white-space: normal;
  }
  .bp-off__rows > li > p {
    max-width: 64ch;
  }
  .bp-off__rows :global(.verify),
  .bp-off__card :global(.verify) {
    margin-left: var(--s-2);
  }
  .bp-off__checked {
    margin-top: var(--s-6);
  }
  .bp-off__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
  }
  .bp-off__phones {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bp-off__phones > li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
  }
  .bp-off__tel {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bp-off__district + .bp-off__district {
    margin-top: var(--s-8);
  }
  .bp-off__cards {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }
  .bp-off__card {
    display: grid;
    gap: var(--s-3);
    height: 100%;
    align-content: start;
    padding: var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .bp-off__dl {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }
  .bp-off__dl dd {
    margin: 0;
  }
  .bp-off__dl ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 1023px) {
    .bp-off__rows > li > .rows__value {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
