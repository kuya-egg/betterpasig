---
// nav-split (dealt): the menu words left, the name in the middle, the actions right.
import Mark from "../../../design/logo/mark-blue.svg";
import { href, langFromUrl, pathIn, ui } from "../../i18n";
import { emergencyHotlines } from "../../lib/data";
import { navMenus } from "../../lib/nav";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const other = lang === "en" ? "fil" : "en";
const menus = navMenus(lang);
const emergency = emergencyHotlines[0];
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const current = (page: string) => !page.includes("#") && path.startsWith(page.replace(/\/$/, ""));
const shortLabel = (id: string, label: string) => (id === "pondo" ? t.navFundsShort : label);
---

<header class="nav nav--split">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">{t.skip}</a>
    <a class="nav__logo" href={href(lang, "/")} aria-label={t.home}>
      <Mark class="bp-mark" aria-hidden="true" />
      <span>BetterPasig</span>
    </a>
    <nav class="nav__links" aria-label={t.navLabel}>
      {
        menus.map((menu) => (
          <div class="nav__item">
            <a class="nav__link" href={href(lang, menu.page)} aria-current={current(menu.page) ? "page" : undefined}>
              {shortLabel(menu.id, menu.label)}
              <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <button class="nav__expand" type="button" aria-expanded="false" aria-label={menu.title}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
            <div class="nav__menu">
              <div class="wrap grid">
                <div class="menu-col span-3">
                  <p class="t-card">{menu.title}</p>
                  <a class="link" href={href(lang, menu.page)}>{menu.page.includes("#") ? t.viewSection : t.viewPage}</a>
                </div>
                <ul class="bp-menu-links span-9" style={`--cols: ${menu.links.length > 16 ? 4 : 3}`}>
                  {menu.links.map((link) => (
                    <li><a href={link.url}>{link.label}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </nav>
    <div class="nav__actions">
      <a
        class="nav__link"
        href={pathIn(other, Astro.url)}
        hreflang={ui[other].htmlLang}
        lang={ui[other].htmlLang}
        aria-label={t.switchLabel}
        data-lang-switch={other}
      >{t.otherLangName}</a>
      {emergency && <a class="nav__link bp-emergency" href={href(lang, "/emergency/")}>{t.emergency}</a>}
      <a class="btn btn--primary" href={href(lang, "/serbisyo/")}>{t.mainAction}</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label={t.navLabel}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]")) {
    link.addEventListener("click", () => {
      try { localStorage.setItem("bp-lang", link.dataset.langSwitch!); } catch { /* storage may be blocked */ }
    });
  }
</script>
