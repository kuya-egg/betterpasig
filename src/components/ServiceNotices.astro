---
import SourceNote from "./SourceNote.astro";
import { opportunities, places, pasigSources, serviceUpdates } from "../lib/data";
import { contentLang, formatDate, href, langFromUrl, ui } from "../i18n";
import { currentServiceState } from "../lib/freshness";

interface Props { serviceId: string }
const { serviceId } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const copy = contentLang(lang);
type RptNotice = { id: string; service_id: string | null; published_date: string; discount_percent: number; ordinary_payment_before_date: string; bulk_payment_before_date: string; online_url: string; contact_email: string; rpt_schedules: { floor: string; place_id: string; days: string[]; opens: string; closes: string }[]; evidence: string[] };
type BusinessNotice = { id: string; service_id: string | null; published_date: string; online_cutoff_at: string; onsite_deadline_date: string; conditional_deadline_date: string; place_ids: string[]; evidence: string[] };
const rpt = serviceUpdates.find((item) => item.id === "rpt-2027-advance-payment" && item.service_id === serviceId) as RptNotice | undefined;
const business = serviceUpdates.find((item) => item.id === "business-tax-q4-2026" && item.service_id === serviceId) as BusinessNotice | undefined;
const businessPlaces = business ? places.filter((place) => business.place_ids.includes(place.id)) : [];
const event = serviceId === "spay-neuter" ? opportunities.find((item) => item.service_id === serviceId) : null;
const businessSource = business && pasigSources.find((source) => source.id === business.evidence[0]?.split(":")[0]);
const rptSource = rpt && pasigSources.find((source) => source.id === rpt.evidence[0]?.split(":")[0]);
const onlineStatus = business ? currentServiceState(business.online_cutoff_at, new Date()) : "unknown";

const dayNames = t.dayShort;
---

{rpt && <section class="bp-notice">
  <h2 class="bp-notice__h">{t.rptTitle}</h2>
  <p>{t.rptDiscount(rpt.discount_percent, formatDate(lang, rpt.ordinary_payment_before_date))}</p>
  <p>{t.rptBulk(formatDate(lang, rpt.bulk_payment_before_date))}</p>
  <a class="bp-act" href={rpt.online_url}>{t.payOnline}</a><p class="t-small muted">{rpt.contact_email}</p>
  <h3 class="bp-notice__h3">{t.rptDesks}</h3>
  <ul class="bp-notice__list">{rpt.rpt_schedules.map((row) => { const place = places.find((item) => item.id === row.place_id); return place && <li>{row.floor}, {place.name}: {row.days.map((day) => dayNames[day]).join(", ")} {row.opens}–{row.closes}</li>; })}</ul>
  {rptSource && <SourceNote refs={rpt.evidence} />}
</section>}

{business && <section class="bp-notice">
  <h2 class="bp-notice__h">{t.bizTaxTitle}</h2>
  <p>{t.bizOnline(formatDate(lang, business.online_cutoff_at.slice(0, 10)), onlineStatus === "past")}</p>
  <p>{t.bizOnsite(formatDate(lang, business.onsite_deadline_date), formatDate(lang, business.conditional_deadline_date))}</p>
  {businessPlaces.length > 0 && <>
    <p>{t.bizLocations}</p>
    <ul class="bp-notice__list">{businessPlaces.map((place) => <li><a class="bp-act" href={href(lang, `/lugar/${place.id}/`)}>{place.name}</a></li>)}</ul>
  </>}
  {businessSource && <SourceNote refs={business.evidence} />}
</section>}

{event && <section class="bp-notice" data-event-date={event.event_date}>
  <h2 class="bp-notice__h">{copy === "en" ? event.title_en : event.title_fil}</h2>
  <p>{formatDate(lang, event.event_date)}<br />{t.eventFree}</p>
  <p>{t.eventWho}</p>
  <ul class="bp-notice__list bp-notice__list--plain">{(copy === "en" ? event.requirements_en : event.requirements_fil).map((item) => <li>{item}</li>)}</ul>
  <p class="muted">{t.eventAsk}<br />{t.eventSlots}</p>
  <p data-event-status>{t.confirmSchedule}</p><p><a href={pasigSources.find(source => source.id === event.evidence[0].split(":")[0])?.url}>{t.eventSourceLink}</a></p>
  <SourceNote refs={event.evidence} />
</section>}

<style>
  .bp-notice {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-7);
    padding-block: var(--s-5);
    border-block: 1px solid var(--line-strong);
  }
  .bp-notice__h {
    font-size: var(--t-card);
    font-weight: 600;
  }
  .bp-notice__h3 {
    margin-top: var(--s-3);
    font-size: var(--t-body);
    font-weight: 600;
  }
  .bp-notice p {
    max-width: 64ch;
  }
  .bp-notice__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bp-notice__list > li {
    padding-block: var(--s-2);
    border-top: 1px solid var(--line);
  }
  .bp-notice__list--plain > li {
    border-top: 0;
    padding-block: var(--s-1);
  }
  .bp-act {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
