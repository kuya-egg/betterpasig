---
import SourceNote from "./SourceNote.astro";
import { opportunities, places, pasigSources, serviceUpdates } from "../lib/data";
import { formatDate, langFromUrl } from "../i18n";
import { currentServiceState } from "../lib/freshness";

interface Props { serviceId: string }
const { serviceId } = Astro.props;
const lang = langFromUrl(Astro.url);
const langText = (fil: string, en: string) => lang === "en" ? en : fil;
type RptNotice = { id: string; service_id: string | null; published_date: string; discount_percent: number; ordinary_payment_before_date: string; bulk_payment_before_date: string; online_url: string; contact_email: string; rpt_schedules: { floor: string; place_id: string; days: string[]; opens: string; closes: string }[]; evidence: string[] };
type BusinessNotice = { id: string; service_id: string | null; published_date: string; online_cutoff_at: string; onsite_deadline_date: string; conditional_deadline_date: string; place_ids: string[]; evidence: string[] };
const rpt = serviceUpdates.find((item) => item.id === "rpt-2027-advance-payment" && item.service_id === serviceId) as RptNotice | undefined;
const business = serviceUpdates.find((item) => item.id === "business-tax-q4-2026" && item.service_id === serviceId) as BusinessNotice | undefined;
const event = serviceId === "spay-neuter" ? opportunities.find((item) => item.service_id === serviceId) : null;
const businessSource = business && pasigSources.find((source) => source.id === business.evidence[0]?.split(":")[0]);
const rptSource = rpt && pasigSources.find((source) => source.id === rpt.evidence[0]?.split(":")[0]);
const onlineStatus = business ? currentServiceState(business.online_cutoff_at, new Date()) : "unknown";

const dayNames: Record<string, string> = lang === "en" ? { MO:"Mon",TU:"Tue",WE:"Wed",TH:"Thu",FR:"Fri",SA:"Sat",SU:"Sun" } : { MO:"Lun",TU:"Mar",WE:"Miy",TH:"Huw",FR:"Biy",SA:"Sab",SU:"Lin" };
---

{rpt && <section class="mt-8 border-y border-line py-4">
  <h2 class="text-[20px] font-semibold">{langText("Maagang bayad sa amilyar para sa 2027", "2027 real property tax advance payment")}</h2>
  <p class="mt-2">{langText(`May ${rpt.discount_percent}% diskuwento sa buong maagang bayad para sa account na walang delinquency bago ${formatDate(lang, rpt.ordinary_payment_before_date)}.`, `A ${rpt.discount_percent}% discount is announced for full advance payment before ${formatDate(lang, rpt.ordinary_payment_before_date)} for accounts without delinquencies.`)}</p>
  <p class="mt-2">{langText(`Para sa mahigit 20 account, magbayad bago ${formatDate(lang, rpt.bulk_payment_before_date)}. Walang eksaktong oras na nakasaad.`, `For more than 20 accounts, pay before ${formatDate(lang, rpt.bulk_payment_before_date)}. No exact cutoff time is stated.`)}</p>
  <a href={rpt.online_url}>{langText("Online payment portal", "Online payment portal")}</a><p class="text-[14px] text-muted">{rpt.contact_email}</p>
  <h3 class="mt-4 font-semibold">{langText("Oras ng RPT desk", "RPT desk schedules")}</h3>
  <ul class="divide-y divide-line">{rpt.rpt_schedules.map((row) => { const place = places.find((item) => item.id === row.place_id); return <li class="py-2">{row.floor}, {place?.name ?? row.place_id}: {row.days.map((day) => dayNames[day]).join(", ")} {row.opens}–{row.closes}</li>; })}</ul>
  {rptSource && <SourceNote refs={rpt.evidence} />}
</section>}

{business && <section class="mt-8 border-y border-line py-4">
  <h2 class="text-[20px] font-semibold">{langText("Abiso sa online business tax, ikaapat na quarter", "Fourth-quarter online business tax notice")}</h2>
  <p class="mt-2">{langText(`Hanggang ${formatDate(lang, business.online_cutoff_at.slice(0, 10))}, 5:00 PM lamang ang online transaction para sa ikaapat na quarter. ${onlineStatus === "past" ? "Lumipas na ang cutoff." : ""}`, `The notice accepted fourth-quarter online transactions only until ${formatDate(lang, business.online_cutoff_at.slice(0, 10))}, 5:00 PM. ${onlineStatus === "past" ? "That cutoff has passed." : ""}`)}</p>
  <p class="mt-2">{langText(`Nasa abiso ang onsite deadline na ${formatDate(lang, business.onsite_deadline_date)}. May kondisyunal na ${formatDate(lang, business.conditional_deadline_date)} lamang kung ideklarang special non-working holiday ang Oktubre 31; hindi ito kinukumpirma rito.`, `The notice lists ${formatDate(lang, business.onsite_deadline_date)} as the onsite deadline. It gives a conditional ${formatDate(lang, business.conditional_deadline_date)} only if October 31 is declared a special non-working holiday; that declaration is not confirmed here.`)}</p>
  <p class="mt-2">{langText("Mga lokasyon para sa business tax:", "Business tax locations:")}</p>
  <ul class="divide-y divide-line">{business.place_ids.map((id) => <li class="py-2"><a href={lang === "en" ? `/en/lugar/${id}/` : `/lugar/${id}/`}>{places.find((place) => place.id === id)?.name ?? id}</a></li>)}</ul>
  {businessSource && <SourceNote refs={business.evidence} />}
</section>}

{event && <section class="mt-8 border-y border-line py-4" data-event-date={event.event_date}>
  <h2 class="text-[20px] font-semibold">{lang === "en" ? event.title_en : event.title_fil}</h2>
  <p class="mt-2">{formatDate(lang, event.event_date)} · {langText("Libre para sa event na ito lamang.", "Free for this event only.")}</p>
  <p class="mt-2">{langText("Para sa lalaking aspin o puspin, 8 buwan hanggang 5 taon, malusog at bakunado; kailangan ang Pasig resident ID.", "For male aspin or puspin, 8 months to 5 years old, healthy and currently vaccinated; Pasig resident ID required.")}</p>
  <ul class="mt-2 list-disc pl-5">{(lang === "en" ? event.requirements_en : event.requirements_fil).map((item) => <li>{item}</li>)}</ul>
  <p class="mt-3 text-muted">{langText("Kumpirmahin sa organizer kung tumatanggap pa ng pagpaparehistro.", "Confirm with the organizer whether registration is still being accepted.")} · {langText("Hindi alam ang live na kapasidad.", "Live capacity is unknown.")}</p>
  <p data-event-status>{langText("Nakatakdang aktibidad; kumpirmahin sa tagapag-ayos.", "Scheduled event; confirm with the organizer.")}</p><p class="mt-2"><a href={pasigSources.find(source => source.id === event.evidence[0].split(":")[0])?.url}>{langText("Tingnan ang opisyal na anunsyo at kumpirmahin sa VSD.", "Read the official announcement and confirm with VSD.")}</a></p>
  <SourceNote refs={event.evidence} />
</section>}



<style>
  a { display: inline-flex; min-height: 48px; align-items: center; }
</style>
