---
import { opportunities, pasigSources, places, serviceUpdates } from "../lib/data";
import { formatDate, langFromUrl } from "../i18n";
import { isSourceFresh } from "../lib/freshness";

const lang = langFromUrl(Astro.url);
const sourceDateForPlace = (place: (typeof places)[number]) =>
  Object.values(place.evidence)
    .flat()
    .map(
      (ref) =>
        pasigSources.find((source) => source.id === ref.split(":")[0])?.published_date ??
        "0000-00-00",
    )
    .sort()
    .at(-1) ?? "0000-00-00";
const isFresh = (date: string) => isSourceFresh(date, new Date());

const rows = [
  ...serviceUpdates
    .filter((item) => isFresh(item.published_date))
    .map((item) => ({
      id: item.id,
      title: lang === "en" ? item.title_en : item.title_fil,
      date: item.published_date,
      eventDate: null,
      href: item.service_id
        ? lang === "en"
          ? `/en/serbisyo/${item.service_id}`
          : `/serbisyo/${item.service_id}`
        : pasigSources.find((source) => source.id === item.evidence[0]?.split(":")[0])?.url ?? "#",
    })),
  ...opportunities
    .filter((item) => isFresh(item.published_date))
    .map((item) => ({
      id: item.id,
      title: lang === "en" ? item.title_en : item.title_fil,
      date: item.published_date,
      eventDate: item.event_date,
      href: lang === "en" ? "/en/ngayong-linggo/" : "/ngayong-linggo/",
    })),
  ...places
    .filter((place) => isFresh(sourceDateForPlace(place)))
    .map((place) => ({
      id: place.id,
      title: place.name,
      date: sourceDateForPlace(place),
      eventDate: null,
      href: lang === "en" ? `/en/lugar/${place.id}/` : `/lugar/${place.id}/`,
    })),
]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 8);
---

<section class="wrap border-t border-line py-10" data-current-feed>
  <h2 class="text-[28px] font-bold tracking-[-0.03em]">
    {lang === "en" ? "Recent notices and places" : "Mga bagong abiso at lugar"}
  </h2>

  {rows.length ? (
    <ul class="mt-3 divide-y divide-line border-y border-line">
      {rows.map((row) => (
        <li
          data-published-date={row.date}
          data-event-date={row.eventDate}
          class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3"
        >
          <a class="font-medium" href={row.href}>{row.title}</a>
          <time class="num text-[14px] text-muted" datetime={row.date}>
            {formatDate(lang, row.date)}
          </time>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-3">
      {lang === "en" ? "No recent official notices are listed." : "Walang nakalistang bagong opisyal na anunsyo."}
    </p>
  )}

  <p data-feed-empty hidden>{lang === "en" ? "No recent official notices are listed." : "Walang nakalistang bagong opisyal na anunsyo."}</p>
  <p class="mt-3 text-[14px] text-muted">
    {lang === "en"
      ? "Checked against official announcements; source dates are shown on each page."
      : "Sinuri sa mga opisyal na anunsyo; makikita ang petsa ng sanggunian sa bawat pahina."}{" "}
    <a href={lang === "en" ? "/en/ngayong-linggo/" : "/ngayong-linggo/"}>
      {lang === "en" ? "View all" : "Tingnan lahat"}
    </a>
  </p>
</section>



<style>
  a { display: inline-flex; min-height: 48px; align-items: center; }
</style>
