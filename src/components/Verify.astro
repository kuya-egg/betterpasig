---
import { Badge } from "./ui/badge";
// Amber "being checked" label for any value with verify: true (see docs/design-system.md).
import { langFromUrl, type Lang, ui } from "../i18n";

interface Props { lang?: Lang }
const t = ui[Astro.props.lang ?? langFromUrl(Astro.url)];
---

<Badge variant="ghost" className="verify" title={t.verifyTitle}>{t.verify}</Badge>

<style>
  .verify {
    margin-inline-start: 6px;
    padding: .0625rem .3125rem;
    vertical-align: middle;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--amber);
  }
</style>
