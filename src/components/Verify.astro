---
// Amber "being checked" label for any value with verify: true (see docs/design-system.md).
import { langFromUrl, ui } from "../i18n";

const t = ui[langFromUrl(Astro.url)];
---

<span class="verify" title={t.verifyTitle}>{t.verify}</span>

<style>
  .verify {
    margin-left: 6px;
    vertical-align: middle;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--amber);
  }
</style>
