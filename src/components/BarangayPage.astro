---
import Kit from "../layouts/Kit.astro";
import map from "../../design/map/pasig-map.json";
import CopyButton from "./CopyButton.astro";
import SourceNote from "./SourceNote.astro";
import { barangays, pasigSources, places, serviceUpdates, sourceLabel, telHref } from "../lib/data";
import { formatDate, href, langFromUrl, ui } from "../i18n";
import Verify from "./Verify.astro";
import { centersForBarangay } from "../lib/evacuation";
import { isSourceFresh } from "../lib/freshness";

interface Props {
  barangayId: string;
}

const lang = langFromUrl(Astro.url);
const barangay = barangays.find((item) => item.id === Astro.props.barangayId);
if (!barangay) throw new Error(`Unknown barangay ${Astro.props.barangayId}`);

const sourceFreshForPlace = (place: (typeof places)[number]) =>
  Object.values(place.evidence)
    .flat()
    .some((ref) => {
      const source = pasigSources.find((item) => item.id === ref.split(":")[0]);
      return isSourceFresh(source?.published_date, new Date());
    });

const recentPlaces = places.filter(
  (place) => place.barangay_id === barangay.id && sourceFreshForPlace(place),
);
const recentUpdates = serviceUpdates.filter(
  (item) =>
    item.place_ids?.some((id) =>
      places.some((place) => place.id === id && place.barangay_id === barangay.id),
    ) && isSourceFresh(item.published_date, new Date()),
);
const t = ui[lang];
const evacCenters = centersForBarangay(barangay.id);
const en = lang === "en";

// The directory stores contacts as one string: "numbers (source); label numbers (source)".
// Split it into labelled numbers, each group with the directory that published it.
const contactGroups = (barangay.contact ?? "")
  .split(";")
  .reduce<{ rows: { label: string; numbers: string[] }[]; source: string | null }[]>(
    (groups, part) => {
      if (!groups.length || groups.at(-1)!.source !== null) groups.push({ rows: [], source: null });
      const group = groups.at(-1)!;
      const source = part.match(/\(([^)]+)\)\s*$/)?.[1] ?? null;
      const text = part.replace(/\([^)]*\)\s*$/, "").trim();
      const found = text.match(/\d[\d\s-]*\d/g) ?? [];
      const first = text.search(/\d/);
      const label = first > 0 ? text.slice(0, first).trim() : "";
      if (found.length) group.rows.push({ label, numbers: found.map((n) => n.trim()) });
      if (source) group.source = source;
      return groups;
    },
    [],
  )
  .filter((group) => group.rows.length);
const shape = map.barangays.find((item) => item.name === barangay.name);
---

<Kit
  title={barangay.name}
  description={en ? `${barangay.name}, Pasig: barangay contacts, evacuation centers and recent places with official sources.` : `${barangay.name}, Pasig: mga numero ng barangay, evacuation center at mga lugar na may bagong opisyal na abiso.`}
>
  <section class="section section--flow" aria-labelledby="brgy-h">
    <div class="wrap">
      <div class="grid grid--top">
        <div class="span-7">
          <div class="section-head bp-brgy__head">
            <h1 id="brgy-h">{barangay.name}</h1>
            {barangay.district && (
              <p>
                {en ? "District" : "Distrito"} {barangay.district}
                <br />
                {en ? "Older directory information; being checked." : "Mula sa lumang direktoryo. Kinukumpirma pa ang impormasyon."}
              </p>
            )}
          </div>
          {barangay.district && (
            <p class="bp-brgy__src"><a class="link" href={barangay.sources[1]}>{en ? "Directory source" : "Tingnan ang direktoryong pinagmulan"}</a></p>
          )}

          <ul class="rows bp-brgy__facts">
            {barangay.punong_barangay && (
              <li>
                <span class="rows__name">{en ? "Punong barangay" : "Punong barangay"}{barangay.verify && <Verify />}</span>
                <span class="bp-brgy__val">
                  {barangay.punong_barangay}
                  {barangay.punong_barangay_term && <small>{barangay.punong_barangay_term}</small>}
                </span>
              </li>
            )}
            {barangay.hall_address && (
              <li>
                <span class="rows__name">{en ? "Barangay hall" : "Barangay hall"}</span>
                <span class="bp-brgy__val">{barangay.hall_address}</span>
              </li>
            )}
            {contactGroups.length > 0 && (
              <li>
                <span class="rows__name">{en ? "Contact numbers" : "Mga numero ng telepono"}{barangay.verify && <Verify />}</span>
                <div class="bp-brgy__val bp-brgy__phones">
                  {contactGroups.map((group) => (
                    <div class="bp-brgy__group">
                      {group.rows.map((row) => (
                        <div>
                          {row.label && <span class="t-small muted">{row.label}</span>}
                          <ul>
                            {row.numbers.map((n) => (
                              <li>
                                <a class="bp-brgy__tel" href={telHref(n)}>{n}</a>
                                <CopyButton value={n} label={t.copyNumber(n)} />
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      {group.source && <small>{group.source}</small>}
                    </div>
                  ))}
                  <small>{en ? "Published numbers; not checked by phone." : "Nakalista ang mga numerong ito sa sanggunian. Hindi pa namin nakukumpirma sa pagtawag."}</small>
                </div>
              </li>
            )}
          </ul>
        </div>
        {shape && (
          <div class="span-4 start-9 bp-brgy__map">
            <svg viewBox="100 0 360 560" role="img" aria-label={en ? `Location of ${barangay.name} in Pasig` : `Lokasyon ng ${barangay.name} sa Pasig`}>
              {map.barangays.map((item) => <path d={item.d} class={item.name === barangay.name ? "on" : undefined} />)}
            </svg>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section section--flow ground-surface" aria-labelledby="brgy-recent-h">
    <div class="wrap" data-current-feed>
      <div class="section-head">
        <h2 id="brgy-recent-h">{en ? "Recent places with official sources" : "Mga lugar na nabanggit sa opisyal na abiso sa nakaraang 30 araw"}</h2>
      </div>

      {recentPlaces.length ? (
        <ul class="bp-brgy__list">
          {recentPlaces.map((place) => (
            <li data-published-date={Object.values(place.evidence).flat().map(ref => pasigSources.find(source => source.id === ref.split(':')[0])?.published_date ?? '').sort().at(-1)}>
              <a class="bp-brgy__title" href={en ? `/en/lugar/${place.id}/` : `/lugar/${place.id}/`}>{place.name}</a>
              <p class="muted">
                {place.address ??
                  (en
                    ? "Address not stated in the announcement checked."
                    : "Hindi nakasaad ang address sa nasuring anunsyo.")}
              </p>
              <SourceNote refs={Object.values(place.evidence).flat()} />
            </li>
          ))}
        </ul>
      ) : (
        <p>
          {en
            ? "No information supported by an official announcement from the past 30 days has been added for this barangay yet."
            : "Wala pang nakalistang opisyal na abiso tungkol sa barangay na ito sa nakaraang 30 araw."}
        </p>
      )}

      {recentUpdates.length > 0 && (
        <div class="bp-brgy__updates">
          <h3 class="t-label muted">{en ? "Recent service notices" : "Mga bagong abiso sa serbisyo"}</h3>
          <ul class="bp-brgy__list">
            {recentUpdates.map((item) => {
              const source = pasigSources.find(
                (row) => row.id === item.evidence[0]?.split(":")[0],
              );
              const destination = item.service_id
                ? en
                  ? `/en/serbisyo/${item.service_id}`
                  : `/serbisyo/${item.service_id}`
                : source?.url;
              return (
                <li data-published-date={item.published_date}>
                  <a class="bp-brgy__title" href={destination}>{en ? item.title_en : item.title_fil}</a>
                  <p class="muted">{formatDate(lang, item.published_date)}</p>
                  <SourceNote refs={item.evidence} />
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {recentPlaces.length > 0 && <p data-feed-empty hidden>{en ? 'No information supported by an official announcement from the past 30 days has been added for this barangay yet.' : 'Wala pang nakalistang opisyal na abiso tungkol sa barangay na ito sa nakaraang 30 araw.'}</p>}
    </div>
  </section>

  <section class="section section--flow" aria-labelledby="evac-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="evac-h">{t.evacBarangayTitle}</h2>
        {evacCenters.length > 0 && <p>{t.evacBarangayNote}</p>}
      </div>
      {evacCenters.length ? (
        <ul class="bp-brgy__list">
          {evacCenters.map((c) => (
            <li>
              <p class="bp-brgy__title">{c.name}{c.verify && <Verify />}</p>
              {c.address && <p class="muted">{c.address}</p>}
              <p class="t-small muted bp-brgy__srcs">
                <span>{t.sources}:</span>
                {c.sources.map((s) => (
                  <a href={s}>{sourceLabel(s)}</a>
                ))}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p>{t.evacBarangayNone}</p>
      )}
      <p class="bp-brgy__all"><a class="link" href={href(lang, "/emergency/#evacuation")}>{t.evacBarangayAll}</a></p>
    </div>
  </section>
</Kit>

<style>
  .bp-brgy__head {
    margin-bottom: var(--s-4);
  }
  .bp-brgy__src {
    margin: 0 0 var(--s-6);
  }
  .bp-brgy__src a,
  .bp-brgy__all a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .bp-brgy__facts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bp-brgy__facts > li {
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    align-items: start;
  }
  .bp-brgy__facts > li:first-child {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-brgy__facts :global(.verify) {
    display: block;
    margin-left: 0;
  }
  .bp-brgy__val {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    gap: var(--s-1);
    text-align: left;
    white-space: normal;
    max-width: none;
  }
  .bp-brgy__val small,
  .bp-brgy__phones small {
    color: var(--muted);
    font-size: var(--t-small);
  }
  .bp-brgy__phones,
  .bp-brgy__group,
  .bp-brgy__group > div {
    display: grid;
    gap: var(--s-1);
  }
  .bp-brgy__phones {
    gap: var(--s-4);
  }
  .bp-brgy__group {
    gap: var(--s-3);
  }
  .bp-brgy__group + .bp-brgy__group {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .bp-brgy__group > div {
    gap: 0;
  }
  .bp-brgy__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-4);
  }
  .bp-brgy__group li {
    display: inline-flex;
    align-items: center;
  }
  .bp-brgy__tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-brgy__tel:hover {
    text-decoration-color: currentColor;
  }
  .bp-brgy__map {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .bp-brgy__map svg {
    display: block;
    width: min(100%, 224px);
    height: auto;
    aspect-ratio: 360 / 560;
  }
  .bp-brgy__map path {
    fill: var(--subtle);
    stroke: var(--bg);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .bp-brgy__map path.on {
    fill: var(--hover);
    stroke: var(--ink);
  }
  .bp-brgy__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bp-brgy__list > li {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
    max-width: 64ch;
  }
  .bp-brgy__list p {
    margin: 0;
  }
  .bp-brgy__title {
    font-size: var(--t-card);
    font-weight: 500;
  }
  a.bp-brgy__title {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--m-in, 150ms) var(--ease);
  }
  a.bp-brgy__title:hover {
    text-decoration-color: currentColor;
  }
  .bp-brgy__updates {
    margin-top: var(--s-8);
  }
  .bp-brgy__srcs {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-4);
  }
  .bp-brgy__srcs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  [data-feed-empty] {
    margin-top: var(--s-4);
  }
  @media (max-width: 1023px) {
    .bp-brgy__map {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
    .bp-brgy__map svg {
      width: min(100%, 160px);
    }
    .bp-brgy__facts > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .bp-brgy__val {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
