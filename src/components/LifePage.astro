---
// /buhay/<id>/: every service and benefit for one life event, then the events people often need next.
import Site from "../layouts/Site.astro";
import PageHead from "./site/PageHead.astro";
import LifeIcon from "./home/LifeIcon.astro";
import { contentLang, href, langFromUrl, ui } from "../i18n";
import { lifeEvents, officeName, type LifeEvent } from "../lib/data";

interface Props {
  event: LifeEvent;
}

const { event } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const copy = contentLang(lang);
const title = copy === "en" ? event.title_en : event.title_fil;
const related = event.related.map((id) => lifeEvents.find((item) => item.id === id)!);
const pick = (fil: string | null | undefined, eng: string | null | undefined) => (copy === "en" ? eng || fil : fil || eng) ?? null;
---

<Site title={t.lifeTitle.replace("{title}", title)} description={copy === "en" ? event.line_en : event.line_fil}>
  <section class="section section--flow ground-white bp-life" aria-labelledby="page-h">
    <div class="wrap">
      <div class="bp-life__head">
        <span class="bp-life__disc"><LifeIcon id={event.id} /></span>
        <PageHead crumbs={[[t.benefitsTitle, "/tulong/"], [title]]} lead={copy === "en" ? event.line_en : event.line_fil}>{title}</PageHead>
      </div>
    </div>
  </section>

  <section class="section section--flow bp-life" aria-labelledby="life-steps-h">
    <div class="wrap">
      <div class="bp-life__panel">
        <div class="bp-life__intro">
          <h2 id="life-steps-h" class="t-h2">{t.lifeServices}</h2>
        </div>
        <div class="bp-life__lists">
          {
            event.serviceList.length > 0 && (
              <ol class="bp-life__steps">
                {event.serviceList.map((service, index) => (
                  <li>
                    <a class="cd bp-life__step" href={href(lang, `/serbisyo/${service.id}/`)}>
                      <span class="bp-life__n" aria-hidden="true">{index + 1}</span>
                      <span class="bp-life__main">
                        <span class="t-card">{copy === "en" ? service.title_en : service.title_fil}</span>
                        <span class="t-small muted bp-life__meta">
                          <span>{t.office}: {officeName(service.office)}</span>
                          {service.fee && <span>{t.fee}: {service.fee}</span>}
                          {service.processing_time && <span>{service.processing_time}</span>}
                        </span>
                      </span>
                      <svg class="ic ar" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                  </li>
                ))}
              </ol>
            )
          }
          {
            event.programList.length > 0 && (
              <>
                <h3 class="t-label muted bp-life__h">{t.lifePrograms}</h3>
                <ul class="bp-life__steps">
                  {event.programList.map((program) => (
                    <li>
                      <a class="cd bp-life__step" href={href(lang, `/tulong/#${program.id}`)}>
                        <span class="bp-life__main">
                          <span class="t-card">{copy === "en" ? program.title_en : program.title_fil}</span>
                          <span class="t-small muted bp-life__meta"><span>{pick(program.for_fil, program.for_en)}</span></span>
                        </span>
                        <svg class="ic ar" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </div>

      <h2 class="t-h3 bp-life__related-h">{t.lifeRelated}</h2>
      <ul class="bp-life__chips">
        {
          related.map((item) => (
            <li>
              <a class="chip" href={href(lang, `/buhay/${item.id}/`)}>
                <LifeIcon id={item.id} />
                {copy === "en" ? item.title_en : item.title_fil}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Site>

<style>
  .bp-life__head { display: grid; gap: var(--s-5); justify-items: start; }
  .bp-life__disc { display: inline-grid; place-items: center; inline-size: 4.5rem; block-size: 4.5rem; border-radius: 50%; background: var(--blue); color: #fff; }
  .bp-life__disc :global(.bp-life-icon) { color: #fff; }
  .bp-life__disc :global(.bp-life-icon svg) { inline-size: 2rem; block-size: 2rem; }
  .bp-life__panel { display: flex; flex-wrap: wrap; gap: var(--s-7); background: var(--pale); border-radius: var(--r-panel); padding: clamp(1.5rem, 4vw, 3rem); }
  .bp-life__intro { flex: 1 1 18rem; min-inline-size: 0; }
  .bp-life__lists { flex: 2 1 32rem; min-inline-size: 0; display: grid; gap: var(--s-3); align-content: start; }
  .bp-life__h { margin-block-start: var(--s-5); }
  .bp-life__steps { display: grid; gap: var(--s-2); counter-reset: none; }
  .bp-life__step { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-4) var(--s-5); min-block-size: 3.5rem; }
  .bp-life__n { font: var(--display-weight) var(--t-h3)/1 var(--font-display); color: var(--blue); inline-size: 2rem; flex: none; }
  .bp-life__main { flex: 1; min-inline-size: 0; display: grid; justify-items: start; gap: var(--s-1); }
  .bp-life__meta { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .bp-life__related-h { margin-block: var(--s-8) var(--s-4); }
  .bp-life__chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .bp-life__chips :global(.bp-life-icon) { color: currentColor; }
  .bp-life__chips :global(.bp-life-icon svg) { inline-size: 1.25rem; block-size: 1.25rem; }
</style>
