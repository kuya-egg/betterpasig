---
import { ButtonLink } from "@/components/ui/button-link";
import Site from "../layouts/Site.astro";
import Verify from "./Verify.astro";
import SourceNote from "./SourceNote.astro";
import {
  historicalUpdates,
  opportunities,
  pasigSources,
  places,
  serviceUpdates,
} from "../lib/data";
import { barangays } from "../lib/data";
import PageHead from "./site/PageHead.astro";
import { formatDate, href, langFromUrl, ui } from "../i18n";
import { eventState } from "../lib/freshness";

interface Props {
  placeId: string;
}

interface ScheduleRow {
  days: string[];
  opens: string;
  closes: string;
}

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const place = places.find((item) => item.id === Astro.props.placeId);
if (!place) throw new Error(`Unknown place ${Astro.props.placeId}`);
const barangay = barangays.find((item) => item.id === place.barangay_id);
const nameWords = place.name.split(" ");
const nameTail = nameWords.pop() ?? "";
const nameHead = nameWords.join(" ");

const sourceIds = [...new Set(Object.values(place.evidence).flat().map((ref) => ref.split(":")[0]))];
const updates = serviceUpdates.filter(
  (item) =>
    item.place_ids?.some(id => id === place.id) ||
    item.rpt_schedules?.some((row) => row.place_id === place.id),
);
const events = opportunities.filter((item) => item.place_id === place.id);
const currentEvents = events.filter((item) => eventState(item.event_date, new Date()) !== "past");
const childDesks = places.filter(item => item.parent_id === place.id);
const rptDesks = serviceUpdates.flatMap(item => item.rpt_schedules ?? []).filter(row => row.place_id === place.id || childDesks.some(child => child.id === row.place_id));
const history = historicalUpdates.filter(
  (item) => item.place_id === place.id || item.place_ids?.includes(place.id),
);

const dayNames: Record<string, string> =
  lang === "en"
    ? { MO: "Mon", TU: "Tue", WE: "Wed", TH: "Thu", FR: "Fri", SA: "Sat", SU: "Sun" }
    : { MO: "Lun", TU: "Mar", WE: "Miy", TH: "Huw", FR: "Biy", SA: "Sab", SU: "Lin" };

const formatSchedule = (rows: ScheduleRow[]) =>
  rows
    .map((row) => `${row.days.map((day) => dayNames[day]).join(", ")} ${row.opens}–${row.closes}`)
    .join("; ");

function historySummary(id: string, english: string): string {
  if (lang === "en") return english;
  if (id === "mega-parking-1-2026-10-07") {
    return "Ayon sa abiso, nakatakdang isara para sa maintenance ang ikatlong palapag noong Oktubre 7 at buksan muli nang 12:01 PM. Walang nakasaad dito kung ilang puwesto ang bakante ngayon.";
  }
  if (id === "pcist-blood-drive-2026-10-08") {
    return "Nasa anunsyo ang iskedyul ng blood donation sa kampus noong Oktubre 8. Hindi pa kumpirmadong natuloy ito.";
  }
  return "Nag-ulat ang lungsod ng 1,067 naghahanap ng trabaho at 1,753 kwalipikadong aplikasyon para sa job fair noong Oktubre 1–2. Hiwalay ang bilang ng mga tao sa bilang ng mga aplikasyon.";
}
---

<Site
  title={place.name}
  description={lang === "en"
    ? `${place.name}: address, hours and published contact details, with the official sources checked.`
    : `${place.name}: address, oras at mga numerong nakalista sa mga opisyal na sanggunian.`}
>
  <section class="section" aria-labelledby="page-h">
    <div class="wrap">
      <PageHead crumbs={[[t.guideExplore, "/pasyalan/"], [place.name]]}>
        {nameHead}{" "}<em>{nameTail}</em><Verify />
        <Fragment slot="actions">
          {barangay && (
            <a class="chip" href={href(lang, `/barangay/${barangay.id}/`)}>
              {lang === "en" ? "Barangay information" : "Impormasyon ng barangay"}
            </a>
          )}
        </Fragment>
      </PageHead>

      <ul class="rows bp-place__facts">
        {barangay && (
          <li>
            <span class="rows__name">Barangay</span>
            <span class="bp-place__val">{barangay.name}</span>
          </li>
        )}
        <li>
          <span class="rows__name">{lang === "en" ? "Address" : "Lokasyon"}</span>
          <span class="bp-place__val">
            {place.address ??
              (lang === "en"
                ? "Not stated in the announcement checked."
                : "Hindi nakasaad sa nasuring anunsyo.")}
          </span>
        </li>
        {place.regular_hours && (
          <li>
            <span class="rows__name">{lang === "en" ? "Market hours" : "Oras ng palengke"}</span>
            <span class="bp-place__val">{formatSchedule([place.regular_hours])}</span>
          </li>
        )}
        {place.business_tax_schedule && (
          <li>
            <span class="rows__name">
              {lang === "en" ? "Q4 2026 business tax schedule" : "Oras para sa buwis sa negosyo, ikaapat na quarter ng 2026"}
            </span>
            <span class="bp-place__val">
              {formatSchedule(place.business_tax_schedule)}
              <small>{lang === "en" ? "Holiday exclusions apply." : "Hindi kasama ang mga holiday."}</small>
            </span>
          </li>
        )}
        {place.rpt_schedule && (
          <li>
            <span class="rows__name">
              {lang === "en" ? "RPT transaction schedule" : "Oras ng serbisyo para sa amilyar"}
            </span>
            <span class="bp-place__val">
              {formatSchedule(place.rpt_schedule)}
              <small>
                {lang === "en"
                  ? "For RPT transactions only; holidays excluded."
                  : "Para lang sa amilyar. Hindi kasama ang mga holiday."}
              </small>
            </span>
          </li>
        )}
        {place.project && (
          <li>
            <span class="rows__name">{lang === "en" ? "Reported street project" : "Iniulat na proyekto sa kalsada"}</span>
            <span class="bp-place__val">
              {place.project.scope}; {place.project.reported_length_m} m; approximately PHP{" "}
              {place.project.reported_cost_php.toLocaleString()}.{" "}
              {lang === "en" ? "According to the city report of" : "Ayon sa ulat ng lungsod noong"}{" "}
              {formatDate(lang, place.project.reported_inauguration)}. {lang === "en"
                ? "This is not a flood safety assessment."
                : "Walang pagtatasa sa panganib ng baha sa ulat na ito."}
            </span>
          </li>
        )}
        {place.phone && (
          <li>
            <span class="rows__name">{lang === "en" ? "Published phone" : "Nakalathalang telepono"}</span>
            <span class="bp-place__val">
              <a class="bp-place__tel" href={`tel:${place.phone.number}`}>
                (02) 8643-1111, {lang === "en" ? "local" : "lokal"} {place.phone.extension}
              </a>
              <small>
                {lang === "en"
                  ? "Published number; not checked by phone."
                  : "Nakalathalang numero; hindi pa nasusubukang tawagan."}
              </small>
            </span>
          </li>
        )}
        {place.email && (
          <li>
            <span class="rows__name">Email</span>
            <span class="bp-place__val"><a class="bp-place__tel" href={`mailto:${place.email}`}>{place.email}</a></span>
          </li>
        )}
      </ul>

      <SourceNote refs={sourceIds} />
    </div>
  </section>

  {(childDesks.length > 0 || rptDesks.length > 0) && (
    <section class="section section--flow ground-surface" aria-labelledby="place-desks-h">
      <div class="wrap bp-place">
        <div class="section-head">
          <h2 id="place-desks-h">{lang === 'en' ? 'Service desks and separate schedules' : 'Mga desk at kani-kanilang oras ng serbisyo'}</h2>
        </div>
        <ul class="bp-place__list">
          {childDesks.map(child => (
            <li>
              <a class="bp-place__title" href={lang === 'en' ? `/en/lugar/${child.id}/` : `/lugar/${child.id}/`}>{child.name}</a>
              {child.business_tax_schedule && <p>{lang === 'en' ? 'Q4 2026 business tax only' : 'Para lamang sa business tax, ikaapat na quarter ng 2026'}: {formatSchedule(child.business_tax_schedule)}</p>}
              <SourceNote refs={child.evidence.business_tax_schedule ?? Object.values(child.evidence).flat()} />
            </li>
          ))}
          {rptDesks.map(row => (
            <li>
              <p class="bp-place__title">{lang === 'en' ? 'Real property tax desk' : 'Desk para sa amilyar'}</p>
              <p>{row.floor}<br />{formatSchedule([row])}; {lang === 'en' ? 'holidays excluded' : 'hindi kasama ang mga holiday'}.</p>
              <SourceNote refs={['S04:image:3']} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {updates.length > 0 && (
    <section class="section section--flow" aria-labelledby="place-updates-h">
      <div class="wrap bp-place">
        <div class="section-head">
          <h2 id="place-updates-h">{lang === "en" ? "Related service notices" : "Mga kaugnay na abiso sa serbisyo"}</h2>
        </div>
        <ul class="bp-place__list">
          {updates.map((item) => {
            const source = pasigSources.find((row) => row.id === item.evidence[0]?.split(":")[0]);
            return (
              <li>
                <a
                  class="bp-place__title"
                  href={item.service_id
                    ? lang === "en"
                      ? `/en/serbisyo/${item.service_id}`
                      : `/serbisyo/${item.service_id}`
                    : source?.url}
                >
                  {lang === "en" ? item.title_en : item.title_fil}
                </a>
                <p class="t-small muted">{formatDate(lang, item.published_date)}</p>
                {"phone" in item && (
                  <p>
                    {lang === "en" ? "Business transaction assistance phone" : "Tawagan para sa tulong sa transaksiyon ng negosyo"}: {" "}
                    <a class="bp-place__tel" href={`tel:${item.phone}`}>{item.phone}</a>
                    <br />
                    {lang === "en" ? "Not an emergency hotline." : "Hindi ito emergency hotline."}
                  </p>
                )}
                {"phone_hours" in item && item.phone_hours && (
                  <p>
                    {item.phone_hours.days.join(", ")} {item.phone_hours.opens}–{item.phone_hours.closes};{" "}
                    {lang === "en" ? "holidays excluded" : "hindi kasama ang mga holiday"}.
                  </p>
                )}
                {"online_url" in item && item.online_url && (
                  <p>
                    <a class="link" href={item.online_url}>
                      {lang === "en" ? "Official service portal" : "Opisyal na portal ng serbisyo"}
                    </a>
                  </p>
                )}
                {"reported_route_count" in item && (
                  <p>
                    {lang === "en"
                      ? `The notice reports ${item.reported_route_count} routes. QR is optional; manual registration is available. Stops and route geometry were not stated in the notice checked.`
                      : `Anim ang rutang inanunsyo. Puwedeng magparehistro nang walang QR code. Walang nakasaad na mga hintuan o eksaktong ruta sa nasuring anunsyo.`}
                  </p>
                )}
                <SourceNote refs={item.evidence} />
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {currentEvents.length > 0 && (
    <section class="section section--flow ground-surface" aria-labelledby="place-event-h">
      <div class="wrap bp-place">
        <div class="section-head">
          <h2 id="place-event-h">{lang === "en" ? "Dated opportunity" : "May takdang oportunidad"}</h2>
        </div>
        <div class="bp-place__events">
          {currentEvents.map((event) => (
            <div class="bp-place__event" data-event-date={event.event_date}>
              <p class="bp-place__title">{lang === "en" ? event.title_en : event.title_fil}</p>
              <p>
                {lang === "en" ? "Scheduled" : "Nakatakda"}: {formatDate(lang, event.event_date)}
              </p>
              <p class="muted">
                {lang === "en"
                  ? "Confirm with the organizer whether registration is still being accepted."
                  : "Magtanong sa tagapag-ayos kung puwede pang magparehistro."}
              </p>
              <p>
                <ButtonLink data-registration href={event.registration_url}>
                  {lang === "en" ? "Open registration page" : "Buksan ang pahina ng pagpaparehistro"}
                </ButtonLink>
              </p>
              <SourceNote refs={event.evidence} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {history.length > 0 && (
    <section class="section section--flow" aria-labelledby="place-past-h">
      <div class="wrap bp-place">
        <div class="section-head">
          <h2 id="place-past-h">{lang === "en" ? "Past notices" : "Mga nagdaang abiso"}</h2>
        </div>
        <ul class="bp-place__list">
          {history.map((item) => (
            <li>
              <p>{historySummary(item.id, item.summary)}</p>
              <SourceNote refs={item.evidence} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Site>

<style>
  .bp-place {
    max-width: 880px;
  }
  .bp-place__facts {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .bp-place__facts > li {
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    align-items: start;
  }
  .bp-place__facts .rows__name {
    font-weight: 400;
    color: var(--muted);
  }
  .bp-place__val {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    gap: var(--s-1);
  }
  .bp-place__val small {
    color: var(--muted);
    font-size: var(--t-small);
  }
  .bp-place__tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-place__tel:hover {
    text-decoration-color: currentColor;
  }
  .bp-place__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .bp-place__list > li {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .bp-place__list p,
  .bp-place__event p {
    margin: 0;
  }
  .bp-place__events {
    display: grid;
    gap: var(--s-3);
  }
  .bp-place__event {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .bp-place__title {
    font-size: var(--t-card);
    font-weight: 500;
  }
  a.bp-place__title {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--fast) var(--ease);
  }
  a.bp-place__title:hover {
    text-decoration-color: currentColor;
  }
  @media (max-width: 639px) {
    .bp-place__facts > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .bp-place__val {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
