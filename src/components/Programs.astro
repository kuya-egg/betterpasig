---
import Verify from "./Verify.astro";
import { programs } from "../lib/data";
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const pick = (fil?: string | null, en?: string | null) => (lang === "en" ? en : (fil ?? en));
---

<div id="benepisyo" class="min-w-0">
  <h2 class="text-[30px] font-bold tracking-[-0.03em]">{t.benefitsTitle}</h2>
  <ul class="mt-4 border-b border-line">
    {
      programs.map((program) => (
        <li id={`benepisyo-${program.id}`} class="grid gap-1 border-t border-line py-3.5 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-5">
          <span class="min-w-0">
            <a class="font-medium" href={href(lang, `/tulong/#${program.id}`)}>{lang === "en" ? program.title_en : program.title_fil}</a>
            {program.verify && <Verify />}
            {pick(program.for_fil, program.for_en) && <span class="mt-0.5 block text-[14px] text-muted">{pick(program.for_fil, program.for_en)}</span>}
          </span>
          {pick(program.benefit_fil, program.benefit_en) && <span class="num font-semibold sm:max-w-[24ch] sm:text-right">{pick(program.benefit_fil, program.benefit_en)}</span>}
        </li>
      ))
    }
  </ul>
  <p class="mt-4"><a href={href(lang, "/tulong/")}>{t.benefitsAll}</a></p>
</div>
