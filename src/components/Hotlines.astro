---
import Verify from "./Verify.astro";
import { otherHotlines, telHref, dateFil, hotlinesRetrieved } from "../lib/data";

const groups: { title: string; kinds: string[] }[] = [
  { title: "Pulis at bumbero", kinds: ["police", "fire"] },
  { title: "Ospital", kinds: ["medical"] },
  { title: "Rescue at iba pa", kinds: ["emergency", "rescue", "traffic", "city-hall"] },
];
---

<section id="hotlines" aria-labelledby="hotlines-h" class="scroll-mt-20">
  <h2 id="hotlines-h" class="text-[30px] font-bold tracking-[-0.03em]">Iba pang hotline</h2>
  <p class="mt-1 text-[15px] text-muted">Pindutin ang numero para tumawag.</p>
  {
    groups.map((g) => {
      const items = otherHotlines.filter((h) => g.kinds.includes(h.kind));
      return (
        items.length > 0 && (
          <>
            <h3 class="mt-6 text-[14px] font-medium text-muted">{g.title}</h3>
            <ul class="mt-1 border-t-2 border-ink">
              {items.map((h) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 border-b border-line py-2.5">
                  <span>
                    {h.label_fil}
                    {h.verify && <Verify />}
                  </span>
                  <span class="flex flex-wrap gap-x-3">
                    {h.numbers.map((n) => (
                      <a class="num font-semibold whitespace-nowrap text-ink" href={telHref(n)}>
                        {n}
                      </a>
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )
      );
    })
  }
  <p class="mt-3 text-[14px] text-muted">Sinuri: {dateFil(hotlinesRetrieved)}</p>
</section>
