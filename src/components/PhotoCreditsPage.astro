---
// /larawan/: every photograph the site shows (data/photos.json), with its author, licence and Commons page.
// The footer links here in one line instead of listing credits on every page.
import { Picture } from "astro:assets";
import Kit from "../layouts/Kit.astro";
import { langFromUrl, ui } from "../i18n";
import { photoAlt, photos } from "../lib/photos";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<Kit title={t.creditsTitle} description={t.creditsLead}>
  <section class="section section--flow bp-credits" aria-labelledby="credits-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="credits-h">{t.creditsTitle}</h1>
        <p>{t.creditsLead}</p>
      </div>
      <ul class="rows">
        {
          photos.map((item) => (
            <li>
              <span class="rows__name bp-credits__item">
                <Picture src={item.image} alt="" formats={["avif", "webp"]} fallbackFormat="webp" width={160} loading="lazy" decoding="async" />
                <span>
                  <a href={item.page}>{photoAlt(item, lang)}</a>
                  <small>
                    {t.creditsBy} {item.by}. <a href={item.licence_url}>{item.licence}</a>
                  </small>
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Kit>

<style>
  .bp-credits__item {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: center;
  }
  .bp-credits__item :global(img) {
    width: 80px;
    height: 56px;
    object-fit: cover;
    border-radius: var(--r-sm);
  }
  .bp-credits__item > span {
    display: grid;
    gap: var(--s-1);
  }
  .bp-credits small {
    color: var(--muted);
    font-size: var(--t-small);
  }
  .bp-credits a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .bp-credits a:hover {
    text-decoration-color: currentColor;
  }
</style>
