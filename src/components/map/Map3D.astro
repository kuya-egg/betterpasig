---
// The 3D barangay map (handoff 2026-11, the signature piece). The 30 PSA PSGC shapes from design/map/pasig-map.json,
// extruded with chained drop-shadows and tilted with CSS; no WebGL. Each shape is a link to its barangay page, so the
// map works with Tab, Enter and no script. With script, a click selects instead: the shape lifts in Pasig blue and the
// page hears a "bp-map-select" event ({ id, name, district }) on the map's root.
// The A–Z list on the page is the text alternative; the selection card is aria-live.
import map from "../../../design/map/pasig-map.json";
import { href, langFromUrl, ui } from "../../i18n";
import { barangays } from "../../lib/data";

interface Props {
  /** hero ~420px, page ~470px, mini ~260px (sticky side map) */
  size?: "hero" | "page" | "mini";
  /** 3D/flat toggle and district filter above the map */
  controls?: boolean;
  /** the floating selection card in the map's corner */
  card?: boolean;
  /** barangay ids drawn darker ("has a place" on Pasyalan) */
  highlight?: string[];
  /** barangay id selected on load (a barangay page, a place) */
  selected?: string;
  /** remember the selection on this browser (home and the barangay map) */
  remember?: boolean;
  /** accessible name of the drawing */
  label?: string;
}

const { size = "hero", controls = false, card = false, highlight, selected, remember = false, label } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const byName = new Map(barangays.map((item) => [item.name, item]));
const districtName = (district: number | null) => (district === 1 ? t.district1 : district === 2 ? t.district2 : "");
const shapes = map.barangays.map((shape) => {
  const item = byName.get(shape.name);
  if (!item) throw new Error(`Map3D: no barangay in data/barangays.json for shape "${shape.name}"`);
  const fill = highlight ? (highlight.includes(item.id) ? "has" : "d1") : item.district === 2 ? "d2" : "d1";
  return { ...shape, id: item.id, district: item.district, fill };
});
const initial = selected ? shapes.find((shape) => shape.id === selected) : undefined;
---

<div
  class={`bp-map3d bp-map3d--${size}`}
  data-map3d
  data-remember={remember ? "" : undefined}
  data-selected={initial?.id}
  data-district-labels={JSON.stringify({ 1: t.district1, 2: t.district2 })}
  data-base={href(lang, "/barangay/")}
>
  {controls && (
    <div class="bp-map3d__controls">
      <div class="bp-map3d__seg" role="group" aria-label={t.mapDistrictLabel}>
        <button type="button" aria-pressed="true" data-district="">{t.mapAllDistricts}</button>
        <button type="button" aria-pressed="false" data-district="1">{t.district1}</button>
        <button type="button" aria-pressed="false" data-district="2">{t.district2}</button>
      </div>
      <div class="bp-map3d__seg" role="group" aria-label={t.mapViewLabel}>
        <button type="button" aria-pressed="true" data-view="3d">{t.mapView3d}</button>
        <button type="button" aria-pressed="false" data-view="flat">{t.mapViewFlat}</button>
      </div>
    </div>
  )}
  <div class="bp-map3d__stage">
    <div class="bp-map3d__tilt">
      <svg viewBox="100 0 360 560" role="group" aria-label={label ?? t.mapLabel}>
        <g class="bp-map3d__ext">
          {shapes.map((shape) => (
            <a href={href(lang, `/barangay/${shape.id}/`)} aria-label={shape.name} data-id={shape.id} data-name={shape.name} data-district={shape.district ?? ""} aria-current={shape.id === initial?.id ? "true" : undefined}>
              <path d={shape.d} class={`bp-map3d__${shape.fill}${shape.id === initial?.id ? " is-on" : ""}`} />
            </a>
          ))}
        </g>
      </svg>
    </div>
  </div>
  {card && (
    <div class="bp-map3d__card" aria-live="polite">
      <p class="kicker bp-map3d__card-district" data-card-district>{initial ? districtName(initial.district) : ""}</p>
      <p class:list={["bp-map3d__card-name", { "is-empty": !initial }]} data-card-name>{initial?.name ?? t.mapNoSelection}</p>
      <a class="link bp-map3d__card-link" data-card-link href={initial ? href(lang, `/barangay/${initial.id}/`) : href(lang, "/barangay/")} hidden={!initial}>{t.mapOpenBarangay} <span aria-hidden="true">→</span></a>
    </div>
  )}
</div>

<script>
  // One handler for every map on the page: select, filter by district, switch 3D/flat.
  for (const root of document.querySelectorAll<HTMLElement>("[data-map3d]")) {
    const links = [...root.querySelectorAll<SVGAElement>("a[data-id]")];
    const labels = JSON.parse(root.dataset.districtLabels ?? "{}") as Record<string, string>;
    const card = {
      district: root.querySelector<HTMLElement>("[data-card-district]"),
      name: root.querySelector<HTMLElement>("[data-card-name]"),
      link: root.querySelector<HTMLAnchorElement>("[data-card-link]"),
    };

    const select = (id: string, announce = true) => {
      const link = links.find((item) => item.dataset.id === id);
      if (!link) return;
      for (const item of links) {
        const on = item === link;
        item.querySelector("path")?.classList.toggle("is-on", on);
        if (on) item.setAttribute("aria-current", "true");
        else item.removeAttribute("aria-current");
      }
      root.dataset.selected = id;
      if (card.name) {
        card.name.textContent = link.dataset.name ?? "";
        card.name.classList.remove("is-empty");
      }
      if (card.district) card.district.textContent = labels[link.dataset.district ?? ""] ?? "";
      if (card.link) {
        card.link.href = link.getAttribute("href") ?? "";
        card.link.hidden = false;
      }
      if (root.hasAttribute("data-remember")) {
        try { localStorage.setItem("bp-brgy", id); } catch { /* storage may be blocked */ }
      }
      if (announce) root.dispatchEvent(new CustomEvent("bp-map-select", { bubbles: true, detail: { id, name: link.dataset.name, district: link.dataset.district } }));
    };

    for (const link of links) {
      link.addEventListener("click", (event) => {
        // a modified click still opens the barangay page in a new tab
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        select(link.dataset.id ?? "");
      });
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-district]")) {
      button.addEventListener("click", () => {
        const district = button.dataset.district ?? "";
        for (const other of root.querySelectorAll<HTMLButtonElement>("[data-district]")) other.setAttribute("aria-pressed", String(other === button));
        for (const link of links) link.classList.toggle("is-out", district !== "" && link.dataset.district !== district);
        root.dispatchEvent(new CustomEvent("bp-map-filter", { bubbles: true, detail: { district } }));
      });
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-view]")) {
      button.addEventListener("click", () => {
        for (const other of root.querySelectorAll<HTMLButtonElement>("[data-view]")) other.setAttribute("aria-pressed", String(other === button));
        root.classList.toggle("is-flat", button.dataset.view === "flat");
      });
    }

    // a page can select from outside (the A–Z list, a place card): dispatch "bp-map-pick" with { id }
    root.addEventListener("bp-map-pick", (event) => select((event as CustomEvent<{ id: string }>).detail.id, false));

    let saved = root.dataset.selected ?? null;
    if (!saved && root.hasAttribute("data-remember")) {
      try { saved = localStorage.getItem("bp-brgy"); } catch { /* storage may be blocked */ }
    }
    if (saved) {
      const id = saved;
      // draw now; announce at DOMContentLoaded, after every module script on the page has added its listeners
      select(id, false);
      document.addEventListener("DOMContentLoaded", () => select(id), { once: true });
    }
  }
</script>

<style>
  .bp-map3d { position: relative; display: grid; gap: var(--s-4); }
  .bp-map3d__controls { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3); position: relative; z-index: 2; }
  .bp-map3d__seg { display: inline-flex; padding: var(--s-1); border-radius: var(--r-btn); background: var(--surface); }
  .bp-map3d__seg button {
    min-block-size: 2.75rem;
    padding-inline: var(--s-4);
    border: 0;
    border-radius: var(--r-btn);
    background: transparent;
    color: var(--ink);
    font: 600 var(--t-small)/1 var(--font-text);
    cursor: pointer;
    transition: background-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .bp-map3d__seg button[aria-pressed="true"] { background: var(--bg); color: var(--blue); box-shadow: 0 1px 2px var(--shadow); }

  .bp-map3d__stage { display: grid; place-items: center; }
  .bp-map3d--hero .bp-map3d__tilt { inline-size: min(26.25rem, 80%); }
  .bp-map3d--page .bp-map3d__tilt { inline-size: min(29.375rem, 86%); }
  .bp-map3d--mini .bp-map3d__tilt { inline-size: min(16.25rem, 90%); }
  .bp-map3d__tilt {
    transform: perspective(1600px) rotateX(48deg) rotateZ(-12deg);
    transform-origin: 50% 55%;
    transition: transform .9s var(--ease);
  }
  .bp-map3d.is-flat .bp-map3d__tilt { transform: none; }
  .bp-map3d svg { inline-size: 100%; block-size: auto; overflow: visible; }

  /* ten chained 1px shadows: each shadows the one before, so together they make a solid 10px side wall */
  .bp-map3d__ext {
    filter: drop-shadow(0 1px 0 var(--map-side)) drop-shadow(0 1px 0 var(--map-side)) drop-shadow(0 1px 0 var(--map-side))
      drop-shadow(0 1px 0 var(--map-side)) drop-shadow(0 1px 0 var(--map-side)) drop-shadow(0 1px 0 var(--map-side))
      drop-shadow(0 1px 0 var(--map-side)) drop-shadow(0 1px 0 var(--map-side)) drop-shadow(0 1px 0 var(--map-side))
      drop-shadow(0 1px 0 var(--map-side));
  }
  .bp-map3d path {
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
    cursor: pointer;
    transition: transform .45s var(--ease), fill var(--fast) var(--ease);
  }
  .bp-map3d__d1 { fill: var(--map-d1); }
  .bp-map3d__d2 { fill: var(--map-d2); }
  .bp-map3d__has { fill: var(--map-d2); }
  .bp-map3d a.is-out path { fill: var(--surface); }
  .bp-map3d path.is-on { fill: var(--blue); transform: translateY(-10px); }
  @media (hover: hover) {
    .bp-map3d a:hover path:not(.is-on) { fill: var(--map-hover); transform: translateY(-5px); }
  }
  .bp-map3d a:focus-visible { outline: none; }
  .bp-map3d a:focus-visible path { stroke: var(--ink); stroke-width: 2.5; }

  .bp-map3d__card {
    position: absolute;
    inset-inline-start: var(--s-5);
    inset-block-end: var(--s-5);
    z-index: 2;
    inline-size: min(18rem, calc(100% - 3rem));
    padding: var(--s-4) var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: 0 12px 32px var(--shadow);
  }
  .bp-map3d__card-district { color: var(--muted); min-block-size: 1.5em; }
  .bp-map3d__card-name { font: var(--display-weight) 2rem/1.1 var(--font-display); letter-spacing: -.01em; }
  .bp-map3d__card-name.is-empty { font: 500 var(--t-meta)/1.5 var(--font-text); letter-spacing: 0; color: var(--muted); }
  .bp-map3d--mini .bp-map3d__card { position: static; inline-size: auto; box-shadow: none; }
  .bp-map3d--mini .bp-map3d__card-name:not(.is-empty) { font-size: var(--t-h3); }
  .bp-map3d__card-link { display: inline-flex; align-items: center; gap: var(--s-1); min-block-size: 2.75rem; font-weight: 600; }

  /* phones: flat, full width */
  @media (max-width: 40rem) {
    .bp-map3d__tilt { transform: none; }
    .bp-map3d--hero .bp-map3d__tilt, .bp-map3d--page .bp-map3d__tilt { inline-size: 100%; }
    .bp-map3d__card { position: static; inline-size: auto; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-map3d__tilt, .bp-map3d path { transition: none; }
  }
</style>
