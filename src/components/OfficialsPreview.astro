---
import { officials, officialsTerm } from "../lib/data";
import { langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const order = ["Mayor", "Vice Mayor", "Representative"];
const top = order.flatMap((position) => officials.filter((person) => person.position === position));
const council1 = officials.filter((person) => person.position === "Councilor" && person.district === 1);
const council2 = officials.filter((person) => person.position === "Councilor" && person.district === 2);

function role(position: string): string {
  if (position === "Mayor") return t.mayor;
  if (position === "Vice Mayor") return t.viceMayor;
  if (position === "Representative") return t.representative;
  if (position === "Councilor") return t.councilor;
  return position;
}
---

<div id="opisyal" class="scroll-mt-28 min-w-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
    <h2 class="text-[30px] font-bold tracking-[-0.03em]">{t.officialsHeading(officialsTerm)}</h2>
    <a class="link-draw font-medium" href="#opisyal">{t.fullDirectory}</a>
  </div>
  <ul class="mt-4">
    {
      top.map((person) => (
        <li class="flex items-baseline justify-between gap-4 border-t border-line py-3.5">
          <span class="text-muted">{role(person.position)}</span>
          <strong class="text-right font-semibold">{person.name}</strong>
        </li>
      ))
    }
  </ul>
  <div class="grid gap-6 border-t border-line pt-3.5 sm:grid-cols-2">
    <div>
      <p class="text-[14px] text-muted">{t.council1}</p>
      <ul class="mt-1.5 grid gap-1">
        {council1.map((person) => <li>{person.name}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-[14px] text-muted">{t.council2}</p>
      <ul class="mt-1.5 grid gap-1">
        {council2.map((person) => <li>{person.name}</li>)}
      </ul>
    </div>
  </div>
</div>
