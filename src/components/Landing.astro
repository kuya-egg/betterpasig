---
// Home page (kind: service; plan in .taste-skill/plan.md). Every section links on to the page that holds the detail.
import Kit from "../layouts/Kit.astro";
import HomeHero from "./home/HomeHero.astro";
import LifeDoors from "./home/LifeDoors.astro";
import TopServices from "./home/TopServices.astro";
import Pasyalan from "./home/Pasyalan.astro";
import NewInPasig from "./home/NewInPasig.astro";
import Trust from "./home/Trust.astro";
import PasigMap from "./PasigMap.astro";
import HomeHotlines from "./home/HomeHotlines.astro";
import { langFromUrl, ui } from "../i18n";
import { pasyalan } from "../lib/data";

const t = ui[langFromUrl(Astro.url)];
const chapters = ["maybunga-rainforest-park", "pasig-city-museum", "kapitolyo-food-district", "bahay-na-tisa"];
const chapterPhotos = chapters.map((id) => pasyalan.find((place) => place.id === id)?.photo_id).filter((id): id is string => Boolean(id));
---

<Kit description={t.pageDescription} moments={["photo-chapters", "word-highlight"]} fragments={["checklist"]} photos={["manggahan-floodway", ...chapterPhotos]}>
  <HomeHero />
  <LifeDoors />
  <TopServices />
  <PasigMap />
  <Pasyalan ids={chapters} />
  <NewInPasig skip={chapters} />
  <Trust />
  <HomeHotlines />
</Kit>
