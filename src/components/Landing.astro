---
// "Ginagawa pa" landing page, shared by / (Filipino) and /en/ (English) until the full homepage ships.
import Base from "../layouts/Base.astro";
import PasigMap from "./PasigMap.astro";
import CityHall from "./CityHall.astro";
import Hotlines from "./Hotlines.astro";
import { services } from "../lib/data";
import { langFromUrl, ui } from "../i18n";

const t = ui[langFromUrl(Astro.url)];
---

<Base description={t.pageDescription}>
  <section class="wrap grid items-center gap-8 pt-10 pb-8 md:grid-cols-[1fr_auto] md:pt-16">
    <div>
      <p class="text-[14px] font-medium text-blue">{t.inProgress}</p>
      <h1 class="mt-3 max-w-[18ch] text-[34px] font-bold leading-[1.1] tracking-[-0.04em] md:text-[52px]">
        {t.heroTitle}
      </h1>
      <p class="mt-5 max-w-[60ch]">{t.heroBody(services.length)}</p>
      <p class="mt-6 max-w-[60ch] text-[15px]">
        {t.meanwhileBefore} <a href="https://pasigcity.gov.ph">pasigcity.gov.ph</a>{" "}{t.meanwhileAfter}
      </p>
    </div>
    <PasigMap class="mx-auto w-[240px] md:w-[340px]" />
  </section>

  <div class="wrap mt-8 grid gap-14 md:grid-cols-2 md:gap-12">
    <CityHall />
    <Hotlines />
  </div>
</Base>
