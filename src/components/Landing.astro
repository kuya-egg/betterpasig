---
import Site from "../layouts/Site.astro";
import HomeHero from "./home/HomeHero.astro";
import TopServices from "./home/TopServices.astro";
import LifeDoors from "./home/LifeDoors.astro";
import Benefits from "./home/Benefits.astro";
import HomeTopics from "./home/HomeTopics.astro";
import Pasyalan from "./home/Pasyalan.astro";
import NewInPasig from "./home/NewInPasig.astro";
import HomeHotlines from "./home/HomeHotlines.astro";
import Trust from "./home/Trust.astro";
import { langFromUrl, ui } from "../i18n";
import { pasyalan } from "../lib/data";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const chapters = ["maybunga-rainforest-park", "pasig-city-museum", "kapitolyo-food-district", "bahay-na-tisa"];
const chapterPhotos = [...new Set(chapters.map((id) => pasyalan.find((place) => place.id === id)?.photo_id).filter((id): id is string => Boolean(id)))];
---

<Site description={t.pageDescription} photos={chapterPhotos}>
  <HomeHero />
  <TopServices />
  <LifeDoors />
  <Benefits />
  <HomeTopics />
  <Pasyalan ids={chapters} />
  <NewInPasig />
  <HomeHotlines />
  <Trust />
</Site>
