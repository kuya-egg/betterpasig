---
import Base from "../layouts/Base.astro";
import Alerts from "./Alerts.astro";
import Search from "./Search.astro";
import PasigMap from "./PasigMap.astro";
import Featured from "./Featured.astro";
import Categories from "./Categories.astro";
import Programs from "./Programs.astro";
import OfficialsPreview from "./OfficialsPreview.astro";
import Funds from "./Funds.astro";
import Hotlines from "./Hotlines.astro";
import { langFromUrl, ui } from "../i18n";

const t = ui[langFromUrl(Astro.url)];
---

<Base description={t.pageDescription}>
  <Alerts />
  <section class="wrap grid items-start gap-10 py-12 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:gap-14 md:py-14">
    <div class="min-w-0">
      <h1 class="max-w-[14ch] text-[34px] font-bold leading-[1.05] tracking-[-0.04em] md:max-w-[12ch] md:text-[52px]">
        {t.heroTitle}
      </h1>
      <p class="mt-4 max-w-[46ch] text-muted">{t.heroLede}</p>
      <Search />
    </div>
    <PasigMap />
  </section>
  <Featured />
  <Categories />
  <section class="border-t border-line py-14">
    <div class="wrap grid gap-14 md:grid-cols-2">
      <Programs />
      <OfficialsPreview />
    </div>
  </section>
  <Funds />
  <div class="wrap border-t border-line py-14">
    <Hotlines />
  </div>
</Base>
